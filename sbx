def clean(n):
    return (re.sub(r"[^A-Za-z0-9._-]", "_", n).lstrip("._-")[:64]) or "app"


def tilde(p):
    return "~/" + p[len(HOME) + 1:] if p.startswith(HOME + "/") else p


def install_hint(pkg):
    """How to install a package on this distribution (from /etc/os-release)."""
    ids = []
    try:
        with open("/etc/os-release") as f:
            for line in f:
                k, _, v = line.strip().partition("=")
                if k in ("ID", "ID_LIKE"): ids += v.strip('"').split()
    except OSError:
        pass
    cmds = {"fedora": "sudo dnf install", "rhel": "sudo dnf install", "centos": "sudo dnf install",
            "debian": "sudo apt install", "ubuntu": "sudo apt install", "arch": "sudo pacman -S",
            "opensuse": "sudo zypper install", "suse": "sudo zypper install", "alpine": "sudo apk add",
            "void": "sudo xbps-install"}
    for i in ids:
        if i in cmds: return f"{cmds[i]} {pkg}"
    return f"install the '{pkg}' package"


def exit_code(rc):
    """The shell's way: 128 + the signal number when the program was killed by a signal."""
    return 128 - rc if rc < 0 else rc


def elf_interpreter(path):
    """The dynamic loader an ELF program asks for (PT_INTERP), or None. Lets a file without the execute bit be run."""
    try:
        with open(path, "rb") as f:
            h = f.read(64)
            if h[:4] != b"\x7fELF" or h[5] != 1: return None                     # not ELF, or big-endian
            if h[4] == 2: phoff, phentsize, phnum = struct.unpack_from("<QHH", h, 32)[0], *struct.unpack_from("<HH", h, 54)
            elif h[4] == 1: phoff, phentsize, phnum = struct.unpack_from("<I", h, 28)[0], *struct.unpack_from("<HH", h, 42)
            else: return None
            for i in range(min(phnum, 64)):
                f.seek(phoff + i * phentsize)
                e = f.read(phentsize)
                if h[4] == 2: kind, _, off, _, _, size = struct.unpack_from("<IIQQQQ", e)
                else: kind, off, _, _, size = struct.unpack_from("<IIIII", e)
                if kind == 3 and 0 < size < 4096:                                 # PT_INTERP
                    f.seek(off)
                    p = f.read(size).split(b"\0")[0].decode(errors="replace")
                    return p if os.path.isabs(p) and os.path.isfile(p) else None
    except (OSError, struct.error, IndexError):
        pass
    return None


# ---------------------------------------------------------------- small helpers
def machine_id(name, create):
    """A random machine-id per program, so the real one can't be used to recognise your computer."""
    p = f"{CONF}/ids/{name}"
    if create and not os.path.exists(p):
        os.makedirs(os.path.dirname(p), exist_ok=True)
        with open(p, "w") as f: f.write(uuid.uuid4().hex + "\n")
    return p


def find_program(prog, noexec=False):
    path = os.path.abspath(prog) if "/" in prog else shutil.which(prog)
    if not path or not os.path.isfile(path) or not (noexec or os.access(path, os.X_OK)):
        die(f"'{prog}' not found or not executable")
    real = os.path.realpath(path)
    if real.startswith(DRIVES):
        die(f"'{prog}' is on another drive, which the sandbox hides. Copy it somewhere else first.")
    return path, real


def resolv_dirs():
    """/etc/resolv.conf is often a link into /run, which is emptied; keep the folder it points to."""
    out = ["/run/systemd/resolve", "/run/NetworkManager"]
    try:
        t = os.path.realpath("/etc/resolv.conf")
        if t.startswith("/run/") and os.path.dirname(t) not in out: out.append(os.path.dirname(t))
    except OSError:
        pass
    return out


def runtime_dir():
    return os.environ.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}"


def wayland_path():
    wl = os.environ.get("WAYLAND_DISPLAY", "")
    if not wl: return None
    p = wl if wl.startswith("/") else f"{runtime_dir()}/{wl}"
    return p if os.path.exists(p) else None


def sandbox_path():
    p = ["/usr/local/bin", "/usr/bin", "/usr/sbin"]
    if os.path.isdir("/bin") and not os.path.islink("/bin"): p += ["/bin", "/sbin"]          # distros without merged /usr
    if os.path.islink("/run/current-system"): p += ["/run/current-system/sw/bin", "/run/current-system/profile/bin"]
    return ":".join(p)


def bwrap_has(flag):
    try: r = subprocess.run(["bwrap", "--help"], capture_output=True, text=True, timeout=10)
    except (OSError, subprocess.TimeoutExpired): return False
    return flag in r.stdout + r.stderr


def scoped_xauth(src, disp, dst):
    """A copy of the XAUTHORITY file with only the cookie for this display (no xauth tool needed), or None."""
    num = disp[1:].split(".")[0].encode()
    try:
        with open(src, "rb") as f: data = f.read(1_000_000)
    except OSError:
        return None
    keep, i = [], 0
    while i + 2 <= len(data):
        start = i
        i += 2                                    # family
        fields = []
        for _ in range(4):                        # address, display number, auth name, auth data
            if i + 2 > len(data): return None     # truncated or not an Xauthority file: use it unchanged
            n = int.from_bytes(data[i:i+2], "big"); i += 2
            fields.append(data[i:i+n]); i += n
        if i > len(data): return None
        if fields[1] in (num, b""): keep.append(data[start:i])
    if not keep: return None
    try:
        os.makedirs(os.path.dirname(dst), mode=0o700, exist_ok=True)
        fd = os.open(dst, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        with os.fdopen(fd, "wb") as f: f.write(b"".join(keep))
    except OSError:
        return None
    return dst


# ---------------------------------------------------------------- system-call filter
def blocked_numbers(machine, allow=()):
    """The numbers of the blocked system calls on this architecture."""
    col = ARCHES[machine][1]
    allowed = set()
    for n in allow: allowed.update(IO_URING if n == "io_uring" else [n])
    nrs = [t[col] for t in BASE_SYSCALLS.values() if t[col] is not None]
    nrs += [t[col] for n, t in EXTRA_SYSCALLS.items() if n not in allowed and t[col] is not None]
    return nrs


def seccomp_program(machine, allow=()):
    """The blocklist as a raw BPF program (bytes), or None on an architecture without a list."""
    if machine not in ARCHES: return None
    audit, nrs = ARCHES[machine][0], blocked_numbers(machine, allow)
    deny = 0x00050000 | errno.EPERM
    n = len(nrs)
    ins = [(0x20, 0, 0, 4), (0x15, 1, 0, audit), (0x06, 0, 0, deny), (0x20, 0, 0, 0),
           (0x35, n + 1, 0, 0x40000000)]                       # x32 calls: deny
    ins += [(0x15, n - i, 0, nr) for i, nr in enumerate(nrs)]   # listed syscall: jump to deny
    ins += [(0x06, 0, 0, 0x7FFF0000), (0x06, 0, 0, deny)]       # allow, deny
    return b"".join(struct.pack("=HBBI", *i) for i in ins)


def seccomp_file(allow=()):
    prog = seccomp_program(platform.machine(), allow)
    if prog is None: return None
    tf = tempfile.TemporaryFile()
    tf.write(prog); tf.flush(); tf.seek(0)
    return tf


# ---------------------------------------------------------------- Wayland security context
class WlError(Exception):
    pass


def wl_string(s):
    b = s.encode() + b"\0"
    return struct.pack("=I", len(b)) + b + b"\0" * (-len(b) % 4)


class Wl:
    """A tiny Wayland client: just enough of the wire protocol to ask for a security context (no libwayland needed)."""
    def __init__(self, path):
        self.sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        self.sock.settimeout(3)
        try: self.sock.connect(path)
        except OSError:
            self.sock.close(); raise
        self.last, self.buf = 1, b""              # object 1 is wl_display

    def new_id(self):
        self.last += 1
        return self.last

    def send(self, obj, opcode, payload=b"", fds=()):
        msg = struct.pack("=II", obj, ((8 + len(payload)) << 16) | opcode) + payload
        if fds: self.sock.sendmsg([msg], [(socket.SOL_SOCKET, socket.SCM_RIGHTS, array.array("i", fds))])
        else: self.sock.sendall(msg)

    def read(self, n):
        while len(self.buf) < n:
            d = self.sock.recv(4096)
            if not d: raise WlError("the compositor closed the connection")
            self.buf += d
        out, self.buf = self.buf[:n], self.buf[n:]
        return out

    def roundtrip(self, registry):
        """wl_display.sync, then read events until it is answered. Returns the (name, interface, version) globals seen."""
        cb = self.new_id()
        self.send(1, 0, struct.pack("=I", cb))
        found = []
        while True:
            head = self.read(8)
            obj, word = struct.unpack("=II", head)
            data = self.read((word >> 16) - 8)
            op = word & 0xFFFF
            if obj == 1 and op == 0:              # wl_display.error(object, code, message)
                (n,) = struct.unpack_from("=I", data, 8)
                raise WlError(data[12:12 + n - 1].decode(errors="replace"))
            if obj == registry and op == 0:       # wl_registry.global(name, interface, version)
                name, n = struct.unpack_from("=II", data)
                iface = data[8:8 + n - 1].decode(errors="replace")
                (ver,) = struct.unpack_from("=I", data, 8 + (n + 3) // 4 * 4)
                found.append((name, iface, ver))
            elif obj == cb and op == 0:
                return found

    def close(self):
        try: self.sock.close()
        except OSError: pass


class WlContext:
    """What must stay open while the program runs: closing `hangup` tells the compositor to stop listening."""
    def __init__(self, hangup, path):
        self.hangup, self.path = hangup, path

    def close(self):
        try: os.close(self.hangup)
        except OSError: pass
        try: os.unlink(self.path)
        except OSError: pass


def wl_supported(display):
    """Does the compositor at this socket offer wp_security_context_manager_v1? (Read-only: nothing is registered.)"""
    try: c = Wl(display)
    except OSError: return False
    try:
        reg = c.new_id()
        c.send(1, 1, struct.pack("=I", reg))      # wl_display.get_registry
        return any(g[1] == "wp_security_context_manager_v1" for g in c.roundtrip(reg))
    except (OSError, WlError, struct.error):
        return False
    finally:
        c.close()


def wayland_context(display, sock_path, app_id, instance):
    """Register a listening socket with a security context. The program connects to that socket instead of the
    compositor's own, and the compositor then treats it as a sandboxed client (no screen capture, no input injection...).
    Returns a WlContext, or None when the compositor doesn't offer the protocol (or something went wrong; a warning says so)."""
    try: c = Wl(display)
    except OSError as e:
        warn(f"can't reach the Wayland compositor: {e.strerror}"); return None
    srv, pipe, made = None, None, False
    try:
        reg = c.new_id()
        c.send(1, 1, struct.pack("=I", reg))
        found = next((g for g in c.roundtrip(reg) if g[1] == "wp_security_context_manager_v1"), None)
        if not found: return None
        mgr = c.new_id()
        c.send(reg, 0, struct.pack("=I", found[0]) + wl_string(found[1]) + struct.pack("=II", 1, mgr))   # wl_registry.bind
        os.makedirs(os.path.dirname(sock_path), mode=0o700, exist_ok=True)
        try: os.unlink(sock_path)
        except FileNotFoundError: pass
        srv = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        srv.bind(sock_path); made = True
        srv.listen(32)
        pipe = os.pipe()
        ctx = c.new_id()
        c.send(mgr, 1, struct.pack("=I", ctx), fds=[srv.fileno(), pipe[0]])    # create_listener(id, listen_fd, close_fd)
        c.send(ctx, 1, wl_string("org.sbx"))                                   # set_sandbox_engine
        c.send(ctx, 2, wl_string(app_id))                                      # set_app_id
        c.send(ctx, 3, wl_string(instance))                                    # set_instance_id
        c.send(ctx, 4)                                                         # commit
        c.roundtrip(reg)                                                       # a protocol error shows up here
        os.close(pipe[0])
        out = WlContext(pipe[1], sock_path)
        pipe = None
        return out
    except (OSError, WlError, struct.error) as e:
        warn(f"Wayland security context failed: {e}")
        if made:
            try: os.unlink(sock_path)
            except OSError: pass
        return None
    finally:
        if srv: srv.close()
        if pipe:
            for fd in pipe: os.close(fd)
        c.close()


# ---------------------------------------------------------------- portals
def portal_rules(cfg=None):
    rules = ["--talk=org.freedesktop.Notifications", f"--see={PORTAL_NAME}"]
    extra = [i for k, i in PORTAL_EXTRA.items() if cfg and cfg.get(k)]
    if cfg and cfg.get("camera"): extra.append("Camera")          # the Camera portal follows the camera switch
    rules += [f"--call={PORTAL_NAME}=org.freedesktop.portal.{i}.*" for i in PORTAL_BASIC + tuple(extra)]
    rules += [f"--call={PORTAL_NAME}=org.freedesktop.portal.Request.*@/org/freedesktop/portal/desktop/request/*",
              f"--call={PORTAL_NAME}=org.freedesktop.portal.Session.*@/org/freedesktop/portal/desktop/session/*",   # screencast etc. sessions
              f"--call={PORTAL_NAME}=org.freedesktop.DBus.Properties.*@/org/freedesktop/portal/desktop",
              "--broadcast=org.freedesktop.portal.*=@/org/freedesktop/portal/*"]
    return rules


def start_proxy(sock, cfg=None):
    """Start xdg-dbus-proxy with the portal rules. Returns (process, pipe) or None (a warning says why)."""
    px = shutil.which("xdg-dbus-proxy")
    if not px:
        warn(f"xdg-dbus-proxy missing, so portals are off: {install_hint('xdg-dbus-proxy')}")
        return None
    addr = os.environ.get("DBUS_SESSION_BUS_ADDRESS") or f"unix:path={runtime_dir()}/bus"
    os.makedirs(os.path.dirname(sock), mode=0o700, exist_ok=True)
    r, w = os.pipe()
    proc = subprocess.Popen([px, f"--fd={w}", addr, sock, "--filter"] + portal_rules(cfg), pass_fds=[w],
                            stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    os.close(w)
    ok = False
    try: ok = bool(select.select([r], [], [], 3)[0]) and bool(os.read(r, 1))
    except OSError: pass
    if ok: return proc, r
    stop_proxy((proc, r), sock)
    warn("could not start xdg-dbus-proxy; running without portals")
    return None


def stop_proxy(px, sock):
    if px:
        try: os.close(px[1])
        except OSError: pass
        try: px[0].terminate(); px[0].wait(2)
        except Exception: pass
    try: os.unlink(sock)
    except OSError: pass


# ---------------------------------------------------------------- settings
def parse_bool(v):
    v = v.strip().lower()
    return True if v in ("1", "true", "yes", "on") else False if v in ("0", "false", "no", "off") else None


def env_name_ok(k):
    return bool(re.fullmatch(r"[A-Za-z_][A-Za-z0-9_]*", k))


def syscall_ok(n):
    return n == "io_uring" or n in EXTRA_SYSCALLS


def parse_conf(path):
    """Plain key=value file. Returns (switches, lists, limits). '#' starts a comment. A line that makes no sense is
    reported and skipped, so a typo like net=maybe doesn't silently mean something else."""
    sc, ls, lim = {}, {k: [] for k in LISTS}, {}
    try:
        with open(path) as f: lines = f.read().splitlines()
    except OSError:
        return sc, ls, lim
    for n, line in enumerate(lines, 1):
        line = re.sub(r"(^|\s)#.*$", "", line).strip()
        if "=" not in line: continue
        k, _, v = (x.strip() for x in line.partition("="))
        at = f"{path}:{n}"
        if k in ls:
            if k == "env" and not env_name_ok(v): warn(f"{at}: '{v}' is not a variable name, ignored")
            elif k == "setenv" and ("=" not in v or not env_name_ok(v.partition("=")[0])): warn(f"{at}: setenv needs NAME=value, ignored")
            elif k == "allow_syscall" and not syscall_ok(v): warn(f"{at}: can't allow '{v}': not one of {', '.join(sorted(EXTRA_SYSCALLS))}, io_uring")
            elif v: ls[k].append(v)
        elif k in SCALARS:
            b = parse_bool(v)
            if b is None: warn(f"{at}: {k}={v} is not 0 or 1, ignored")
            else: sc[k] = b
        elif k in LIMITS:
            if v == "" or re.fullmatch(LIMITS[k], v): lim[k] = v
            else: warn(f"{at}: {k}={v} is not a valid limit, ignored")
        else:
            warn(f"{at}: ignoring unknown setting '{k}'")
    return sc, ls, lim


def load_conf(name, ignore=False):
    """Built-in defaults < default.conf < apps/NAME.conf. Lists add up. Returns (settings, where each value came from)."""
    cfg = {**SCALARS, **{k: "" for k in LIMITS}, **{k: [] for k in LISTS}}
    src = {k: "default" for k in cfg}
    if ignore: return cfg, src
    for label, path in (("default.conf", f"{CONF}/default.conf"), (f"apps/{name}.conf", f"{CONF}/apps/{name}.conf")):
        sc, ls, lim = parse_conf(path)
        for k, v in {**sc, **lim}.items(): cfg[k], src[k] = v, label
        for k in LISTS:
            for v in ls[k]:
                if v not in cfg[k]: cfg[k].append(v); src[(k, v)] = label
    return cfg, src


def effective(name, o):
    """The settings for one program: files, then command-line flags on top."""
    cfg, src = load_conf(name, o.get("ignore_config"))
    for k in list(SCALARS) + list(LIMITS):
        if k in o: cfg[k], src[k] = o[k], "flag"
    for k in ("env", "setenv", "allow_syscall"):
        for v in o.get(k, []):
            if v not in cfg[k]: cfg[k].append(v); src[(k, v)] = "flag"
    return cfg, src


# ---------------------------------------------------------------- shared paths
def sensitive_match(q):
    """The secret folder (as ~/...) that this path is, is inside, or contains; None if it is none of those."""
    for rel in SENSITIVE:
        s = f"{HOME}/{rel}"
        if q == s or q.startswith(s + "/") or s.startswith(q + "/"): return "~/" + rel
    return None


def share_path(p, cli, allow_sensitive=False):
    """A file or folder to share: inside your home (not the whole home), on a drive, or in /tmp. None if it can't be."""
    q = os.path.expanduser(p)
    if not cli and not os.path.isabs(q):
        warn(f"skipping '{p}': use a full path or ~/...")
        return None
    q = os.path.realpath(q)
    guarded = [os.path.realpath(x) for x in (CONF, HOMES)]       # the sandbox must not be able to rewrite its own rules
    hit = None if allow_sensitive else sensitive_match(q)
    why = ("doesn't exist" if not os.path.exists(q) else "is your whole home" if q == HOME else
           "would expose sbx's own settings or private homes"
           if any(q == g or q.startswith(g + "/") or g.startswith(q + "/") for g in guarded) else
           f"is or contains {hit}, which holds secrets (use --allow-sensitive or allow_sensitive=1 if you mean it)" if hit else
           None if q.startswith((HOME + "/",) + OUTSIDE) else
           "is outside your home, /mnt, /media and /tmp")
    if not why: return q
    if cli: die(f"'{p}' {why}")
    warn(f"skipping '{p}': it {why}")
    return None


def order_shares(rw, ro, here=None, program=None):
    """[(path, 'rw' | 'ro')] in mount order. A folder is mounted before the paths inside it, so a more specific share
    keeps its own mode whatever order the settings were written in. At the very same path read-only wins."""
    modes = {}
    for p in ([here] if here else []) + rw: modes.setdefault(p, "rw")
    for p in ro + ([program] if program else []): modes[p] = "ro"
    return sorted(modes.items(), key=lambda kv: (kv[0].count("/"), kv[0]))


def program_share(real):
    """What a program in your home brings along: its app folder for .../APP/bin/tool (at least two levels below home,
    so ~/bin, ~/.local/bin and ~/.cargo/bin stay closed), otherwise just the file."""
    d = os.path.dirname(real)
    if os.path.basename(d) == "bin":
        root = os.path.dirname(d)
        if root.startswith(HOME + "/") and "/" in root[len(HOME) + 1:]: return root
    return real


def share_dir(d):
    """The current folder for --here: a folder inside your home, on a drive, or in /tmp, never the whole home."""
    d = os.path.realpath(d)
    if d == HOME: die("--here: refusing to share your whole home; go into a subfolder first")
    if d.startswith(HOME + "/"):
        if d[len(HOME) + 1:].split("/")[0].startswith("."): die("--here: hidden folders in your home can't be shared")
        return d
    if d.startswith(OUTSIDE): return d
    die("--here: only folders inside your home, on /mnt, /media or in /tmp can be shared")


def hint_args(args, here, shared):
    """Warn about arguments that name something on your side the program won't find. Only a hint; nothing changes."""
    said = 0
    for x in args[:64]:
        v = x.split("=", 1)[1] if x.startswith("--") and "=" in x else x
        if not v or v.startswith("-") or len(v) > 1024 or "\n" in v: continue
        host = os.path.abspath(v)
        if not os.path.lexists(host): continue
        inside = lambda base: host == base or host.startswith(base + "/")
        if not os.path.isabs(v):
            if here and inside(here): continue
            why = "the program starts in its private home"
        else:
            if any(inside(s) for s in shared): continue
            if not (inside(HOME) or any(inside(d) for d in ("/tmp", "/run", "/mnt", "/media", "/srv", "/var/tmp", "/root", "/home"))): continue
            why = "that place is not shared"
        warn(f"'{v}' exists here, but the program won't find it ({why}). Use --here, or --whitelist=PATH / --read-only=PATH.")
        said += 1
        if said == 3: break


# ---------------------------------------------------------------- the bwrap command
def build(prog, args, live=False, o=None):
    """The bwrap command. live=True also creates what a real run needs (machine-id, proxy, X cookie, listening sockets...)
    and returns it in `state` so run() can clean up; preview (live=False) only prints."""
    o = o or {}
    loader = o.get("loader")
    if loader and not (os.path.isabs(loader) and os.path.isfile(loader)): die(f"--loader: '{loader}' is not a program")
    path, real = find_program(prog, bool(loader))
    cwd = share_dir(os.getcwd()) if o.get("here") else None
    name = clean(o.get("name") or os.path.basename(path))       # the name you typed, not the file behind a link
    if o.get("name") and name != o["name"]: warn(f"--name: using '{name}' (letters, digits and . _ - only)")
    cfg, src = effective(name, o)
    ok = cfg["allow_sensitive"]
    rw = [p for p in [share_path(x, False, ok) for x in cfg["whitelist"]] + [share_path(x, True, ok) for x in o.get("whitelist", [])] if p]
    ro = [p for p in [share_path(x, False, ok) for x in cfg["read_only"]] + [share_path(x, True, ok) for x in o.get("read_only", [])] if p]
    allow = [n for n in cfg["allow_syscall"] if syscall_ok(n)]
    if live and not cfg["userns"] and not bwrap_has("--disable-userns"):
        die("userns=0 needs bubblewrap 0.8 or newer (--disable-userns). Not starting without it.")
    shares = order_shares(rw, ro, cwd, program_share(real) if real.startswith(HOME + "/") else None)
    rt = runtime_dir()
    tag = f"{rt}/sbx/{os.getpid() if live else 'PID'}"
    state = {"proxy": None, "bus": tag + ".bus", "files": [], "fds": [], "keep": [], "wl": None, "cleanup": [], "prefix": []}
    env = {"HOME": HOME, "USER": USER, "LOGNAME": USER, "PATH": sandbox_path(), "XDG_RUNTIME_DIR": rt, "SBX_ACTIVE": "1"}
    for k in ENV_KEEP:
        if k in os.environ: env[k] = os.environ[k]
    if cfg["compat"]:
        for k, v in os.environ.items():
            if (k in COMPAT_ENV or k.startswith(COMPAT_PREFIXES)) and k not in ENV_PROTECTED: env[k] = v
    a = ["bwrap", "--unshare-all"] + (["--share-net"] if cfg["net"] else [])
    if not cfg["userns"]: a += ["--unshare-user", "--disable-userns"]
    a += ["--die-with-parent", "--new-session", "--clearenv"]
    if cfg["hostname"]: a += ["--hostname", "sbx"]
    machine = platform.machine()
    if machine in ARCHES:
        if live:
            sec = seccomp_file(allow)
            os.set_inheritable(sec.fileno(), True)
            state["keep"].append(sec); state["fds"].append(sec.fileno())
            a += ["--seccomp", str(sec.fileno())]
        else:
            a += ["--seccomp", "FD"]

    def data(dest, text):                       # a read-only file made from text (no file on disk)
        if not live: return ["--ro-bind-data", "FD", dest]
        fd = os.memfd_create("sbx")
        os.write(fd, text.encode()); os.lseek(fd, 0, os.SEEK_SET); os.set_inheritable(fd, True)
        state["fds"].append(fd)
        return ["--ro-bind-data", str(fd), dest]

    def track(dst, source, tryit):              # bwrap creates mountpoints inside the private home; note them for cleanup
        if not live or cfg["private"] or not dst.startswith(HOME + "/") or (tryit and not os.path.exists(source)): return
        parts = dst[len(HOME) + 1:].split("/")
        for i in range(1, len(parts) + 1):
            p = f"{HOMES}/{name}/" + "/".join(parts[:i])
            if not os.path.lexists(p) and p not in state["cleanup"]: state["cleanup"].append(p)

    def mount(kind, source, dst=None):
        dst = dst or source
        a.extend([kind, source, dst]); track(dst, source, kind.endswith("-try"))

    a += ["--ro-bind", "/", "/", "--dev", "/dev", "--proc", "/proc", "--tmpfs", "/tmp", "--tmpfs", "/run"]
    a += data("/proc/sys/kernel/random/boot_id", str(uuid.uuid4()) + "\n")      # the host's boot id is a fingerprint
    for link in NIX_LINKS:
        if os.path.islink(link): a += ["--symlink", os.readlink(link), link]
    for d in resolv_dirs():
        if os.path.isdir(d): a += ["--ro-bind", d, d]
    a += ["--perms", "0700", "--dir", rt]
    # Desktop access (each one a setting): Wayland, X11, GPU, sound, portals.
    gui, late = False, []          # late: mounts that may sit inside the home, so they go after the home is replaced
    wp = wayland_path() if cfg["wayland"] else None
    if wp:
        bind_src = wp
        if live:
            state["wl"] = wayland_context(wp, tag + ".wl", name, f"{name}-{os.getpid()}")
            if state["wl"]: bind_src = tag + ".wl"
        elif wl_supported(wp): bind_src = tag + ".wl"
        if bind_src == wp and cfg["wayland_strict"]:
            if live: warn("the compositor has no security-context support, and wayland_strict is on: Wayland is off")
            wp = None
        elif bind_src == wp and live:
            warn("the compositor has no security-context support, so the program gets full Wayland access")
        if wp:
            a += ["--ro-bind", bind_src, wp]; gui = True
            env["WAYLAND_DISPLAY"] = os.environ["WAYLAND_DISPLAY"]; env["XDG_SESSION_TYPE"] = "wayland"
    if cfg["x11"]:
        disp = os.environ.get("DISPLAY", "")
        if disp.startswith(":"):
            sock = f"/tmp/.X11-unix/X{disp[1:].split('.')[0]}"
            a += ["--ro-bind-try", sock, sock]; env["DISPLAY"] = disp; gui = True
        xa = os.environ.get("XAUTHORITY")
        if xa and os.path.isfile(xa):
            xsrc = xa
            if live and disp.startswith(":"):                  # only this display's cookie, not every cookie in the file
                xsrc = scoped_xauth(xa, disp, tag + ".xauth")
                if xsrc: state["files"].append(xsrc)
                else: warn("no usable cookie for this display in XAUTHORITY; not passing the file")
            if xsrc: late += ["--ro-bind", xsrc, xa]; env["XAUTHORITY"] = xa
    if cfg["gpu"] or cfg["rocm"]:
        a += ["--dev-bind-try", "/dev/dri", "/dev/dri"]
    if cfg["gpu"]:
        for p in sorted(glob.glob("/dev/nvidia*")): a += ["--dev-bind", p, p]
    if cfg["rocm"]: a += ["--dev-bind-try", "/dev/kfd", "/dev/kfd"]
    if cfg["camera"]:
        for p in sorted(glob.glob("/dev/video*") + glob.glob("/dev/media*")): a += ["--dev-bind", p, p]
    if cfg["input"]: a += ["--dev-bind-try", "/dev/input", "/dev/input", "--ro-bind-try", "/run/udev", "/run/udev"]   # SDL/libinput classify devices from udev's database
    if cfg["alsa"]: a += ["--dev-bind-try", "/dev/snd", "/dev/snd"]
    if cfg["kvm"]: a += ["--dev-bind-try", "/dev/kvm", "/dev/kvm"]
    if cfg["printing"]: a += ["--ro-bind-try", "/run/cups/cups.sock", "/run/cups/cups.sock"]; env["CUPS_SERVER"] = "/run/cups/cups.sock"
    if cfg["sound"]:
        for x in ("pipewire-0", "pulse/native"): a += ["--ro-bind-try", f"{rt}/{x}", f"{rt}/{x}"]
        env["PULSE_SERVER"] = f"unix:{rt}/pulse/native"
    sa = os.environ.get("SSH_AUTH_SOCK", "")
    if cfg["ssh_agent"] and sa and os.path.exists(sa):     # the program can sign as you while it runs
        late += ["--ro-bind", sa, sa]; env["SSH_AUTH_SOCK"] = sa
    if cfg["portals"]:
        sock = state["bus"]
        if live:
            state["proxy"] = start_proxy(sock, cfg)
            if not state["proxy"]: sock = None
        if sock:
            a += ["--ro-bind", sock, f"{rt}/bus"]; env["DBUS_SESSION_BUS_ADDRESS"] = f"unix:path={rt}/bus"
    elif live and any(cfg[k] for k in PORTAL_EXTRA):
        warn("portal_* settings need portals=1; ignored")
    # Hide the real home and other users: empty the folder that holds your home, then put the private home in its place.
    parent = os.path.dirname(HOME)
    hide = [parent if parent != "/" else HOME]
    for d in EMPTY_DIRS + ["/home"]:
        if os.path.isdir(d) and not os.path.islink(d) and d not in hide and not HOME.startswith(d + "/"):
            hide.append(d)
    for d in hide: a += ["--tmpfs", d]
    for d in HIDE_SYS + ([] if cfg["net"] else ["/sys/class/net"]):     # /sys/class/net would list the host's cards even without a network
        if os.path.isdir(d): a += ["--tmpfs", d]
    a += ["--tmpfs", HOME] if cfg["private"] else ["--bind", f"{HOMES}/{name}", HOME]     # private=1: erased on exit
    for i in range(0, len(late), 3): mount(late[i], late[i + 1], late[i + 2])
    if gui and cfg["theme"]:
        for rel in THEME: mount("--ro-bind-try", f"{HOME}/{rel}")
    for p, mode in shares: mount("--bind" if mode == "rw" else "--ro-bind", p)      # --here, whitelist=, read_only=, the program itself
    for p in SECRETS + [x for g in SECRET_GLOBS for x in glob.glob(g)]:
        if os.path.isdir(p): a += ["--tmpfs", p]
        elif os.path.isfile(p): a += ["--ro-bind", "/dev/null", p]
    if cfg["hostname"]:                         # /etc/hostname and /etc/hosts would still tell the real name
        if os.path.isfile("/etc/hostname"): a += data("/etc/hostname", "sbx\n")
        if os.path.isfile("/etc/hosts"): a += data("/etc/hosts", "127.0.0.1 localhost\n::1 localhost\n127.0.1.1 sbx\n")
    if os.path.isfile("/etc/machine-id"):
        mid = machine_id(name, live)
        a += ["--ro-bind", mid, "/etc/machine-id"]
        if os.path.isfile("/var/lib/dbus/machine-id") and not os.path.islink("/var/lib/dbus/machine-id"):
            a += ["--ro-bind", mid, "/var/lib/dbus/machine-id"]
    for k in cfg["env"]:                        # your own variables, passed through or set; the core ones are off limits
        if k in os.environ and k not in ENV_PROTECTED: env[k] = os.environ[k]
    for kv in cfg["setenv"]:
        k, _, v = kv.partition("=")
        if k in ENV_PROTECTED: warn(f"setenv: {k} can't be changed")
        else: env[k] = v
    for k, v in env.items(): a += ["--setenv", k, v]
    exe = real if real.startswith(HOME + "/") or path.startswith(HOME + "/") else path
    if live: hint_args(args, cwd, [p for p, _ in shares])
    limits = [f"-p{p}={cfg[k]}" for k, p in (("memory", "MemoryMax"), ("tasks", "TasksMax"), ("cpu", "CPUQuota")) if cfg[k]]
    if limits: state["prefix"] = ["systemd-run", "--user", "--scope", "--quiet"] + limits + ["--"]
    return name, a + ["--chdir", cwd or HOME, "--"] + ([loader] if loader else []) + [exe] + args, state


# ---------------------------------------------------------------- running it
def sweep_stale():
    """Remove helper files that a killed sbx left behind in $XDG_RUNTIME_DIR/sbx (named PID.bus, PID.xauth, PID.wl)."""
    d = f"{runtime_dir()}/sbx"
    try: names = os.listdir(d)
    except OSError: return
    for n in names:
        m = re.fullmatch(r"(\d+)\.(bus|xauth|wl)", n)
        if not m: continue
        try: os.kill(int(m.group(1)), 0); continue          # still running
        except ProcessLookupError: pass
        except OSError: continue
        try: os.unlink(f"{d}/{n}")
        except OSError: pass


def teardown(st):
    stop_proxy(st["proxy"], st["bus"])
    if st["wl"]: st["wl"].close()
    for f in st["files"]:
        try: os.unlink(f)
        except OSError: pass
    for p in reversed(st["cleanup"]):           # mountpoints bwrap made in the private home, if still empty
        try:
            if os.path.isdir(p) and not os.path.islink(p): os.rmdir(p)
            elif os.path.isfile(p) and os.path.getsize(p) == 0: os.unlink(p)
        except OSError:
            pass


def give_exec_bit(path):
    """For a dynamically linked ELF file without the execute bit: set the bit for this run and return the old mode.
    Returns False if it can't be set (the caller then uses the loader), None if there is nothing to do. Running through the
    loader instead would make /proc/self/exe the loader, which breaks programs that read their own file (.NET single-file apps)."""
    if not os.path.isfile(path) or os.access(path, os.X_OK) or not elf_interpreter(path): return None
    try:
        mode = os.stat(path).st_mode
        os.chmod(path, mode | 0o100)
        return mode
    except OSError:
        return False


def undo_exec_bit(prog, mode):
    if mode is not None:
        try: os.chmod(os.path.abspath(prog), mode)
        except OSError: pass


def run(prog, args, opts):
    if os.geteuid() == 0: die("refusing to run as root")
    if os.environ.get("SBX_ACTIVE"): die("already inside an sbx sandbox")
    if not shutil.which("bwrap"): die(f"bubblewrap missing: {install_hint('bubblewrap')}")
    if platform.machine() not in ARCHES: die(f"no system-call filter for {platform.machine()}; not starting without it")
    sweep_stale()
    os.makedirs(HOMES, mode=0o700, exist_ok=True)
    restore = None
    if not opts.get("loader") and "/" in prog:
        restore = give_exec_bit(os.path.abspath(prog))      # a dynamically linked ELF file without the execute bit
        if restore is False:                                # can't change it: go through the loader instead
            opts, restore = {**opts, "loader": elf_interpreter(os.path.abspath(prog))}, None
    try:
        name, cmd, st = build(prog, args, True, opts)
    except BaseException:
        undo_exec_bit(prog, restore); raise
    if st["prefix"] and not shutil.which("systemd-run"):
        teardown(st); undo_exec_bit(prog, restore); die(f"memory/tasks/cpu limits need systemd-run: {install_hint('systemd')}")
    os.makedirs(f"{HOMES}/{name}", mode=0o700, exist_ok=True)
    try:
        p = subprocess.Popen(st["prefix"] + cmd, pass_fds=st["fds"])
        for sg in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP): signal.signal(sg, lambda *_: p.terminate())
        rc = p.wait()
    finally:
        teardown(st); undo_exec_bit(prog, restore)
    sys.exit(exit_code(rc))


