    return "~/" + p[len(HOME) + 1:] if p.startswith(HOME + "/") else p


def install_hint(pkg):
    """How to install a package on this distribution (from /etc/os-release)."""
    ids = []
    try:
        with open("/etc/os-release") as f:
            for line in f:
                k, _, v = line.strip().partition("=")
                if k in ("ID", "ID_LIKE"): ids += v.strip('"').split()
    except OSError:
        pass
    cmds = {"fedora": "sudo dnf install", "rhel": "sudo dnf install", "centos": "sudo dnf install",
            "debian": "sudo apt install", "ubuntu": "sudo apt install", "arch": "sudo pacman -S",
            "opensuse": "sudo zypper install", "suse": "sudo zypper install", "alpine": "sudo apk add",
            "void": "sudo xbps-install"}
    for i in ids:
        if i in cmds: return f"{cmds[i]} {pkg}"
    return f"install the '{pkg}' package"


def exit_code(rc):
    """The shell's way: 128 + the signal number when the program was killed by a signal."""
    return 128 - rc if rc < 0 else rc


def is_i386_elf(path):
    try:
        with open(path, "rb") as f: h = f.read(20)
    except OSError:
        return False
    return len(h) == 20 and h[:6] == b"\x7fELF\x01\x01" and h[18:20] == b"\x03\x00"


def elf_interpreter(path):
    """The dynamic loader an ELF program asks for (PT_INTERP), or None. Lets a file without the execute bit be run."""
    try:
        with open(path, "rb") as f:
            h = f.read(64)
            if h[:4] != b"\x7fELF" or h[5] != 1: return None                     # not ELF, or big-endian
            if h[4] == 2: phoff, phentsize, phnum = struct.unpack_from("<QHH", h, 32)[0], *struct.unpack_from("<HH", h, 54)
            elif h[4] == 1: phoff, phentsize, phnum = struct.unpack_from("<I", h, 28)[0], *struct.unpack_from("<HH", h, 42)
            else: return None
            for i in range(min(phnum, 64)):
                f.seek(phoff + i * phentsize)
                e = f.read(phentsize)
                if h[4] == 2: kind, _, off, _, _, size = struct.unpack_from("<IIQQQQ", e)
                else: kind, off, _, _, size = struct.unpack_from("<IIIII", e)
                if kind == 3 and 0 < size < 4096:                                 # PT_INTERP
                    f.seek(off)
                    p = f.read(size).split(b"\0")[0].decode(errors="replace")
                    return p if os.path.isabs(p) and os.path.isfile(p) else None
    except (OSError, struct.error, IndexError):
        pass
    return None


# ---------------------------------------------------------------- small helpers
def machine_id(name, create):
    """A random machine-id per program, so the real one can't be used to recognise your computer."""
    p = f"{CONF}/ids/{name}"
    if create and not os.path.exists(p):
        os.makedirs(os.path.dirname(p), exist_ok=True)
        fd = os.open(p, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
        with os.fdopen(fd, "w") as f: f.write(uuid.uuid4().hex + "\n")
    return p


def is_sbx_link(p):
    """A link made by `sbx link`: a symbolic link to the sbx script."""
    try: return os.path.islink(p) and os.path.basename(os.readlink(p)) == "sbx"
    except OSError: return False


def find_in_path(name):
    """Like shutil.which, but links made by `sbx link` don't count: they are how sbx gets started, not the program."""
    for d in os.environ.get("PATH", "").split(":"):
        if not d: continue
        p = os.path.join(d, name)
        if os.path.isfile(p) and os.access(p, os.X_OK) and not is_sbx_link(p): return p
    return None


def find_program(prog, noexec=False):
    path = os.path.abspath(prog) if "/" in prog else find_in_path(prog)
    if not path or not os.path.isfile(path):
        if "/" not in prog and os.path.isfile(prog): die(f"'{prog}' is a file in this folder, but a bare name is looked up in your PATH. Write ./{prog}")
        die(f"'{prog}' not found" + (" in your PATH" if "/" not in prog else ""))
    if not (noexec or os.access(path, os.X_OK)): die(f"'{prog}' is not executable. Run: chmod +x {shlex.quote(prog)}")
    real = os.path.realpath(path)
    if real.startswith(DRIVES):
        die(f"'{prog}' is on another drive, which the sandbox hides. Copy it somewhere else first.")
    return path, real


def resolv_target():
    """The file /etc/resolv.conf really is: its link target when it is a link (often into /run), else itself. bwrap can't
    mount onto a symlink, so anything that replaces the name server file is bound onto this path."""
    return os.path.realpath("/etc/resolv.conf")


def resolv_dirs():
    """/etc/resolv.conf is often a link into /run, which is emptied; keep the folder it points to."""
    out = ["/run/systemd/resolve", "/run/NetworkManager"]
    try:
        t = resolv_target()
        if t.startswith("/run/") and os.path.dirname(t) not in out: out.append(os.path.dirname(t))
    except OSError:
        pass
    return out


def runtime_dir():
    return os.environ.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}"


def wayland_path():
    wl = os.environ.get("WAYLAND_DISPLAY", "")
    if not wl: return None
    p = wl if wl.startswith("/") else f"{runtime_dir()}/{wl}"
    return p if os.path.exists(p) else None


def sandbox_path():
    p = ["/usr/local/bin", "/usr/bin", "/usr/sbin"]
    if os.path.isdir("/bin") and not os.path.islink("/bin"): p += ["/bin", "/sbin"]          # distros without merged /usr
    if os.path.islink("/run/current-system"): p += ["/run/current-system/sw/bin", "/run/current-system/profile/bin"]
    return ":".join(p)


def bwrap_help():
    """The text of `bwrap --help`, or "" if it can't be run. Asked once per run of sbx."""
    if not BWRAP_HELP:
        try: r = subprocess.run(["bwrap", "--help"], capture_output=True, text=True, timeout=10)
        except (OSError, subprocess.TimeoutExpired): return ""
        BWRAP_HELP.append(r.stdout + r.stderr)
    return BWRAP_HELP[0]


BWRAP_HELP = []


def bwrap_has(flag):
    return flag in bwrap_help()


def private_net(cfg):
    """net_private: the program gets its own network (through pasta) that reaches the internet but not this computer."""
    return bool(cfg["net"] and cfg["net_private"])


# pasta gives the sandbox its own network namespace. Nothing is forwarded in either direction (-t/-u/-T/-U none), the gateway
# address is not mapped to this computer (--no-map-gw), and DNS goes through a forwarder address that pasta answers itself.
DNS_FWD = "169.254.1.1"
PASTA = ["pasta", "--quiet", "--config-net", "--no-map-gw", "--dns-forward", DNS_FWD,
         "-t", "none", "-u", "none", "-T", "none", "-U", "none", "--"]
SEC_FD = 9      # pasta closes inherited descriptors, so bwrap's seccomp filter is re-opened from a file inside it
INFO_FD = 8     # and the file bwrap writes its --info-fd to likewise (one digit: dash, the usual /bin/sh, can't open "10>file")


def net_wrap(files=()):
    """The words that go in front of bwrap to run it inside pasta. FILES is a list of (descriptor, "<" to read or ">" to write, path):
    a shell first opens each file as that descriptor, which bwrap then inherits."""
    if not files: return PASTA
    opens = "; ".join(f'exec {fd}{op}"${i}"' for i, (fd, op, _) in enumerate(files, 1))
    return PASTA + ["/bin/sh", "-c", f'{opens}; shift {len(files)}; exec "$@"', "sh"] + [path for _, _, path in files]


def pasta_problem():
    """Why pasta can't give the sandbox a network here, or None; its tap device comes from /dev/net/tun."""
    if not os.access("/dev/net/tun", os.R_OK | os.W_OK): return "/dev/net/tun is missing or not usable by you (try: sudo modprobe tun)"
    return None


def scoped_xauth(src, disp, dst):
    """A copy of the XAUTHORITY file with only the cookie for this display on this computer (no xauth tool needed), or None.
    An entry is kept when it is for this display number AND for this machine (family Local with our host name, or family
    Wild), so a cookie for display :0 on another host is not shared. Entries with no display number (Xwayland's own auth
    file) are kept too. A DISPLAY that is not ':N' (for example SSH's localhost:10.0) gets nothing."""
    if not disp.startswith(":"): return None
    num = disp[1:].split(".")[0].encode()
    me = os.fsencode(socket.gethostname())
    try:
        with open(src, "rb") as f: data = f.read(1_000_000)
    except OSError:
        return None
    keep, i = [], 0
    while i + 2 <= len(data):
        start = i
        fam = int.from_bytes(data[i:i+2], "big"); i += 2      # family: 256 Local, 65535 Wild
        fields = []
        for _ in range(4):                        # address, display number, auth name, auth data
            if i + 2 > len(data): return None     # truncated or not an Xauthority file: not shared
            n = int.from_bytes(data[i:i+2], "big"); i += 2
            fields.append(data[i:i+n]); i += n
        if i > len(data): return None
        mine = fam == 65535 or (fam == 256 and fields[0] == me)
        if fields[1] == b"" or (fields[1] == num and mine): keep.append(data[start:i])
    if not keep: return None
    try:
        os.makedirs(os.path.dirname(dst), mode=0o700, exist_ok=True)
        fd = os.open(dst, os.O_WRONLY | os.O_CREAT | os.O_TRUNC | os.O_NOFOLLOW, 0o600)
        with os.fdopen(fd, "wb") as f: f.write(b"".join(keep))
    except OSError:
        return None
    return dst


# ---------------------------------------------------------------- desktop settings the sandbox can't read
# The title-bar button layout (minimize, maximize, close) and the cursor theme and size live in dconf, which a sandboxed GTK
# program can't reach: it falls back to GTK's own defaults (no minimize/maximize button on GNOME, a different cursor).
# sbx runs outside the sandbox, so it reads them here and gives the program only these settings, as a GSettings key file
# (GTK reads them from GSettings, and that beats a settings.ini). The program is pointed at it with GSETTINGS_BACKEND=keyfile.
# Nothing is hardcoded: if no desktop setting is found, nothing is shared. Every value is checked before it goes in the file.
LAYOUT_KEYS = (("org.gnome.desktop.wm.preferences", "button-layout"),     # GNOME (stored in dconf)
               ("org.cinnamon.muffin", "button-layout"),
               ("org.mate.Marco.general", "button-layout"))
LAYOUT_RE = re.compile(r"[a-z,:_]{0,64}")       # only button names, commas and the colon; anything else is ignored
CURSOR_SCHEMA = "org.gnome.desktop.interface"
CURSOR_THEME_RE = re.compile(r"[A-Za-z0-9][A-Za-z0-9 ._+-]{0,63}")    # a folder name: no '/', no quotes, no leading dot
CURSOR_SIZE_RE = re.compile(r"[0-9]{1,3}")
CURSOR_SIZE_MAX = 256


def gsettings_get(schema, key):
    """The raw gsettings value as text, or None (no gsettings, no such key, error, timeout)."""
    gs = shutil.which("gsettings")
    if not gs: return None
    try: r = subprocess.run([gs, "get", schema, key], capture_output=True, text=True, timeout=3)
    except (OSError, subprocess.SubprocessError, ValueError): return None
    return r.stdout.strip() if r.returncode == 0 else None


def gsettings_string(raw):
    """The text of a plain gsettings string 'like this', else None. No escapes, no other quote style."""
    if raw is None or len(raw) < 2 or raw[0] != "'" or raw[-1] != "'": return None
    return raw[1:-1]


def gtk_ini_layout():
    """gtk-decoration-layout from your own GTK settings.ini, or None."""
    for ver in ("gtk-4.0", "gtk-3.0"):
        try:
            with open(f"{HOME}/.config/{ver}/settings.ini") as f:
                for ln in f:
                    k, _, v = ln.partition("=")
                    if k.strip() == "gtk-decoration-layout" and LAYOUT_RE.fullmatch(v.strip()): return v.strip()
        except (OSError, UnicodeDecodeError):
            pass
    return None


KDE_BUTTONS = {"M": "menu", "I": "minimize", "A": "maximize", "X": "close"}      # KDE's other buttons (help, pin, ...) have no GTK name


def host_is_kde():
    return "KDE" in os.environ.get("XDG_CURRENT_DESKTOP", "").upper().split(":")


def kde_config_get(file, group, key):
    """One value from ~/.config/FILE (KDE's ini format: [Group], then key=value), or None."""
    try:
        with open(f"{HOME}/.config/{file}", encoding="utf-8") as f:
            inside = False
            for ln in f:
                ln = ln.strip()
                if ln.startswith("["): inside = ln == f"[{group}]"; continue
                k, eq, v = ln.partition("=")
                if inside and eq and k.strip() == key: return v.strip()
    except (OSError, UnicodeDecodeError):
        pass
    return None


def kde_button_layout():
    """The title-bar buttons KWin draws (kwinrc), as a GTK layout like 'menu:minimize,maximize,close', or None."""
    left = kde_config_get("kwinrc", "org.kde.kdecoration2", "ButtonsOnLeft")
    right = kde_config_get("kwinrc", "org.kde.kdecoration2", "ButtonsOnRight")
    if left is None and right is None: return None
    left, right = "MS" if left is None else left, "HIAX" if right is None else right      # KWin's defaults
    layout = ",".join(KDE_BUTTONS[c] for c in left if c in KDE_BUTTONS) + ":" + ",".join(KDE_BUTTONS[c] for c in right if c in KDE_BUTTONS)
    return layout if LAYOUT_RE.fullmatch(layout) else None


def host_button_layout():
    """The button layout from the desktop settings (KWin on KDE, else gsettings/dconf), else from your own GTK settings.ini, else None."""
    if host_is_kde():          # gsettings would answer with GNOME's default here, not what KWin draws
        v = kde_button_layout()
        if v is not None: return v
    for schema, key in LAYOUT_KEYS:
        v = gsettings_get(schema, key)
        v = v.strip("'\"") if v is not None else None
        if v is not None and LAYOUT_RE.fullmatch(v): return v
    return gtk_ini_layout()


def cursor_size_is_zero():
    """True when the host's gsettings cursor-size is 0. host_cursor() counts 0 as unset, so it can't tell 0 from missing."""
    size = gsettings_get(CURSOR_SCHEMA, "cursor-size")
    return size is not None and CURSOR_SIZE_RE.fullmatch(size) is not None and int(size) == 0


def host_cursor():
    """(theme, size) of the host's cursor from gsettings; None for whatever is missing or doesn't pass the checks.
    Size 0 means 'default' and counts as unset."""
    theme = gsettings_string(gsettings_get(CURSOR_SCHEMA, "cursor-theme"))
    if theme is not None and not CURSOR_THEME_RE.fullmatch(theme): theme = None
    size = gsettings_get(CURSOR_SCHEMA, "cursor-size")
    if size is not None and CURSOR_SIZE_RE.fullmatch(size) and 0 < int(size) <= CURSOR_SIZE_MAX: size = int(size)
    else: size = None
    if host_is_kde():          # what Plasma's cursor settings say wins over gsettings' defaults
        kt = kde_config_get("kcminputrc", "Mouse", "cursorTheme")
        ks = kde_config_get("kcminputrc", "Mouse", "cursorSize")
        if kt is not None and CURSOR_THEME_RE.fullmatch(kt): theme = kt
        if ks is not None and CURSOR_SIZE_RE.fullmatch(ks) and 0 < int(ks) <= CURSOR_SIZE_MAX: size = int(ks)
    return theme, size


def gsettings_keyfile_text():
    """Text of the key file: just the host's button layout and cursor theme/size. None if there is nothing to share.
    Always written under GNOME's schemas, which are the ones GTK reads, whichever desktop the values came from."""
    out = []
    layout = host_button_layout()
    if layout is not None: out.append(f"[org/gnome/desktop/wm/preferences]\nbutton-layout='{layout}'\n")
    theme, size = host_cursor()
    cur = ([f"cursor-theme='{theme}'\n"] if theme is not None else []) + ([f"cursor-size={size}\n"] if size is not None else [])
    if cur: out.append("[org/gnome/desktop/interface]\n" + "".join(cur))
    return "\n".join(out) or None


def gsettings_keyfile(dst, live):
    """The key file for this run at dst (written only when live), or None when there is nothing to share."""
    text = gsettings_keyfile_text()
    if text is None: return None
    if live:
        os.makedirs(os.path.dirname(dst), mode=0o700, exist_ok=True)
        fd = os.open(dst, os.O_WRONLY | os.O_CREAT | os.O_TRUNC | os.O_NOFOLLOW, 0o600)
        with os.fdopen(fd, "w") as f: f.write(text)
    return dst


# ---------------------------------------------------------------- system-call filter
def blocked_numbers(machine, allow=(), col=None):
    """The numbers of the blocked system calls on this architecture (col picks another table column)."""
    if col is None: col = ARCHES[machine][1]
    allowed = set()
    for n in allow: allowed.update(IO_URING if n == "io_uring" else [n])
    nrs = [t[col] for t in BASE_SYSCALLS.values() if t[col] is not None]
    nrs += [t[col] for n, t in EXTRA_SYSCALLS.items() if n not in allowed and t[col] is not None]
    return nrs


def _abi_block(nrs, sock_nr, x32):
    """One ABI's filter as BPF tuples: blocklist plus socket() family check. Jumps stay inside the block."""
    deny = 0x00050000 | errno.EPERM
    n, fam = len(nrs), SOCKET_FAMILIES
    if n + len(fam) > 245: raise ValueError("too many blocked system calls: a BPF jump offset is 8 bits")
    b = len(fam) + 3                                            # length of the socket block below
    ins = [(0x20, 0, 0, 0)]
    if x32: ins += [(0x35, n + b + 1, 0, 0x40000000)]           # x32 calls: deny (not needed for i386)
    ins += [(0x15, 0, b - 1, sock_nr), (0x20, 0, 0, 16)]       # socket(): load the family (low half of arg 0)
    ins += [(0x15, n + b - 3 - i, 0, f) for i, f in enumerate(fam)]    # listed family: jump to allow
    ins += [(0x06, 0, 0, deny)]                                # any other family: deny
    ins += [(0x15, n - i, 0, nr) for i, nr in enumerate(nrs)]   # listed syscall: jump to deny
    ins += [(0x06, 0, 0, 0x7FFF0000), (0x06, 0, 0, deny)]       # allow, deny
    return ins


def seccomp_program(machine, allow=(), compat32=False):
    """The blocklist as a raw BPF program (bytes), or None on an architecture without a list. compat32 adds i386 on x86_64."""
    if machine not in ARCHES: return None
    audit = ARCHES[machine][0]
    deny = 0x00050000 | errno.EPERM
    blocks = [(audit, _abi_block(blocked_numbers(machine, allow), SOCKET_NR[machine], True))]
    if compat32 and machine in COMPAT32:
        a32, col32, sock32, _socketcall = COMPAT32[machine]
        blocks.append((a32, _abi_block(blocked_numbers(machine, allow, col32), sock32, False)))
    ins = [(0x20, 0, 0, 4)]
    sizes = [len(blk) for _, blk in blocks]
    for i, (arch, _) in enumerate(blocks):
        ins.append((0x15, sum(sizes[:i]) + (len(blocks) - 1 - i) + 1, 0, arch))    # skip the later dispatch jumps, the deny and the earlier blocks
    ins.append((0x06, 0, 0, deny))                             # unknown architecture
    for _, blk in blocks: ins += blk
    return b"".join(struct.pack("=HBBI", *i) for i in ins)


def seccomp_file(allow=(), compat32=False):
    prog = seccomp_program(platform.machine(), allow, compat32)
    if prog is None: return None
    tf = tempfile.TemporaryFile()
    tf.write(prog); tf.flush(); tf.seek(0)
    return tf


# ---------------------------------------------------------------- Wayland security context
class WlError(Exception):
    pass


def wl_string(s):
    b = s.encode() + b"\0"
    return struct.pack("=I", len(b)) + b + b"\0" * (-len(b) % 4)


class Wl:
    """A tiny Wayland client: just enough of the wire protocol to ask for a security context (no libwayland needed)."""
    def __init__(self, path):
        self.sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        self.sock.settimeout(3)
        try: self.sock.connect(path)
        except OSError:
            self.sock.close(); raise
        self.last, self.buf = 1, b""              # object 1 is wl_display

    def new_id(self):
        self.last += 1
        return self.last

    def send(self, obj, opcode, payload=b"", fds=()):
        msg = struct.pack("=II", obj, ((8 + len(payload)) << 16) | opcode) + payload
        if fds: self.sock.sendmsg([msg], [(socket.SOL_SOCKET, socket.SCM_RIGHTS, array.array("i", fds))])
        else: self.sock.sendall(msg)

    def read(self, n):
        while len(self.buf) < n:
            d = self.sock.recv(4096)
            if not d: raise WlError("the compositor closed the connection")
            self.buf += d
        out, self.buf = self.buf[:n], self.buf[n:]
        return out

    def roundtrip(self, registry):
        """wl_display.sync, then read events until it is answered. Returns the (name, interface, version) globals seen."""
        cb = self.new_id()
        self.send(1, 0, struct.pack("=I", cb))
        found = []
        while True:
            head = self.read(8)
            obj, word = struct.unpack("=II", head)
            size = word >> 16
            if size < 8: raise WlError("the compositor sent a malformed message")
            data = self.read(size - 8)
            op = word & 0xFFFF
            if obj == 1 and op == 0:              # wl_display.error(object, code, message)
                (n,) = struct.unpack_from("=I", data, 8)
                raise WlError(data[12:12 + n - 1].decode(errors="replace"))
            if obj == registry and op == 0:       # wl_registry.global(name, interface, version)
                name, n = struct.unpack_from("=II", data)
                iface = data[8:8 + n - 1].decode(errors="replace")
                (ver,) = struct.unpack_from("=I", data, 8 + (n + 3) // 4 * 4)
                found.append((name, iface, ver))
            elif obj == cb and op == 0:
                return found

    def close(self):
        try: self.sock.close()
        except OSError: pass


class WlContext:
    """What must stay open while the program runs: closing `hangup` tells the compositor to stop listening."""
    def __init__(self, hangup, path):
        self.hangup, self.path = hangup, path

    def close(self):
        try: os.close(self.hangup)
        except OSError: pass
        try: os.unlink(self.path)
        except OSError: pass


def wl_supported(display):
    """Does the compositor at this socket offer wp_security_context_manager_v1? (Read-only: nothing is registered.)"""
    try: c = Wl(display)
    except OSError: return False
    try:
        reg = c.new_id()
        c.send(1, 1, struct.pack("=I", reg))      # wl_display.get_registry
        return any(g[1] == "wp_security_context_manager_v1" for g in c.roundtrip(reg))
    except (OSError, WlError, struct.error):
        return False
    finally:
        c.close()


def wayland_context(display, sock_path, app_id, instance):
    """Register a listening socket with a security context. The program connects to that socket instead of the
    compositor's own, and the compositor then treats it as a sandboxed client (no screen capture, no input injection...).
    Returns a WlContext, or None when the compositor doesn't offer the protocol (or something went wrong; a warning says so)."""
    try: c = Wl(display)
    except OSError as e:
        warn(f"can't reach the Wayland compositor: {e.strerror}"); return None
    srv, pipe, made = None, None, False
    try:
        reg = c.new_id()
        c.send(1, 1, struct.pack("=I", reg))
        found = next((g for g in c.roundtrip(reg) if g[1] == "wp_security_context_manager_v1"), None)
        if not found: return None
        mgr = c.new_id()
        c.send(reg, 0, struct.pack("=I", found[0]) + wl_string(found[1]) + struct.pack("=II", 1, mgr))   # wl_registry.bind
        os.makedirs(os.path.dirname(sock_path), mode=0o700, exist_ok=True)
        try: os.unlink(sock_path)
        except FileNotFoundError: pass
        srv = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        srv.bind(sock_path); made = True
        srv.listen(32)
        pipe = os.pipe()
        ctx = c.new_id()
        c.send(mgr, 1, struct.pack("=I", ctx), fds=[srv.fileno(), pipe[0]])    # create_listener(id, listen_fd, close_fd)
        c.send(ctx, 1, wl_string("org.sbx"))                                   # set_sandbox_engine
        c.send(ctx, 2, wl_string(app_id))                                      # set_app_id
        c.send(ctx, 3, wl_string(instance))                                    # set_instance_id
        c.send(ctx, 4)                                                         # commit
        c.roundtrip(reg)                                                       # a protocol error shows up here
        os.close(pipe[0])
        out = WlContext(pipe[1], sock_path)
        pipe = None
        return out
    except (OSError, WlError, struct.error) as e:
        warn(f"Wayland security context failed: {e}")
        if made:
            try: os.unlink(sock_path)
            except OSError: pass
        return None
    finally:
        if srv: srv.close()
        if pipe:
            for fd in pipe: os.close(fd)
        c.close()


# ---------------------------------------------------------------- portals
def portal_rules(cfg=None):
    on = lambda k: not cfg or cfg.get(k, True)          # a default-on switch: on unless the settings say 0
    rules = (["--talk=org.freedesktop.Notifications"] if on("portal_notification") else []) + [f"--see={PORTAL_NAME}"]
    extra = [i for k, i in PORTAL_EXTRA.items() if cfg and cfg.get(k)] + [i for k, i in PORTAL_DEFAULT_ON.items() if on(k)]
    if cfg and cfg.get("camera"): extra.append("Camera")          # the Camera portal follows the camera switch
    off = {i for k, v in PORTAL_TOGGLES.items() if not on(k) for i in v}
    basic = [i for i in PORTAL_BASIC if i not in off and not (i == "Account" and cfg and cfg.get("privacy"))]     # Account hands out the real name
    rules += [f"--call={PORTAL_NAME}=org.freedesktop.portal.{i}.*" for i in basic + extra]
    if on("portal_file_transfer"):
        rules += [f"--see={PORTAL_DOCS_NAME}", f"--call={PORTAL_DOCS_NAME}=org.freedesktop.portal.FileTransfer.*@{PORTAL_DOCS_PATH}"]
    rules += [f"--call={PORTAL_NAME}=org.freedesktop.portal.Request.*@/org/freedesktop/portal/desktop/request/*",
              f"--call={PORTAL_NAME}=org.freedesktop.portal.Session.*@/org/freedesktop/portal/desktop/session/*",   # screencast etc. sessions
              f"--call={PORTAL_NAME}=org.freedesktop.DBus.Properties.*@/org/freedesktop/portal/desktop",
              "--broadcast=org.freedesktop.portal.*=@/org/freedesktop/portal/*"]
    return rules


def portal_app_id(name):
    """The application id the desktop portals know this program by: org.sbx.Run.NAME, with anything outside letters, digits and _
    turned into _ and a p put in front of a digit (an id part may not start with one). The Documents portal keeps the files you picked
    for it under doc/by-app/ID."""
    part = re.sub(r"[^A-Za-z0-9_]", "_", name) or "_"
    return "org.sbx.Run." + ("p" + part if part[0].isdigit() else part)


def portal_export(paths, app):
    """{path: document id} for the files the Documents portal took, with read access for APP. {} when it can't (no PyGObject, no portal)."""
    try:
        from gi.repository import Gio, GLib
    except ImportError:
        return {}
    paths = sorted(set(paths))
    try:
        fds = [os.open(p, os.O_PATH | os.O_CLOEXEC) for p in paths]
        bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)
        reply, _ = bus.call_with_unix_fd_list_sync(
            PORTAL_DOCS_NAME, PORTAL_DOCS_PATH, PORTAL_DOCS_NAME, "AddFull",
            GLib.Variant("(ahusas)", (list(range(len(fds))), 1, app, ["read"])),    # 1: reuse a document that already exists
            GLib.VariantType("(asa{sv})"), Gio.DBusCallFlags.NONE, 3000, Gio.UnixFDList.new_from_array(fds), None)
        ids = reply.unpack()[0]
    except (OSError, GLib.Error):
        return {}
    return dict(zip(paths, ids)) if len(ids) == len(paths) else {}


def tray_rules():
    """Show a tray icon (StatusNotifierItem). Nothing else on the bus."""
    return ["--talk=org.kde.StatusNotifierWatcher"] + [
        f"--own=org.kde.StatusNotifierItem-{p}-{i}" for p in TRAY_PIDS for i in TRAY_IDS]


def mpris_rules():
    """Show up as a media player and answer media keys (MPRIS). Nothing else on the bus."""
    return ["--own=org.mpris.MediaPlayer2.*"]


# ---------------------------------------------------------------- GNOME Shell integration
# The browser's GNOME Shell connector (gnome-browser-connector, run by the browser inside the sandbox) talks to the Shell as org.gnome.Shell at
# /org/gnome/Shell, interface org.gnome.Shell.Extensions (not the org.gnome.Shell.Extensions name that gnome-extensions uses). The rules name that
# interface and path only: org.gnome.Shell, the interface of Eval, stays closed, and nothing is --talk. The host itself is a GApplication that registers
# as org.gnome.BrowserConnector on the session bus when it starts and exits at once if the bus refuses (the proxy answers ServiceUnknown), so that one
# name is --own: the program runs the connector itself, and no service outside the sandbox is reached.
GNOME_SHELL_OWN = "org.gnome.BrowserConnector"
GNOME_SHELL = "org.gnome.Shell"
GNOME_SHELL_PATH = "/org/gnome/Shell"
GNOME_SHELL_EXT = "org.gnome.Shell.Extensions"
GNOME_SHELL_CALLS = ("ListExtensions", "GetExtensionInfo", "GetExtensionErrors", "InstallRemoteExtension")     # InstallRemoteExtension: the Shell asks you before it installs
GNOME_SHELL_MANAGE = ("EnableExtension", "DisableExtension", "UninstallExtension")                             # gnome_shell_manage=1 adds these


def gnome_shell_rules(cfg=None):
    """Let the program list, inspect and (after your confirmation in the Shell) install GNOME Shell extensions, and read the Shell's version.
    gnome_shell_manage=1 adds enabling, disabling and uninstalling. Properties.Get and GetAll are read-only (no Set, so UserExtensionsEnabled can't
    be changed); the broadcasts are the signals the connector listens to. Nothing else of org.gnome.Shell is reachable; the connector's own name is the only one the program may own."""
    if not cfg or not cfg.get("gnome_shell"): return []
    p = GNOME_SHELL_PATH; props = "org.freedesktop.DBus.Properties"
    calls = GNOME_SHELL_CALLS + (GNOME_SHELL_MANAGE if cfg.get("gnome_shell_manage") else ())
    return ([f"--own={GNOME_SHELL_OWN}"] + [f"--call={GNOME_SHELL}={GNOME_SHELL_EXT}.{m}@{p}" for m in calls]
            + [f"--call={GNOME_SHELL}={props}.Get@{p}", f"--call={GNOME_SHELL}={props}.GetAll@{p}"]
            + [f"--broadcast={GNOME_SHELL}={GNOME_SHELL_EXT}.{s}@{p}" for s in ("ExtensionStateChanged", "ExtensionStatusChanged")]
            + [f"--broadcast={GNOME_SHELL}={props}.PropertiesChanged@{p}"])


# ---------------------------------------------------------------- KDE Plasma browser integration
# The browser's Plasma integration (plasma-browser-integration-host, run by the browser inside the sandbox) does four things on the session bus, and
# nothing here is --talk: (1) it owns org.kde.plasma.browser_integration, where KRunner finds its tab and history runners (/TabsRunner, /HistoryRunner;
# KRunner calls in, so no rule is needed for that) and, when that name is taken, the same name with -PID; (2) it owns org.mpris.MediaPlayer2.plasma-browser-integration
# (the same -PID fallback) for the media controls; (3) it shows downloads as progress jobs: KUiServerV2JobTracker calls org.kde.JobViewServer.requestView, which
# answers with an object path /org/kde/notificationmanager/jobs/JobView_N, then calls update and terminate on that object and listens to its
# cancel, suspend and resume signals; (4) with "inhibit suspend while downloading" on in the extension (off in Chrome by default) KInhibitionJobTracker calls
# Inhibit and UnInhibit on org.freedesktop.PowerManagement.Inhibit (Powerdevil; the portal is used only inside Flatpak or Snap, and sbx is neither).
# The host's other plugins stay closed: KDE Connect (it can run commands you saved), the Purpose share menu, and the old org.kde.kuiserver and JobViewV2.
KDE_NAMES = ("org.kde.plasma.browser_integration", "org.mpris.MediaPlayer2.plasma-browser-integration")
KDE_JOBS = "org.kde.JobViewServer"
KDE_JOB_PATH = "/org/kde/notificationmanager/jobs/*"
KDE_INHIBIT = "org.freedesktop.PowerManagement.Inhibit"
KDE_INHIBIT_PATH = "/org/freedesktop/PowerManagement/Inhibit"


def kde_rules(cfg=None):
    """Let the browser's Plasma integration show downloads as jobs in Plasma, answer KRunner and the media controls, and keep the computer awake
    while it downloads. Per-method rules and the host's own names only: org.kde.JobViewServer is never --talk, and the object paths are the ones Plasma hands out."""
    if not cfg or not cfg.get("kde"): return []
    own = [f"--own={n}{s}" for n in KDE_NAMES for s in [""] + [f"-{p}" for p in TRAY_PIDS]]
    jobs = [f"--call={KDE_JOBS}=org.kde.JobViewServerV2.requestView@/JobViewServer"]
    jobs += [f"--call={KDE_JOBS}=org.kde.JobViewV3.{m}@{KDE_JOB_PATH}" for m in ("update", "terminate")]
    jobs += [f"--broadcast={KDE_JOBS}=org.kde.JobViewV3.{s}@{KDE_JOB_PATH}" for s in ("updateRequested", "suspendRequested", "resumeRequested", "cancelRequested")]
    return own + jobs + [f"--call={KDE_INHIBIT}={KDE_INHIBIT}.{m}@{KDE_INHIBIT_PATH}" for m in ("Inhibit", "UnInhibit")]


# ---------------------------------------------------------------- extra session-bus names (talk=)
TALK_RE = re.compile(r"[A-Za-z][A-Za-z0-9_-]*(\.[A-Za-z0-9_-]+)*(\.\*)?")     # no empty parts: "org..x" is not a name


def talk_ok(n):
    """A plain D-Bus name, or NAME.* with three parts before the .*: 'org.*' and 'org.freedesktop.*' would reach secrets, systemd and more."""
    return bool(TALK_RE.fullmatch(n)) and (not n.endswith(".*") or n.count(".") >= 3)


def talk_rules(cfg):
    return [f"--talk={n}" for n in cfg["talk"] if talk_ok(n)]


# Every switch that opens the session-bus proxy, with the function that gives its rules. A new integration is one line here: bus_rules() and the
# check that starts the proxy (70_build.py) both read this list, so the switch can't be added without the proxy starting for it.
BUS_INTEGRATIONS = (("tray", lambda cfg: tray_rules()), ("mpris", lambda cfg: mpris_rules()), ("gnome_shell", gnome_shell_rules), ("kde", kde_rules))


def bus_rules(cfg=None):
    """What the proxy lets through: the portal rules when portals is on (also when nothing is said), plus the rules of each integration that is on."""
    rules = portal_rules(cfg) if cfg is None or cfg.get("portals") else []
    for key, fn in BUS_INTEGRATIONS:
        if cfg and cfg.get(key): rules = rules + fn(cfg)
    if cfg and cfg.get("talk"): rules = rules + talk_rules(cfg)      # a list, not a switch, so it is not in BUS_INTEGRATIONS
    return rules


# ---------------------------------------------------------------- accessibility bus
# Screen readers (Orca) don't read the screen: each program publishes its widgets on the accessibility bus, a second D-Bus apart from the
# session bus, and the reader reads them there. The program gets a filtered copy of that bus (a11y=1) with the rules Flatpak uses.
A11Y_REGISTRY = "org.a11y.atspi.Registry"
A11Y_ROOT = "/org/a11y/atspi/accessible/root"
A11Y_REG_PATH = "/org/a11y/atspi/registry"
A11Y_DEC_PATH = "/org/a11y/atspi/registry/deviceeventcontroller"


def a11y_rules():
    """What the accessibility proxy lets through. The program may plug its widgets into the registry (Socket.Embed), ask who listens for events
    and keys, and hear that a reader started or stopped listening. There is no --talk, so it can't call anything else: not the other programs'
    widgets, and not GenerateKeyboardEvent or the other calls that send keys and clicks. --sloppy-names: the peers on this bus use unique names."""
    r = A11Y_REGISTRY
    return ["--sloppy-names",
            f"--call={r}=org.a11y.atspi.Socket.Embed@{A11Y_ROOT}",
            f"--call={r}=org.a11y.atspi.Socket.Unembed@{A11Y_ROOT}",
            f"--call={r}=org.a11y.atspi.Registry.GetRegisteredEvents@{A11Y_REG_PATH}",
            f"--call={r}=org.a11y.atspi.DeviceEventController.GetKeystrokeListeners@{A11Y_DEC_PATH}",
            f"--call={r}=org.a11y.atspi.DeviceEventController.GetDeviceEventListeners@{A11Y_DEC_PATH}",
            f"--call={r}=org.a11y.atspi.DeviceEventController.NotifyListenersSync@{A11Y_DEC_PATH}",
            f"--call={r}=org.a11y.atspi.DeviceEventController.NotifyListenersAsync@{A11Y_DEC_PATH}",
            f"--broadcast={r}=org.a11y.atspi.Registry.EventListenerRegistered@{A11Y_REG_PATH}",      # so the program emits only what a reader asked for
            f"--broadcast={r}=org.a11y.atspi.Registry.EventListenerDeregistered@{A11Y_REG_PATH}"]


def a11y_bus_address():
    """Where your accessibility bus is: $AT_SPI_BUS_ADDRESS if it is set, else what org.a11y.Bus says (asking also starts the bus, which a
    session only starts when something needs it), else the socket in your runtime folder. None when there is none."""
    addr = os.environ.get("AT_SPI_BUS_ADDRESS", "")
    if addr.startswith("unix:"): return addr
    ask = (("gdbus", ["gdbus", "call", "--session", "--dest", "org.a11y.Bus", "--object-path", "/org/a11y/bus", "--method", "org.a11y.Bus.GetAddress"]),
           ("busctl", ["busctl", "--user", "call", "org.a11y.Bus", "/org/a11y/bus", "org.a11y.Bus", "GetAddress"]))
    for tool, cmd in ask:
        if not shutil.which(tool): continue
        try: r = subprocess.run(cmd, stdin=subprocess.DEVNULL, capture_output=True, text=True, timeout=5)
        except (OSError, subprocess.SubprocessError): continue
        m = re.search(r"unix:[^'\"\s)]+", r.stdout) if r.returncode == 0 else None
        if m: return m.group(0)
    socks = sorted(glob.glob(f"{runtime_dir()}/at-spi/bus_*"))
    return f"unix:path={socks[0]}" if socks else None


def start_filter_proxy(px, addr, sock, rules, what, where):
    """Run xdg-dbus-proxy PX on the bus at ADDR with RULES, listening on SOCK. Returns (process, pipe) or None (a warning says why)."""
    os.makedirs(os.path.dirname(sock), mode=0o700, exist_ok=True)
    r, w = os.pipe()
    try:
        proc = subprocess.Popen([px, f"--fd={w}", addr, sock, "--filter"] + rules, pass_fds=[w],
                                stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except OSError as e:
        os.close(r); os.close(w)
        stop_proxy(None, sock)
        warn(f"could not start xdg-dbus-proxy ({e}); running without {what}")
        return None
    os.close(w)
    ok = False
    try: ok = bool(select.select([r], [], [], 3)[0]) and bool(os.read(r, 1))
    except OSError: pass
    if ok: return proc, r
    stop_proxy((proc, r), sock)
    warn(f"could not start xdg-dbus-proxy on {where}; running without {what}")
    return None


def start_a11y_proxy(sock):
    """Start xdg-dbus-proxy on your accessibility bus with the a11y rules, listening on SOCK. Returns (process, pipe) or None (a warning says why)."""
    px = shutil.which("xdg-dbus-proxy")
    if not px:
        warn(f"xdg-dbus-proxy missing, so a11y is off: {install_hint('xdg-dbus-proxy')}")
        return None
    addr = a11y_bus_address()
    if not addr:
        warn("a11y=1, but your accessibility bus was not found (is at-spi2-core installed and a desktop session running?); running without it")
        return None
    return start_filter_proxy(px, addr, sock, a11y_rules(), "a11y", "the accessibility bus")


# ---------------------------------------------------------------- system bus (bluetooth, battery, avahi)
# Services that run for the whole computer: each switch opens one fixed name, and there is no free-form list on purpose.
SYSTEM_BUS_SOCKET = "/run/dbus/system_bus_socket"
SYSTEM_BUS_NAMES = {"bluetooth": "org.bluez", "battery": "org.freedesktop.UPower", "avahi": "org.freedesktop.Avahi"}


def system_bus_address():
    """$DBUS_SYSTEM_BUS_ADDRESS if it is a unix address, else the standard socket if it exists, else None."""
    addr = os.environ.get("DBUS_SYSTEM_BUS_ADDRESS", "")
    if addr.startswith("unix:"): return addr
    return f"unix:path={SYSTEM_BUS_SOCKET}" if os.path.exists(SYSTEM_BUS_SOCKET) else None


def system_bus_rules(cfg):
    return [f"--talk={n}" for k, n in SYSTEM_BUS_NAMES.items() if cfg.get(k)]


def start_system_proxy(sock, cfg):
    """Start xdg-dbus-proxy on the system bus with one --talk for each switch that is on, listening on SOCK. Returns (process, pipe) or None."""
    px = shutil.which("xdg-dbus-proxy")
    if not px:
        warn(f"xdg-dbus-proxy missing, so Bluetooth, battery and Avahi are off: {install_hint('xdg-dbus-proxy')}")
        return None
    addr = system_bus_address()
    if not addr:
        warn("a system bus switch is on, but the system bus was not found; running without it")
        return None
    return start_filter_proxy(px, addr, sock, system_bus_rules(cfg), "the system bus switches", "the system bus")


PROXY_ROOT_SKIP = ("proc", "dev", "sys", "home", "root", "mnt", "media", "srv", "boot", "lost+found")


def top_binds(skip=()):
    """One read-only bind for each top-level folder of this computer (links stay links), for the proxy's small root.
    The new root is then a filesystem a file can be added to, such as /.flatpak-info: bwrap can't make a file on a read-only /."""
    a = []
    try: top = sorted(os.listdir("/"))
    except OSError: top = []
    for e in top:
        p = "/" + e
        if e in skip: continue
        if os.path.islink(p): a += ["--symlink", os.readlink(p), p]
        elif os.path.isdir(p): a += ["--ro-bind", p, p]
    return a


def app_info_text(app, instance=0):
    """The .flatpak-info the portal reads from the proxy. It wants an [Instance] group too, or it refuses every call."""
    return f"[Application]\nname={app}\n\n[Instance]\ninstance-id={instance}\n"


def proxy_sandbox(info, rt):
    """bwrap arguments for a small root to run xdg-dbus-proxy in: the system read-only, your runtime folder read-write (the bus is there,
    and the proxy makes its own socket there), your home and other private folders not at all, and the program's .flatpak-info at
    /.flatpak-info. xdg-desktop-portal reads that file from the process that talks to it, which is the proxy, so it knows the program as an
    app of its own and the file chooser hands out files through the document portal, not as real paths the sandbox can't see."""
    a = ["bwrap", "--die-with-parent", "--new-session", "--clearenv", "--unshare-ipc", "--unshare-uts", "--unshare-cgroup-try",
         "--proc", "/proc", "--dev", "/dev"]
    return a + top_binds(PROXY_ROOT_SKIP) + ["--bind", rt, rt, "--ro-bind", info, "/.flatpak-info"]


def write_app_info(path, app):
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC | os.O_NOFOLLOW, 0o600)
    with os.fdopen(fd, "w") as f: f.write(app_info_text(app, os.getpid()))


def start_proxy(sock, cfg=None, app=None):
    """Start xdg-dbus-proxy with the portal and tray rules. Returns (process, pipe) or None (a warning says why).
    With APP (an application id) the proxy runs in a small sandbox that tells the portals which app it is; if that fails it runs plainly."""
    px = shutil.which("xdg-dbus-proxy")
    if not px:
        warn(f"xdg-dbus-proxy missing, so portals and the tray are off: {install_hint('xdg-dbus-proxy')}")
        return None
    addr = os.environ.get("DBUS_SESSION_BUS_ADDRESS") or f"unix:path={runtime_dir()}/bus"
    os.makedirs(os.path.dirname(sock), mode=0o700, exist_ok=True)
    info = sock + ".info"
    for wrapped in ((True, False) if app and shutil.which("bwrap") else (False,)):
        cmd = [px, "--fd=%d", addr, sock, "--filter"] + bus_rules(cfg)
        if wrapped:
            try: write_app_info(info, app)
            except OSError: continue
        r, w = os.pipe()
        cmd[1] = f"--fd={w}"
        if wrapped: cmd = proxy_sandbox(info, runtime_dir()) + cmd
        try:
            proc = subprocess.Popen(cmd, pass_fds=[w], stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except OSError as e:
            os.close(r); os.close(w)
            stop_proxy(None, sock)
            if wrapped: continue
            warn(f"could not start xdg-dbus-proxy ({e}); running without portals or tray")
            return None
        os.close(w)
        ok = False
        try: ok = bool(select.select([r], [], [], 3)[0]) and bool(os.read(r, 1))
        except OSError: pass
        if ok: return proc, r
        stop_proxy((proc, r), sock)
        if wrapped: warn("the portal proxy could not start as an app of its own; the file chooser may give paths the program can't see")
    stop_proxy(None, sock)
    warn("could not start xdg-dbus-proxy; running without portals or tray")
    return None


def stop_proxy(px, sock):
    if px:
        try: os.close(px[1])
        except OSError: pass
        try:
            px[0].terminate()
            try: px[0].wait(2)
            except subprocess.TimeoutExpired: px[0].kill(); px[0].wait(2)       # a stuck proxy must not outlive us
        except (OSError, subprocess.SubprocessError): pass
    for p in (sock, sock + ".info"):
        try: os.unlink(p)
        except OSError: pass


# ---------------------------------------------------------------- settings
def parse_bool(v):
    v = v.strip().lower()
    return True if v in ("1", "true", "yes", "on") else False if v in ("0", "false", "no", "off") else None


def env_name_ok(k):
    return bool(re.fullmatch(r"[A-Za-z_][A-Za-z0-9_]*", k))


def args_ok(v):
    try: shlex.split(v)
    except ValueError: return False
    return True


def syscall_ok(n):
    return n == "io_uring" or n in EXTRA_SYSCALLS


def parse_conf(path):
    """Plain key=value file. Returns (switches, lists, limits). '#' starts a comment. A line that makes no sense is
    reported and skipped, so a typo like net=maybe doesn't silently mean something else."""
    sc, ls, lim = {}, {k: [] for k in LISTS}, {}
    try:
        with open(path, errors="replace") as f: lines = f.read().splitlines()      # a stray byte must not crash sbx
    except OSError:
        return sc, ls, lim
    for n, line in enumerate(lines, 1):
        line = re.sub(r"(^|\s)#.*$", "", line).strip()
        if not line: continue
        at = f"{path}:{n}"
        if "=" not in line:
            warn(f"{at}: ignoring this line: expected key=value"); continue      # 'net 0' must not quietly leave the network on
        k, _, v = (x.strip() for x in line.partition("="))
        if k in ls:
            if k == "env" and not env_name_ok(v): warn(f"{at}: '{v}' is not a variable name, ignored")
            elif k == "setenv" and ("=" not in v or not env_name_ok(v.partition("=")[0])): warn(f"{at}: setenv needs NAME=value, ignored")
            elif k == "allow_syscall" and not syscall_ok(v): warn(f"{at}: can't allow '{v}': not one of {', '.join(sorted(EXTRA_SYSCALLS))}, io_uring")
            elif not v: warn(f"{at}: {k} has no value, ignored")
            elif k == "talk" and not talk_ok(v): warn(f"{at}: '{v}' is not a usable D-Bus name (a wildcard needs three parts first, like org.example.App.*), ignored")
            else: ls[k].append(v)
        elif k in SCALARS:
            b = parse_bool(v)
            if b is None: warn(f"{at}: {k}={v} is not 0 or 1, ignored")
            else: sc[k] = b
        elif k in LIMITS:
            if k == "args" and not args_ok(v): warn(f"{at}: args has an unclosed quote, ignored")
            elif v == "" or re.fullmatch(LIMITS[k], v): lim[k] = v
            else: warn(f"{at}: {k}={v} is not a valid limit, ignored")
        else:
            warn(f"{at}: ignoring unknown setting '{k}'")
    return sc, ls, lim


def load_conf(name, ignore=False):
    """Built-in defaults < default.conf < apps/NAME.conf. Lists add up. Returns (settings, where each value came from)."""
    cfg = {**SCALARS, **{k: "" for k in LIMITS}, **{k: [] for k in LISTS}}
    cfg["share_dirs"] = SHARE_DEFAULT
    src = {k: "default" for k in cfg}
    if ignore: return cfg, src
    for label, path in (("default.conf", f"{CONF}/default.conf"), (f"apps/{name}.conf", f"{CONF}/apps/{name}.conf")):
        sc, ls, lim = parse_conf(path)
        for k, v in {**sc, **lim}.items(): cfg[k], src[k] = v, label
        for k in LISTS:
            for v in ls[k]:
                if v not in cfg[k]: cfg[k].append(v); src[(k, v)] = label
    return cfg, src


def effective(name, o):
    """The settings for one program: files, then command-line flags on top."""
    cfg, src = load_conf(name, o.get("ignore_config"))
    for k in list(SCALARS) + list(LIMITS):
        if k in o: cfg[k], src[k] = o[k], "flag"
    for k in ("env", "setenv", "allow_syscall", "talk"):
        for v in o.get(k, []):
            if v not in cfg[k]: cfg[k].append(v); src[(k, v)] = "flag"
    return cfg, src


# ---------------------------------------------------------------- shared paths
def sensitive_match(q):
    """The secret folder (as ~/...) that this path is, is inside, or contains; None if it is none of those."""
    for rel in SENSITIVE:
        s = f"{HOME}/{rel}"
        if q == s or q.startswith(s + "/") or s.startswith(q + "/"): return "~/" + rel
    return None


def share_path(p, cli, allow_sensitive=False):
    """A file or folder to share: inside your home (not the whole home), on a drive, or in /tmp. None if it can't be."""
    q = os.path.expanduser(p)
    if not cli and not os.path.isabs(q):
        warn(f"skipping '{p}': use a full path or ~/...")
        return None
    q = os.path.realpath(q)
    guarded = [os.path.realpath(x) for x in (CONF, HOMES)]       # the sandbox must not be able to rewrite its own rules
    hit = None if allow_sensitive else sensitive_match(q)
    why = ("doesn't exist" if not os.path.exists(q) else "is your whole home" if q == HOME else
           "would expose sbx's own settings or private homes"
           if any(q == g or q.startswith(g + "/") or g.startswith(q + "/") for g in guarded) else
           f"is or contains {hit}, which holds secrets (use --allow-sensitive or allow_sensitive=1 if you mean it)" if hit else
           None if q.startswith((HOME + "/",) + OUTSIDE) else
           "is outside your home, /mnt, /media and /tmp")
    if not why: return q
    if cli: die(f"'{p}' {why}")
    warn(f"skipping '{p}': it {why}")
    return None


def order_shares(rw, ro, here=None, program=None):
    """[(path, 'rw' | 'ro')] in mount order. A folder is mounted before the paths inside it, so a more specific share
    keeps its own mode whatever order the settings were written in. At the very same path read-only wins, except that the
    program's own app folder (program), which sbx adds by itself and shares read-only, gives way to a read-and-write
    share you asked for (whitelist= / --whitelist) at that path."""
    modes = {}
    for p in ([here] if here else []) + rw: modes.setdefault(p, "rw")
    for p in ro: modes[p] = "ro"
    if program and program not in rw: modes[program] = "ro"
    return sorted(modes.items(), key=lambda kv: (kv[0].count("/"), kv[0]))


def program_share(real):
    """What a program in your home brings along: its app folder for .../APP/bin/tool (at least two levels below home,
    so ~/bin, ~/.local/bin and ~/.cargo/bin stay closed), otherwise just the file."""
    d = os.path.dirname(real)
    if os.path.basename(d) == "bin":
        root = os.path.dirname(d)
        if root.startswith(HOME + "/") and "/" in root[len(HOME) + 1:]: return root
    return real


def share_dir(d):
    """The current folder for --here: a folder inside your home, on a drive, or in /tmp, never the whole home."""
    d = os.path.realpath(d)
    if d == HOME: die("--here: refusing to share your whole home; go into a subfolder first")
    if d.startswith(HOME + "/"):
        if d[len(HOME) + 1:].split("/")[0].startswith("."): die("--here: hidden folders in your home can't be shared")
        return d
    if d.startswith(OUTSIDE): return d
    die("--here: only folders inside your home, on /mnt, /media or in /tmp can be shared")


def hint_args(args, here, shared):
    """Warn about arguments that name something on your side the program won't find. Only a hint; nothing changes."""
    said = 0
    for x in args[:64]:
        v = x.split("=", 1)[1] if x.startswith("--") and "=" in x else x
        if not v or v.startswith("-") or len(v) > 1024 or "\n" in v: continue
        host = os.path.abspath(v)
        if not os.path.lexists(host): continue
        inside = lambda base: host == base or host.startswith(base + "/")
        if not os.path.isabs(v):
            if here and inside(here): continue
            why = "the program starts in its private home"
        else:
            if any(inside(s) for s in shared): continue
            if not (inside(HOME) or any(inside(d) for d in ("/tmp", "/run", "/mnt", "/media", "/srv", "/var/tmp", "/root", "/home"))): continue
            why = "that place is not shared"
        warn(f"'{v}' exists here, but the program won't find it ({why}). Use --here, or --whitelist=PATH / --read-only=PATH.")
        said += 1
        if said == 3: break


def portal_file_args(args, app, shared, export=portal_export):
    """ARGS with each file you started the program with (a full path or file:// URI) swapped for its read-only path in the Documents portal,
    so "Open with" works without sharing the folder. Files in a shared folder, secret folders and sbx's own folders stay as they are."""
    guarded = [os.path.realpath(x) for x in (CONF, HOMES)]
    found = {}
    for i, x in enumerate(args[:64]):
        uri = x.startswith("file://")
        q = urllib.parse.unquote(x[7:]) if uri else x
        if not q.startswith("/") or "\n" in q or len(q) > 1024: continue
        q = os.path.realpath(q)
        if not os.path.isfile(q) or any(q.startswith(s + "/") or q == s for s in shared + guarded): continue
        if q.startswith((HOME + "/",) + OUTSIDE) and not sensitive_match(q): found[i] = (q, uri)
    ids = export([q for q, _ in found.values()], app) if found else {}
    out = list(args)
    for i, (q, uri) in found.items():
        if q in ids:
            p = f"{runtime_dir()}/doc/{ids[q]}/{os.path.basename(q)}"
            out[i] = "file://" + urllib.parse.quote(p) if uri else p
    return out


def generic_folders():
    """Folders that hold all sorts of things (Downloads, Desktop...), never shared as a program's own folder."""
    out = {HOME}
    for n in ("Downloads", "Desktop", "Documents", "Pictures", "Music", "Videos", "Public", "Templates"): out.add(f"{HOME}/{n}")
    try:
        with open(f"{os.environ.get('XDG_CONFIG_HOME') or HOME + '/.config'}/user-dirs.dirs") as f:       # translated names
            for m in re.finditer(r'^XDG_\w+_DIR="(?:\$HOME|' + re.escape(HOME) + r')/?([^"]*)"', f.read(), re.M): out.add(f"{HOME}/{m[1]}".rstrip("/"))
    except OSError:
        pass
    return out


def own_folder(real):
    """(folder, why not): the folder a program file sits in, which a program may be started in (its game data, saves, files it
    makes in the current folder), or (None, reason) when that folder is your home, a hidden folder, a general-purpose one
    like Downloads, or not one sbx shares."""
    d = os.path.dirname(real)
    if any(d == g + "/sbx" or d.startswith(g + "/sbx/") for g in generic_folders() - {HOME}):
        return None, f"{tilde(d)} is a per-program shared folder (share_dirs)"
    if d in generic_folders(): return None, f"{tilde(d)} holds all sorts of things (your home, Downloads, Desktop...)"
    if d.startswith(HOME + "/"):
        if d[len(HOME) + 1:].split("/")[0].startswith("."): return None, f"{tilde(d)} is a hidden folder"
        return d, None
    if d.startswith("/tmp/"): return d, None
    return None, f"{d} is not inside your home or /tmp"


def folder_named_like(name, folder):
    """True if the folder's name starts with the program's name, ignoring case and punctuation: G-Diffuser-v1.2.3-linux-x64 is
    G-Diffuser's. The name must be at least 3 letters or digits and the next character in the folder name must not be a letter
    (game is not Games, p is not Projects). A convenience for the folder=auto default, not a security check; own_folder() decides
    what may be shared at all."""
    n = re.sub(r"[^a-z0-9]", "", name.lower())
    if len(n) < 3: return False
    pat = r"[^a-z0-9]*".join(map(re.escape, n)) + r"(?![a-z])"
    return re.match(r"[^a-z0-9]*" + pat, os.path.basename(folder).lower()) is not None


def opener_folder(real):
    """The folder a program brings along when you open it with sbx (its game data, saves...): the folder it sits in,
    unless that is your home, a hidden folder or a general-purpose one like Downloads. None then."""
    return own_folder(real)[0]


APPS = f"{HOME}/Apps"                # where `sbx install` puts programs: one folder each, named after the program
INSTALLED = f"{CONF}/installed"      # one file per installed program (installed/NAME): the full path of its launcher, on the first line


def installed_launcher(name):
    """The launcher file that `sbx install` recorded for NAME, or None. It has no execute bit; sbx sets it for the run."""
    if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._-]*", name): return None
    try:
        with open(f"{INSTALLED}/{name}") as f: p = f.readline().strip()
    except OSError:
        return None
    return p if p.startswith("/") and os.path.isfile(p) else None


# ---------------------------------------------------------------- what a name belongs to
# origins/NAME: line 1 the real path the name was first run from, line 2 "size mtime_ns sha256" of that file (absent in files from
# older versions), line 3 "from PATH" after the name moved (so sbx-gui can say so). pending/NAME: old=, new=, rule= (c or d), reason=.
ORIGIN_META = re.compile(r"(\d+) (\d+) ([0-9a-f]{64})")
SOURCE_RANK = {"System": 0, "Downloaded": 2}      # the order of `sbx list --all` for programs only run from the terminal; anything else sorts between


def fingerprint(path):
    """(size, mtime in ns, SHA-256 of the whole file as hex) or None when the file isn't there. The hex is None for a file that can't be
    read. The file is stat'ed before it is read, so one that changes meanwhile shows a newer mtime next time and is hashed again."""
    try: st = os.stat(path)
    except OSError: return None
    h = hashlib.sha256()
    try:
        with open(path, "rb") as f:
            for chunk in iter(lambda: f.read(1 << 20), b""): h.update(chunk)
    except OSError:
        return st.st_size, st.st_mtime_ns, None
    return st.st_size, st.st_mtime_ns, h.hexdigest()


def read_origin(name):
    """(path, (size, mtime_ns, sha256) or None, moved-from path or None) from origins/NAME, or None when nothing is recorded."""
    try:
        with open(f"{CONF}/origins/{name}") as f: lines = f.read().split("\n")
    except OSError:
        return None
    path = lines[0].strip()
    if not path: return None
    m = ORIGIN_META.fullmatch(lines[1].strip()) if len(lines) > 1 else None
    moved = lines[2][5:].strip() if len(lines) > 2 and lines[2].startswith("from ") else None
    return path, ((int(m[1]), int(m[2]), m[3]) if m else None), moved or None


def replace_file(path, text):
    """Write TEXT to PATH all at once. The helper file is made for this write alone (a hidden name, so no listing takes it for a record):
    two sbx starting the same program together must not share one, or the second rename finds nothing to rename."""
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(path), prefix=f".{os.path.basename(path)}.", suffix=".tmp")
    try:
        with os.fdopen(fd, "w") as f: f.write(text)
        os.replace(tmp, path)
    except BaseException:
        try: os.unlink(tmp)
        except OSError: pass
        raise


def write_origin(name, path, fp=None, moved=None):
    """Record PATH (with its fingerprint FP, when there is one, and where it moved MOVED from) as what NAME belongs to."""
    p = f"{CONF}/origins/{name}"
    os.makedirs(os.path.dirname(p), exist_ok=True)
    lines = [path]
    if (fp and fp[2]) or moved: lines.append(f"{fp[0]} {fp[1]} {fp[2]}" if fp and fp[2] else "")
    if moved: lines.append(f"from {moved}")
    replace_file(p, "\n".join(lines) + "\n")


def user_dir(key):
    """One of your folders by its XDG name (DOWNLOAD, DOCUMENTS...): the line in user-dirs.dirs (translated names), a path inside your
    home; None when the file has no such line, or it points at the home itself or outside it."""
    try:
        with open(f"{os.environ.get('XDG_CONFIG_HOME') or HOME + '/.config'}/user-dirs.dirs") as f:
            m = re.search(r'^XDG_' + key + r'_DIR="(?:\$HOME|' + re.escape(HOME) + r')/?([^"]*)"', f.read(), re.M)
    except OSError:
        return None
    p = os.path.normpath(f"{HOME}/{m[1]}") if m and m[1] else None
    return p if p and p.startswith(HOME + "/") else None


def downloads_dir():
    """Your Downloads folder: XDG_DOWNLOAD_DIR in user-dirs.dirs (translated names), else ~/Downloads."""
    return user_dir("DOWNLOAD") or f"{HOME}/Downloads"


def source_kind(path):
    """System (/usr, /opt, /snap...), Downloaded (inside your Downloads folder), Home (the rest of your home) or Other."""
    if path.startswith(SYSTEM_PROGRAMS): return "System"
    if path.startswith(downloads_dir() + "/"): return "Downloaded"
    return "Home" if path.startswith(HOME + "/") else "Other"


def origin_source(name):
    """Where NAME's program comes from, as recorded: {kind, path, missing, moved, moved_exists}, or None when nothing is recorded."""
    rec = read_origin(name)
    if not rec: return None
    path, _meta, moved = rec
    return {"kind": source_kind(path), "path": path, "missing": not os.path.isfile(path), "moved": moved,
            "moved_exists": bool(moved and os.path.isfile(moved))}


def source_text(s):
    """One line for a source: 'System: /usr/bin', 'Downloaded: ~/Downloads/Crash', 'Missing: ~/old/path', plus 'moved from ...'."""
    text = (f"Missing: {tilde(s['path'])}" if s["missing"] else f"System: {os.path.dirname(s['path'])}" if s["kind"] == "System"
            else f"{s['kind']}: {tilde(s['path'])}")
    return text + (f", {'copied' if s['moved_exists'] else 'moved'} from {tilde(s['moved'])}" if s["moved"] else "")


UNUSED_BYTES = 64 * 1024        # a private home with no more than this in files, and nobody having set the program up, counts as unused


def home_is_small(name, limit=UNUSED_BYTES):
    """True if the private home holds at most LIMIT bytes in files (links are not followed; a folder that can't be read counts as not small)."""
    total, unreadable = 0, []
    for d, _dirs, files in os.walk(f"{HOMES}/{name}", onerror=unreadable.append):
        for f in files:
            try: total += os.lstat(f"{d}/{f}").st_size
            except OSError: unreadable.append(f)
            if total > limit or unreadable: return False
    return not unreadable



# ---------------------------------------------------------------- a renamed file is still the same program
def origin_records():
    """{name: (path, meta, moved)} for everything recorded in origins/."""
    try: names = os.listdir(f"{CONF}/origins")
    except OSError: return {}
    recs = {}
    for n in names:
        rec = re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._-]*", n) and not n.endswith(".tmp") and read_origin(n)
        if rec: recs[n] = rec
    return recs


def home_has_data(name):
    """True if NAME's private home is a link or holds more than a run leaves behind (see UNUSED_BYTES)."""
    home = f"{HOMES}/{name}"
    return os.path.islink(home) or (os.path.isdir(home) and not home_is_small(name))


def set_up_among(names):
    """The one of NAMES that somebody set up: the only one with settings (apps/NAME.conf), else the only one whose private home holds data
    (earlier runs under a wrong name leave records and nearly empty homes behind). None when none stands out, or two do."""
    for tier in ([n for n in names if os.path.exists(f"{CONF}/apps/{n}.conf")], [n for n in names if home_has_data(n)]):
        if tier: return tier[0] if len(tier) == 1 else None
    return None


def file_owner(name, real):
    """(program name, the file it had before or None, a reason it was not taken or None) for the file REAL that would run as NAME (its file name).
    Looked up by content FIRST, before NAME is considered: a file that is a recorded program's renamed file keeps that program's name.
      - a record that already followed this very file here (moved or renamed by an earlier run) wins;
      - else the file has the size and SHA-256 of exactly one recorded program whose file is gone: that name. Only a file of a size
        that such a program had is read. A copy (the original is still there) is not a rename and stays a program of its own.
    Leftovers under NAME from earlier runs of this same file (an origin record, a private home, however big: a game that ran once has written
    logs and caches there) don't matter; the homes stay and are named. NAME stays only when somebody gave it settings of its own
    (apps/NAME.conf) and it is not another existing program's name: then nothing is mixed up, and the reason says how to join them."""
    try: st = os.stat(real)
    except OSError: return name, None, None
    if real.startswith(SYSTEM_PROGRAMS): return name, None, None
    recs = origin_records()
    here = [n for n, r in recs.items() if r[0] == real and r[2]]
    if len(here) == 1: return here[0], None, None
    gone = {n: r[1][2] for n, r in recs.items() if r[1] and r[1][0] == st.st_size and not os.path.isfile(r[0])}
    if not gone: return name, None, None                          # nothing of this size to compare with: the file is not read
    sha = (fingerprint(real) or (0, 0, None))[2]
    same = sorted(n for n, s in gone.items() if sha and s == sha)
    if not same: return name, None, None
    owner = same[0] if len(same) == 1 else set_up_among(same)
    if owner is None:
        if name in same and not any(home_has_data(n) or os.path.exists(f"{CONF}/apps/{n}.conf") for n in same): return name, None, None
        return name, None, f"'{os.path.basename(real)}' has the content of several programs whose file is gone ({', '.join(same)}) and sbx can't tell which one you set up. --name=ONE picks"
    if owner == name: return name, None, None
    if os.path.exists(f"{CONF}/apps/{name}.conf") and not (recs.get(name) and recs[name][0] != real and os.path.isfile(recs[name][0])):
        return name, None, f"'{name}' already has settings of its own, so '{os.path.basename(real)}' stays '{name}', although it is '{owner}' renamed. --name={owner} runs it as that"
    return owner, recs[owner][0], None


def took_over(name, owner, real, old):
    """REAL runs as OWNER, not as NAME: say so in one line, and drop NAME's record of this same file (a second claim on it). A private home
    NAME got meanwhile is not touched: it may hold something, and it is named in that line so you can delete it. The same goes for other
    records of this same content whose file is gone and that nobody set up (runs under wrong names): their records go, their homes stay."""
    recs = origin_records()
    sha = (recs.get(owner) or (None, None))[1]
    sha = sha[2] if sha else None
    dupes = [n for n, r in recs.items() if n != owner and n != name and sha and r[1] and r[1][2] == sha and not os.path.isfile(r[0])
             and not os.path.exists(f"{CONF}/apps/{n}.conf")]
    rec = recs.get(name)
    for n in dupes + ([name] if rec and rec[0] == real else []):
        try: os.unlink(f"{CONF}/origins/{n}")
        except OSError: pass
    left = [f"{HOMES}/{n}" for n in [name] + dupes if os.path.lexists(f"{HOMES}/{n}")]
    warn(f"'{os.path.basename(real)}' is '{owner}' renamed (same size and SHA-256 as {tilde(old)}): it uses the settings and private home of '{owner}'"
         + (f". Left over from running it under other names: {', '.join(tilde(h) for h in left)}; delete with: sbx clean NAME" if left else ""))


# ---------------------------------------------------------------- decisions waiting for you
def pending_path(name):
    return f"{CONF}/pending/{name}"


def read_pending(name):
    """{old, new, rule, reason} from pending/NAME, or None."""
    try:
        with open(pending_path(name)) as f: text = f.read()
    except OSError:
        return None
    d = {}
    for line in text.split("\n"):
        k, eq, v = line.partition("=")
        if eq and k in ("old", "new", "rule", "reason"): d[k] = v
    return d if d.get("old") and d.get("new") and d.get("rule") in ("c", "d") else None


def write_pending(name, old, new, rule, reason):
    p = pending_path(name)
    os.makedirs(os.path.dirname(p), exist_ok=True)
    replace_file(p, f"old={old}\nnew={new}\nrule={rule}\nreason={reason}\n")


def clear_pending(name):
    try: os.unlink(pending_path(name))
    except OSError: pass


def pending_stale(name, p):
    """Why the decision P no longer applies, or None while it does: it describes what is recorded (the recorded path is still its old
    one), the new file is still there, and the old file is gone for rule c / still there for rule d."""
    rec = read_origin(name)
    if not rec or rec[0] != p["old"]: return "what the name belongs to has changed since"
    if not os.path.isfile(p["new"]): return f"{tilde(p['new'])} is gone"
    if os.path.isfile(p["old"]) != (p["rule"] == "d"): return f"{tilde(p['old'])} is back" if p["rule"] == "c" else f"{tilde(p['old'])} is gone"
    return None


def pending_names():
    """Names with a decision waiting that still applies."""
    try: names = sorted(os.listdir(f"{CONF}/pending"))
    except OSError: return []
    return [n for n in names if re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._-]*", n) and (p := read_pending(n)) and not pending_stale(n, p)]


def hold(name, old, real, rule):
    """Neither accept nor refuse for good: write pending/NAME, send a notification, and stop without starting the program."""
    if rule == "d":
        why = f"which still exists, and now {tilde(real)} wants the same name: a different program"
        tail = f"A different program: use --name=OTHER for a separate home. If it really is the same one: sbx rebind {name}"
    else:
        why = f"which is gone; now it is {tilde(real)}"
        tail = f"Same program: sbx rebind {name}. Not the same: sbx rebind --dismiss {name}, then --name=OTHER for a home of its own"
    try:
        write_pending(name, old, real, rule, f"was first run from {tilde(old)}, {why}")
        notify_click(f"{name} is waiting for your decision. Open sbx-gui and use the buttons on its page, or run: sbx rebind {name}",
                     f"{name} is waiting for your decision. Click to open sbx, which has a button to decide.", "Open sbx", [name])
    except OSError:
        tail = f"sbx can't save a decision in {tilde(CONF)}. The same program: run it once with --rebind. A different one: --name=OTHER"
    die(f"'{name}' was first run from {tilde(old)}, {why}. They would share the settings and private home of '{name}'.\n      {tail}")


def sha_now(path, known):
    """The SHA-256 of PATH as it is now: the recorded one while size and mtime still match, else hashed again. None when unreadable."""
    try: st = os.stat(path)
    except OSError: return None
    if known and known[:2] == (st.st_size, st.st_mtime_ns): return known[2]
    return (fingerprint(path) or (0, 0, None))[2]


def carry_data(name, old, real):
    """A program that writes beside its own file (settings, saves, a chosen disc) finds that in its private home under the folder the file is in:
    HOME/Games/x/save.dat is HOMES/NAME/Games/x/save.dat. After a move that is another folder, and everything it stored looks lost. When OLD is
    gone, move what is stored under its folder to the folder of REAL, inside the private home only: never over something that is already there,
    never through a link (the program can plant links in its own home), and not for a file outside your home. Says so, in one line. Returns
    how many entries moved."""
    if not old or os.path.lexists(old): return 0                    # still there: a copy, the original may be in use
    a, b = os.path.dirname(old), os.path.dirname(real)
    if a == b or not (a.startswith(HOME + "/") and b.startswith(HOME + "/")): return 0
    home = os.path.realpath(HOMES) + "/" + name
    if os.path.realpath(f"{HOMES}/{name}") != home: return 0          # the private home is a plain folder, not a link to somewhere
    src, dst = f"{home}/{a[len(HOME) + 1:]}", f"{home}/{b[len(HOME) + 1:]}"
    if os.path.realpath(src) != src or os.path.realpath(dst) != dst or not os.path.isdir(src): return 0      # no link anywhere on the way
    moved = 0
    try:
        for e in sorted(os.listdir(src)):
            s, d = f"{src}/{e}", f"{dst}/{e}"
            if dst == s or dst.startswith(s + "/") or os.path.lexists(d): continue         # the new folder itself, or taken
            os.makedirs(dst, mode=0o700, exist_ok=True)
            os.rename(s, d); moved += 1
    except OSError:
        pass
    if moved: warn(f"'{name}': moved {moved} item{'s' if moved != 1 else ''} it had stored beside its old file, from {tilde(a)} to {tilde(b)}, in its private home")
    return moved


def follow(name, real, fp, old):
    """NAME now belongs to REAL, which moved there from OLD: record it, and take along what the program stored beside the old file."""
    write_origin(name, real, fp, old)
    carry_data(name, old, real)


def check_origin(name, real, rebind=False):
    """A program name owns settings (apps/NAME.conf) and a private home. Remember which file first used the name, and when a file
    shows up under it from another path, decide in this order, the first match winning:
      a. the same content (SHA-256): the same program moved or copied. Accepted, quietly.
      b. other content, the old path gone, the same file name: moved, then updated. Accepted, with one line saying so.
      c. other content, the old path gone, another file name: unclear. Asked on a terminal, otherwise left pending.
      d. other content, the old path still there: two programs want one name. Refused, left pending.
    Pending (c, d) means: pending/NAME is written, a notification is sent, nothing starts; `sbx rebind NAME` or sbx-gui decides.
    Moves between system folders (updates) are always fine; rebind=True accepts the new file. A run from the recorded path is never held
    up by what the file contains: a changed size or mtime only refreshes the record (updates and self-patching games must work)."""
    if "\n" in real: die(f"'{name}': a file name with a line break in it can't be recorded ({real!r}). Rename the file")
    rec = read_origin(name)
    old = rec[0] if rec else None
    if old == real: return refresh_origin(name, real, rec)
    system = lambda x: x.startswith(SYSTEM_PROGRAMS)
    if old is None or rebind or (system(old) and system(real)):
        follow(name, real, fingerprint(real), old)
        return clear_pending(name)
    new = fingerprint(real)
    exists = os.path.isfile(old)
    known = rec[1]
    old_sha = sha_now(old, known) if exists else known[2] if known else None      # the old file may have been updated since it was recorded
    if new and new[2] and new[2] == old_sha:                       # a
        follow(name, real, new, old)
        return clear_pending(name)
    if exists: hold(name, old, real, "d")                          # d
    if os.path.basename(old) == os.path.basename(real):            # b
        follow(name, real, new, old)
        clear_pending(name)
        return warn(f"'{name}' moved from {tilde(old)} to {tilde(real)}")
    if sys.stdin.isatty():                                         # c
        try: answer = input(f"'{name}' was first run from {tilde(old)}, which is gone. Now it is {tilde(real)}. Same program? [y/N] ")
        except EOFError: answer = ""
        if answer.strip().lower() in ("y", "yes"):
            follow(name, real, new, old)
            return clear_pending(name)
        die("not accepted. A different program: use --name=OTHER for a separate home. The same one after all: run it once with --rebind")
    hold(name, old, real, "c")


def refresh_origin(name, real, rec):
    """The program runs from the path it was recorded with. Whatever it contains now, it starts; the record only follows it: a missing
    line 2 (older version) is added, a changed size or mtime is hashed again. A record that can't be written is no reason to stop."""
    clear_pending(name)                                            # the file went back to where it was recorded
    try:
        st = os.stat(real)
        if rec[1] and rec[1][:2] == (st.st_size, st.st_mtime_ns): return
        fp = fingerprint(real)
        if fp and fp[2]: write_origin(name, real, fp, rec[2])
    except OSError:
        pass


# ---------------------------------------------------------------- shared folders
def share_names(text):
    """The folder names in a share_dirs value, in SHARE_DIRS order."""
    want = {x.strip() for x in text.split(",")}
    return [n for n in SHARE_DIRS if n in want]


def share_hosts(names):
    """[(your real folder, its path inside the sandbox)] for NAMES. Left out: a folder that is unset, missing, your home, hidden,
    secret, or inside another one in the list."""
    found = []
    for n in names:
        d = user_dir(SHARE_DIRS[n])
        if d and os.path.isdir(d) and not d[len(HOME) + 1:].startswith(".") and not sensitive_match(d) and d not in found: found.append(d)
    found.sort(key=lambda d: d.count("/"))
    keep = []
    for d in found:
        if not any(d.startswith(k + "/") for k in keep): keep.append(d)
    return keep


def share_move(old, new):
    """Move what is in the folder OLD (the private home's own Downloads, ...) into NEW. Nothing is overwritten and nothing is deleted:
    (moved, left) counts; an entry whose name is taken, or that can't be renamed, stays."""
    moved = left = 0
    try: entries = sorted(os.listdir(old))
    except OSError: return 0, 0
    for e in entries:
        if os.path.lexists(f"{new}/{e}"): left += 1; continue
        try: os.rename(f"{old}/{e}", f"{new}/{e}"); moved += 1
        except OSError: left += 1
    return moved, left


def share_mounts(name, text, live):
    """[(folder for this program, path inside the sandbox)] to bind after the private home. live=True also makes the folders (mode
    0700) and moves what the private home already holds there. A folder that isn't safe to use (sbx or sbx/NAME is a link or not
    a plain folder, the private home's own folder is behind a link, it can't be made) is skipped with a warning: it stays in the
    private home."""
    out, moved, left = [], 0, 0
    home = os.path.realpath(f"{HOMES}/{name}")
    for d in share_hosts(share_names(text)):
        rel = d[len(HOME) + 1:]
        base, own = f"{d}/sbx", f"{d}/sbx/{name}"
        bad = next((p for p in (base, own) if os.path.lexists(p) and (os.path.islink(p) or not os.path.isdir(p))), None)
        inside = f"{HOMES}/{name}/{rel}"
        if bad: why = f"{tilde(bad)} is a link or not a plain folder"
        elif os.path.realpath(inside) != f"{home}/{rel}": why = f"{tilde(inside)} is behind a link"
        else: why = None
        if why is None and live:
            try:
                for p in (base, own):
                    if not os.path.isdir(p): os.mkdir(p, 0o700)
            except OSError as e:
                why = f"can't make {tilde(own)} ({e.strerror})"
        if why:
            if live: warn(f"share_dirs: {rel} stays in the private home: {why}")
            continue
        if live and os.path.isdir(inside):
            m, k = share_move(inside, own)
            moved, left = moved + m, left + k
        out.append((own, f"{HOME}/{rel}"))
    if live and moved: warn(f"moved {moved} item{'s' if moved != 1 else ''} from the private home's shared folders into <folder>/sbx/{name}" + (f"; {left} left in place (the name is taken there)" if left else ""))
    return out


# ---------------------------------------------------------------- the bwrap command
def fake_passwd():
    """A minimal /etc/passwd for privacy=1: you (no full name), root and nobody. Written from scratch, not filtered from the
    real file, so neither your real name (the GECOS field) nor the other accounts on this computer can come through."""
    me = f"{USER}:x:{os.getuid()}:{os.getgid()}::{HOME}:{_pw.pw_shell or '/bin/sh'}\n"
    root = "root:x:0:0:root:/root:/usr/sbin/nologin\n"
    return (me if os.getuid() == 0 else root + me) + "nobody:x:65534:65534:Nobody:/:/usr/sbin/nologin\n"


def build(prog, args, live=False, o=None):
    """The bwrap command. live=True also creates what a real run needs (machine-id, proxy, X cookie, listening sockets...)
    and returns it in `state` so run() can clean up; preview (live=False) only prints."""
    o = o or {}
    loader = o.get("loader")
    if loader and not (os.path.isabs(loader) and os.path.isfile(loader)): die(f"--loader: '{loader}' is not a program")
    path, real = find_program(prog, bool(loader))
    cwd = share_dir(os.getcwd()) if o.get("here") else None
    name = clean(o.get("name") or os.path.basename(path))       # the name you typed, not the file behind a link
    if o.get("name") and name != o["name"]: warn(f"--name: using '{name}' (letters, digits and . _ - only)")
    renamed = None
    if not o.get("name") and "/" in prog:                       # a file, not a name from PATH: a renamed file is still its program (by content, before its file name counts)
        owner, old, why = file_owner(name, real)
        if why and live: warn(why)
        if old: renamed = (name, old)                           # claimed just now (else it was claimed by an earlier run: nothing to say)
        name = owner
    if live:
        check_origin(name, real, o.get("rebind", False))
        if renamed: took_over(renamed[0], name, real, renamed[1])
    cfg, src = effective(name, o)
    if cwd is None and cfg["folder"]:                         # folder=1: start in the folder the program file sits in, like --here from there
        cwd, why = own_folder(real)
        if cwd is None and live:
            warn(f"folder=1: not shared, {name} starts in its private home. {why}. Put the program in a folder of its own (a subfolder, e.g. ~/Games/{name}/) and run it from there.")
    elif cwd is None and src["folder"] == "default":          # folder not set by you anywhere: a program in a folder named after it gets that folder
        d, _ = own_folder(real)
        if d and folder_named_like(name, d):
            cwd = d
            if live: warn(f"{name} starts in {tilde(d)} and shares it read-write, because the folder is named after the program. Turn off with folder=0 (apps/{name}.conf, or sbx-gui).")
    ok = cfg["allow_sensitive"]
    rw = [p for p in [share_path(x, False, ok) for x in cfg["whitelist"]] + [share_path(x, True, ok) for x in o.get("whitelist", [])] if p]
    ro = [p for p in [share_path(x, False, ok) for x in cfg["read_only"]] + [share_path(x, True, ok) for x in o.get("read_only", [])] if p]
    allow = [n for n in cfg["allow_syscall"] if syscall_ok(n)]
    if live and cfg["hostname"] and not bwrap_has("--hostname"):
        die("hostname=1 needs bubblewrap with --hostname (0.7 or newer), so the computer name can't be hidden here. Update bubblewrap, or turn hostname off.")
    if live and not cfg["userns"] and not bwrap_has("--disable-userns"):
        die("userns=0 needs bubblewrap 0.8 or newer (--disable-userns). Not starting without it. Update bubblewrap, or turn userns on for this program.")
    priv = private_net(cfg)
    if live and cfg["net_private"] and not cfg["net"]:
        warn("net_private does nothing while net=0: the program has no network at all")
    if live and priv and not shutil.which("pasta"): die("net_private=1 needs pasta: " + install_hint("passt") + ". Or turn net_private off.")
    if live and priv and pasta_problem(): die(f"net_private=1: {pasta_problem()}. Or turn net_private off.")
    shares = order_shares(rw, ro, cwd, program_share(real) if real.startswith(HOME + "/") else None)
    rt = runtime_dir()
    tag = f"{rt}/sbx/{os.getpid() if live else 'PID'}"
    inst = f"{rt}/.flatpak/{os.getpid() if live else 'PID'}"      # the portal looks the program up here, by the pid in bwrapinfo.json (as it does for a flatpak)
    state = {"proxy": None, "bus": tag + ".bus", "a11y": None, "a11y_bus": tag + ".a11y", "system": None, "system_bus": tag + ".system", "files": [], "fds": [], "keep": [], "wl": None, "cleanup": [], "prefix": [], "wrap": []}
    wrapfiles = []          # files the shell in front of bwrap opens as descriptors when pasta is used, which closes inherited ones: (descriptor, "<" or ">", path)
    env = {"HOME": HOME, "USER": USER, "LOGNAME": USER, "PATH": sandbox_path(), "XDG_RUNTIME_DIR": rt, "SBX_ACTIVE": "1"}
    for k in ENV_KEEP:
        if k in os.environ: env[k] = os.environ[k]
    if cfg["compat"]:
        for k, v in os.environ.items():
            if (k in COMPAT_ENV or k.startswith(COMPAT_PREFIXES)) and k not in ENV_PROTECTED: env[k] = v
    a = ["bwrap", "--unshare-all"] + (["--share-net"] if cfg["net"] else [])
    if not cfg["userns"]: a += ["--unshare-user", "--disable-userns"]
    if priv: a += ["--uid", str(os.getuid()), "--gid", str(os.getgid())]      # pasta's user namespace maps you to root; keep your own ids inside
    a += ["--die-with-parent", "--new-session", "--clearenv"]
    if cfg["hostname"]: a += ["--hostname", "sbx"]

    def put(src, blob):                         # a private file next to the other helper files, removed when the run ends
        if not live: return                     # (a file, not an inherited descriptor: a wrapper such as pasta would close those)
        os.makedirs(os.path.dirname(src), mode=0o700, exist_ok=True)
        fd = os.open(src, os.O_WRONLY | os.O_CREAT | os.O_TRUNC | os.O_NOFOLLOW, 0o600)
        with os.fdopen(fd, "wb") as f: f.write(blob)
        state["files"].append(src)

    machine = platform.machine()
    c32 = bool(cfg["allow_32bit"]) and machine in COMPAT32
    if cfg["allow_32bit"] and live:
        warn("allow_32bit=1: 32-bit programs may run. socketcall() hides its arguments from the filter, so for them the socket() family check does not apply (AF_ALG, AF_PACKET, AF_VSOCK...)" if c32 else f"allow_32bit=1 has no effect on {machine}")
    if machine in ARCHES and priv:              # inside pasta: bwrap reads the filter from descriptor 9, which a shell opens from this file
        put(f"{tag}.seccomp", seccomp_program(machine, allow, c32))
        a += ["--seccomp", str(SEC_FD)]
        wrapfiles.append((SEC_FD, "<", f"{tag}.seccomp"))
    elif machine in ARCHES:
        if live:
            sec = seccomp_file(allow, c32)
            os.set_inheritable(sec.fileno(), True)
            state["keep"].append(sec); state["fds"].append(sec.fileno())
            a += ["--seccomp", str(sec.fileno())]
        else:
            a += ["--seccomp", "FD"]

    def data(dest, text, ext):                  # a read-only file made from text
        put(f"{tag}.{ext}", text.encode())
        return ["--ro-bind", f"{tag}.{ext}", dest]

    def track(dst, source, tryit):              # bwrap creates mountpoints inside the private home; note them for cleanup
        if not live or cfg["private"] or not dst.startswith(HOME + "/") or (tryit and not os.path.exists(source)): return
        parts = dst[len(HOME) + 1:].split("/")
        for i in range(1, len(parts) + 1):
            p = f"{HOMES}/{name}/" + "/".join(parts[:i])
            if not os.path.lexists(p) and p not in state["cleanup"]: state["cleanup"].append(p)

    def mount(kind, source, dst=None):
        dst = dst or source
        a.extend([kind, source, dst]); track(dst, source, kind.endswith("-try"))

    a += ["--ro-bind", "/", "/", "--dev", "/dev", "--proc", "/proc", "--tmpfs", "/tmp", "--tmpfs", "/run"]
    a += data("/proc/sys/kernel/random/boot_id", str(uuid.uuid4()) + "\n", "boot_id")      # the host's boot id is a fingerprint
    for link in NIX_LINKS:
        if os.path.islink(link): a += ["--symlink", os.readlink(link), link]
    for d in resolv_dirs():
        if os.path.isdir(d): a += ["--ro-bind", d, d]
    a += ["--perms", "0700", "--dir", rt]
    if cfg["single_instance"]:      # a second launch of the same program finds the first one's lock/socket files (Chrome keeps its singleton socket in $TMPDIR)
        si = f"{rt}/sbx/single/{name}"
        if live:
            for d in (f"{rt}/sbx", f"{rt}/sbx/single", si): os.makedirs(d, mode=0o700, exist_ok=True)
        a += ["--bind", si, si]
        env["TMPDIR"] = si          # set before setenv=, so a setenv=TMPDIR=... of yours still wins
    # Desktop access (each one a setting): Wayland, X11, GPU, sound, portals.
    gui, late = False, []          # late: mounts that may sit inside the home, so they go after the home is replaced
    wp = wayland_path() if cfg["wayland"] else None
    if wp:
        bind_src = wp
        if live:
            state["wl"] = wayland_context(wp, tag + ".wl", o.get("app_id") or name, f"{name}-{os.getpid()}")
            if state["wl"]: bind_src = tag + ".wl"
        elif wl_supported(wp): bind_src = tag + ".wl"
        # wayland_strict that you never set is on exactly where the compositor can restrict programs: if the attempt failed
        # there, the program gets no Wayland instead of quietly getting the full socket. Where it can't, it gets the full socket.
        if bind_src == wp and (cfg["wayland_strict"] or (live and src["wayland_strict"] == "default" and wl_supported(wp))):
            if live: warn("no restricted Wayland socket could be made, and wayland_strict is on: Wayland is off")
            wp = None
        elif bind_src == wp and live:
            warn("the compositor has no security-context support, so the program gets full Wayland access")
        if wp:
            a += ["--ro-bind", bind_src, wp]; gui = True
            env["WAYLAND_DISPLAY"] = os.environ["WAYLAND_DISPLAY"]; env["XDG_SESSION_TYPE"] = "wayland"
    if cfg["x11"]:
        disp = os.environ.get("DISPLAY", "")
        if disp.startswith(":"):
            sock = f"/tmp/.X11-unix/X{disp[1:].split('.')[0]}"
            a += ["--ro-bind-try", sock, sock]; env["DISPLAY"] = disp; gui = True
        xa = os.environ.get("XAUTHORITY")
        if xa and os.path.isfile(xa):
            xsrc = xa
            if live:                                           # only this display's cookie, not every cookie in the file
                xsrc = scoped_xauth(xa, disp, tag + ".xauth")
                if xsrc: state["files"].append(xsrc)
                else: warn("no usable cookie for this display in XAUTHORITY; not passing the file")
            if xsrc: late += ["--ro-bind", xsrc, xa]; env["XAUTHORITY"] = xa
    if cfg["gpu"] or cfg["rocm"]:
        if cfg["gpu_render_only"]:      # render nodes are enough to draw; the card* nodes can also drive the display
            for p in sorted(glob.glob("/dev/dri/renderD*")): a += ["--dev-bind", p, p]
        else:
            a += ["--dev-bind-try", "/dev/dri", "/dev/dri"]
    if cfg["gpu"]:
        for p in sorted(glob.glob("/dev/nvidia*")): a += ["--dev-bind", p, p]
    if cfg["rocm"]: a += ["--dev-bind-try", "/dev/kfd", "/dev/kfd"]
    if cfg["camera"]:
        for p in sorted(glob.glob("/dev/video*") + glob.glob("/dev/media*")): a += ["--dev-bind", p, p]
    if cfg["input"]: a += ["--dev-bind-try", "/dev/input", "/dev/input", "--ro-bind-try", "/run/udev", "/run/udev"]   # SDL/libinput classify devices from udev's database
    if cfg["alsa"]: a += ["--dev-bind-try", "/dev/snd", "/dev/snd"]
    if cfg["kvm"]: a += ["--dev-bind-try", "/dev/kvm", "/dev/kvm"]
    if cfg["ntsync"]: a += ["--dev-bind-try", "/dev/ntsync", "/dev/ntsync"]
    if cfg["printing"]: a += ["--ro-bind-try", "/run/cups/cups.sock", "/run/cups/cups.sock"]; env["CUPS_SERVER"] = "/run/cups/cups.sock"
    if cfg["sound"]:
        for x in ("pipewire-0", "pulse/native"): a += ["--ro-bind-try", f"{rt}/{x}", f"{rt}/{x}"]
        env["PULSE_SERVER"] = f"unix:{rt}/pulse/native"
    sa = os.environ.get("SSH_AUTH_SOCK", "")
    if cfg["ssh_agent"] and sa and os.path.exists(sa):     # the program can sign as you while it runs
        late += ["--ro-bind", sa, sa]; env["SSH_AUTH_SOCK"] = sa
    if cfg["portals"] or cfg["talk"] or any(cfg[k] for k, _ in BUS_INTEGRATIONS):
        sock = state["bus"]
        if live:
            state["proxy"] = start_proxy(sock, cfg, portal_app_id(name) if cfg["portals"] else None)
            if not state["proxy"]: sock = None
        if sock:
            a += ["--ro-bind", sock, f"{rt}/bus"]; env["DBUS_SESSION_BUS_ADDRESS"] = f"unix:path={rt}/bus"
            if cfg["portals"]:      # a toolkit uses the file chooser portal only when told to; a theme that compat passes through from your session (gtk3, qt6ct) would open Qt's own dialog, so it is replaced; env= and setenv= still win (no /.flatpak-info for the program: glycin would then run its image loaders through flatpak-spawn, which fails, and GTK aborts)
                gtk = cfg["gtk_portal"] or "auto"
                if gtk == "auto" and cursor_size_is_zero():
                    gtk = "0"
                    if live: warn("gtk_portal=auto: the host's cursor size is 0, which crashes GTK with the file chooser portal, so GTK_USE_PORTAL is not set (gtk_portal=1 sets it anyway)")
                if gtk != "0": env["GTK_USE_PORTAL"] = "1"
                env["QT_QPA_PLATFORMTHEME"] = "xdgdesktopportal"
                info = f"{inst}/bwrapinfo.json"      # bwrap writes {"child-pid": N} here once the sandbox exists; the portal refuses every call without it
                put(info, b""); state["cleanup"].append(inst)
                if priv: a += ["--info-fd", str(INFO_FD)]; wrapfiles.append((INFO_FD, ">", info))
                elif live:
                    f = os.fdopen(os.open(info, os.O_WRONLY | os.O_NOFOLLOW), "wb"); os.set_inheritable(f.fileno(), True)
                    state["keep"].append(f); state["fds"].append(f.fileno()); a += ["--info-fd", str(f.fileno())]
                else: a += ["--info-fd", "FD"]
    if cfg["a11y"]:         # a screen reader talks to each program over the accessibility bus; the program gets a filtered copy of it (works without portals)
        sock = state["a11y_bus"]
        if live:
            state["a11y"] = start_a11y_proxy(sock)
            if not state["a11y"]: sock = None
        if sock:
            a += ["--ro-bind", sock, f"{rt}/at-spi/bus"]; env["AT_SPI_BUS_ADDRESS"] = f"unix:path={rt}/at-spi/bus"
            env.update(A11Y_ENV)
    if any(cfg[k] for k in SYSTEM_BUS_NAMES):
        sock = state["system_bus"]
        if live:
            state["system"] = start_system_proxy(sock, cfg)
            if not state["system"]: sock = None
        if sock:
            a += ["--ro-bind", sock, SYSTEM_BUS_SOCKET]; env["DBUS_SYSTEM_BUS_ADDRESS"] = f"unix:path={SYSTEM_BUS_SOCKET}"
    if cfg["portals"]:      # the files you pick in a chooser appear here, only this program's own (bind-try: nothing when there is no document portal)
        a += ["--bind-try", f"{runtime_dir()}/doc/by-app/{portal_app_id(name)}", f"{rt}/doc"]
    if live and not cfg["portals"] and any(cfg[k] for k in PORTAL_EXTRA):
        warn("portal_* settings need portals=1; ignored")
    # Hide the real home and other users: empty the folder that holds your home, then put the private home in its place.
    parent = os.path.dirname(HOME)
    hide = [parent if parent != "/" else HOME]
    for d in EMPTY_DIRS + ["/home"]:
        if os.path.isdir(d) and not os.path.islink(d) and d not in hide and not HOME.startswith(d + "/"):
            hide.append(d)
    for d in hide: a += ["--tmpfs", d]
    for d in HIDE_SYS + ([] if cfg["net"] and not priv else ["/sys/class/net"]):     # /sys/class/net would list the host's cards even without a network, or with pasta's own
        if os.path.isdir(d): a += ["--tmpfs", d]
    a += ["--tmpfs", HOME] if cfg["private"] else ["--bind", f"{HOMES}/{name}", HOME]     # private=1: erased on exit
    if not cfg["private"]:
        for own, dst in share_mounts(name, cfg["share_dirs"], live): a += ["--bind", own, dst]
    for i in range(0, len(late), 3): mount(late[i], late[i + 1], late[i + 2])
    if gui and cfg["theme"]:
        for rel in THEME: mount("--ro-bind-try", f"{HOME}/{rel}")
        gs = gsettings_keyfile(tag + ".gsettings", live)          # button layout and cursor from dconf, which the program can't read
        if gs:
            mount("--ro-bind", gs, f"{HOME}/.config/glib-2.0/settings/keyfile")
            env["GSETTINGS_BACKEND"] = "keyfile"
            if live: state["files"].append(gs)
    for p, mode in shares: mount("--bind" if mode == "rw" else "--ro-bind", p)      # --here, whitelist=, read_only=, the program itself
    for p in SECRETS + [x for g in SECRET_GLOBS for x in glob.glob(g)]:
        if os.path.isdir(p): a += ["--tmpfs", p]
        elif os.path.isfile(p): a += ["--ro-bind", "/dev/null", p]
    if cfg["hostname"]:                         # /etc/hostname and /etc/hosts would still tell the real name
        if os.path.isfile("/etc/hostname"): a += data("/etc/hostname", "sbx\n", "hostname")
        if os.path.isfile("/etc/hosts"): a += data("/etc/hosts", "127.0.0.1 localhost\n::1 localhost\n127.0.1.1 sbx\n", "hosts")
    if cfg["privacy"] and os.path.isfile("/etc/passwd"):      # onto the file's real path: bwrap can't mount on a symlink (NixOS)
        a += data(os.path.realpath("/etc/passwd"), fake_passwd(), "passwd")
    if priv and os.path.isfile("/etc/resolv.conf"):      # the only name server pasta answers; onto the link's target, bwrap can't mount on a symlink
        a += data(resolv_target(), f"nameserver {DNS_FWD}\n", "resolv.conf")
    if os.path.isfile("/etc/machine-id"):
        mid = machine_id(name, live)
        a += ["--ro-bind", mid, "/etc/machine-id"]
        if os.path.isfile("/var/lib/dbus/machine-id") and not os.path.islink("/var/lib/dbus/machine-id"):
            a += ["--ro-bind", mid, "/var/lib/dbus/machine-id"]
    for k in cfg["env"]:                        # your own variables, passed through or set; the core ones are off limits
        if k in os.environ and k not in ENV_PROTECTED: env[k] = os.environ[k]
    for kv in cfg["setenv"]:
        k, _, v = kv.partition("=")
        if k in ENV_PROTECTED: warn(f"setenv: {k} can't be changed")
        else: env[k] = v
    for k, v in env.items(): a += ["--setenv", k, v]
    shared = [p for p, _ in shares]
    if live and cfg["portals"]:
        args = portal_file_args(args, portal_app_id(name), shared)
        shared.append(f"{rt}/doc")
    exe = real if real.startswith(HOME + "/") or path.startswith(HOME + "/") else path
    if live: hint_args(args, cwd, shared)
    limits = [f"-p{p}={cfg[k]}" for k, p in (("memory", "MemoryMax"), ("tasks", "TasksMax"), ("cpu", "CPUQuota")) if cfg[k]]
    if limits: state["prefix"] = ["systemd-run", "--user", "--scope", "--quiet"] + limits + ["--"]
    if priv: state["wrap"] = net_wrap(wrapfiles)
    return name, a + ["--chdir", cwd or HOME, "--"] + ([loader] if loader else []) + [exe] + shlex.split(cfg["args"]) + args, state


# ---------------------------------------------------------------- running programs
RUNNING = f"{STATE}/running"      # RUNNING/PID: "NAME\nSTARTTIME" of an sbx process, then "\nPID\nSTARTTIME" of its sandbox


def proc_start(pid):
    """When PID started: field 22 of /proc/PID/stat (clock ticks since boot, as text), or None. A reused PID gets another one."""
    try:
        with open(f"/proc/{pid}/stat", "rb") as f: rest = f.read().rsplit(b")", 1)[1].split()      # field 2, the name, may hold spaces and ')'
        return rest[19].decode()                                                                    # rest[0] is field 3
    except (OSError, IndexError, UnicodeDecodeError):
        return None


def live_sbx(pid):
    """True if this PID is really an sbx process (a stale file may point at a reused PID). Started by its name (`sbx`, `python3
    sbx`) or through a link made by `sbx link`, whose command line has only the link's name (`python3 ~/.local/bin/firefox`)."""
    try:
        with open(f"/proc/{pid}/cmdline", "rb") as f: argv = [x.decode(errors="replace") for x in f.read().split(b"\0") if x]
        cwd = os.readlink(f"/proc/{pid}/cwd")
    except OSError:
        return False
    return any(os.path.basename(x) == "sbx" or is_sbx_link(os.path.join(cwd, x)) for x in argv[:3])


def live_pid(entry):
    """The PID to signal for the run in RUNNING/ENTRY: its sbx process, else its sandbox if sbx is gone; None when neither is alive."""
    try:
        with open(f"{RUNNING}/{entry}") as f: lines = [x.strip() for x in f.read().split("\n")] + ["", "", "", ""]
    except OSError:
        return None
    if lines[1] and lines[1] == proc_start(entry) and live_sbx(entry): return int(entry)
    if lines[2].isdigit() and lines[3] and lines[3] == proc_start(lines[2]): return int(lines[2])
    return None


def pid_app(pid):
    """The program name in RUNNING/PID while that run is alive (see live_pid)."""
    if live_pid(pid) is None: return None
    try:
        with open(f"{RUNNING}/{pid}") as f: return f.readline().strip()
    except OSError:
        return None


def running(name=None):
    """PIDs of the sbx processes running NAME (every program when NAME is None)."""
    try: names = [f for f in os.listdir(RUNNING) if f.isdigit()]
    except OSError: return []
    return [p for p in names if (pid_app(p) == name if name else pid_app(p))]


def mark_running(name):
    """Note that this process runs NAME, and drop the files of processes that are gone."""
    os.makedirs(RUNNING, mode=0o700, exist_ok=True)
    for f in os.listdir(RUNNING):
        if f.isdigit() and not pid_app(f):
            try: os.unlink(f"{RUNNING}/{f}")
            except OSError: pass
    with open(f"{RUNNING}/{os.getpid()}", "w") as f: f.write(f"{name}\n{proc_start(os.getpid()) or ''}")


def mark_child(pid):
    """Add the sandbox process to our file, so the run still counts if sbx dies before it."""
    try:
        with open(f"{RUNNING}/{os.getpid()}", "a") as f: f.write(f"\n{pid}\n{proc_start(pid) or ''}")
    except OSError: pass


def unmark_running():
    try: os.unlink(f"{RUNNING}/{os.getpid()}")
    except OSError: pass


def descendants(pid):
    """[(pid, start)] of every process below PID, found through the parent links in /proc."""
    kids = {}
    for f in os.listdir("/proc"):
        if not f.isdigit(): continue
        try:
            with open(f"/proc/{f}/stat", "rb") as h: rest = h.read().rsplit(b")", 1)[1].split()
            kids.setdefault(int(rest[1]), []).append((int(f), rest[19].decode()))
        except (OSError, IndexError, ValueError): pass
    found, todo = [], [int(pid)]
    while todo:
        for c in kids.get(todo.pop(), []): found.append(c); todo.append(c[0])
    return found


def signal_tree(tree, sig):
    for pid, start in tree:
        if proc_start(pid) != start: continue
        try: os.kill(pid, sig)
        except OSError: pass


def finish_tree(tree, grace):
    """Give the processes in TREE GRACE seconds to end, then SIGKILL the rest."""
    end = time.time() + grace
    while time.time() < end and any(proc_start(pid) == start for pid, start in tree): time.sleep(0.1)
    signal_tree(tree, signal.SIGKILL)


def stop_program(name):
    """SIGTERM every running sbx process of NAME; returns how many were signalled. A PID can be reused between listing the
    processes and signalling one, so each PID is first pinned with a pidfd and only then checked against its file: the
    signal goes to the process that was checked, never to a newcomer that took the number."""
    sent = 0
    use_fd = hasattr(os, "pidfd_open") and hasattr(signal, "pidfd_send_signal")
    for entry in running(name):
        pid = live_pid(entry)
        if pid is None: continue
        below = descendants(pid) if pid != int(entry) else []          # sbx is gone: what its sandbox started must be stopped too
        fd = None
        try:
            if use_fd:
                try: fd = os.pidfd_open(pid)
                except ProcessLookupError: continue
                except OSError: pass                     # no pidfd on this kernel: plain kill below
            if live_pid(entry) != pid: continue
            if fd is None: os.kill(pid, signal.SIGTERM)
            else: signal.pidfd_send_signal(fd, signal.SIGTERM)
            sent += 1
            signal_tree(below, signal.SIGTERM)
        except OSError:
            pass
        finally:
            if fd is not None: os.close(fd)
    return sent


# ---------------------------------------------------------------- running it
STOP_GRACE = 5      # seconds between SIGTERM and SIGKILL when sbx is told to stop

def sweep_stale():
    """Remove helper files that a killed sbx left behind in $XDG_RUNTIME_DIR/sbx (named PID.bus, PID.a11y, PID.system, PID.xauth, PID.wl, PID.gsettings, PID.boot_id, PID.hostname, PID.hosts, PID.passwd, PID.resolv.conf, PID.seccomp)."""
    d = f"{runtime_dir()}/sbx"
    try: names = os.listdir(d)
    except OSError: return
    for n in names:
        m = re.fullmatch(r"(\d+)\.(bus|a11y|system|xauth|wl|gsettings|boot_id|hostname|hosts|passwd|resolv\.conf|seccomp)", n)
        if not m: continue
        try: os.kill(int(m.group(1)), 0); continue          # still running
        except ProcessLookupError: pass
        except OSError: continue
        try: os.unlink(f"{d}/{n}")
        except OSError: pass


def teardown(st):
    stop_proxy(st["proxy"], st["bus"])
    if st.get("a11y_bus"): stop_proxy(st.get("a11y"), st["a11y_bus"])
    if st.get("system_bus"): stop_proxy(st.get("system"), st["system_bus"])
    if st["wl"]: st["wl"].close()
    for f in st["files"]:
        try: os.unlink(f)
        except OSError: pass
    for p in reversed(st["cleanup"]):           # mountpoints bwrap made in the private home, if still empty
        try:
            if os.path.isdir(p) and not os.path.islink(p): os.rmdir(p)
            elif os.path.isfile(p) and os.path.getsize(p) == 0: os.unlink(p)
        except OSError:
            pass


def give_exec_bit(path):
    """For a dynamically linked ELF file without the execute bit: set the bit for this run and return the old mode.
    Returns False if it can't be set (the caller then uses the loader), None if there is nothing to do. Running through the
    loader instead would make /proc/self/exe the loader, which breaks programs that read their own file (.NET single-file apps)."""
    if not os.path.isfile(path) or os.access(path, os.X_OK) or not elf_interpreter(path): return None
    try:
        mode = os.stat(path).st_mode
        os.chmod(path, mode | 0o100)
        return mode
    except OSError:
        return False


def undo_exec_bit(prog, mode):
    if mode is not None:
        try: os.chmod(os.path.abspath(prog), mode)
        except OSError: pass


def tee_stderr(fd, name):
    """Copy a program's stderr to our own stderr and to the log, minus control characters, at most LOG_RUN_MAX bytes per run.
    Chunks, not lines, so a prompt without a newline shows at once."""
    lf = open_log()
    n, pend = 0, ""                               # pend: the unfinished line, kept short so a flood without newlines can't fill memory
    dec = codecs.getincrementaldecoder("utf-8")(errors="replace")
    try:
        while True:
            data = os.read(fd, 4096)
            text = CTRL.sub("", dec.decode(data, final=not data))
            try: sys.stderr.write(text); sys.stderr.flush()
            except (OSError, ValueError): pass
            lines = (pend + text).split("\n"); pend = lines.pop()
            lines = [x + "\n" for x in lines]
            while len(pend) > LOG_LINE_MAX: lines.append(pend[:LOG_LINE_MAX] + "\n"); pend = pend[LOG_LINE_MAX:]
            if not data and pend: lines.append(pend + "\n"); pend = ""
            for line in lines:
                if lf and n < LOG_RUN_MAX:
                    n += len(line)
                    log_write(lf, f"[{name}] {line}" + (f"[{name}] (more output not logged)\n" if n >= LOG_RUN_MAX else ""))
            if not data: break
    except Exception:
        pass
    finally:
        if lf: lf.close()


def run(prog, args, opts):
    if os.geteuid() == 0: die("refusing to run as root")
    if os.environ.get("SBX_ACTIVE"): die("already inside an sbx sandbox")
    LOG_NAME[0] = clean(opts.get("name") or os.path.basename(prog))      # same name build() will use; from here on warnings and errors are logged too
    if not shutil.which("bwrap"): die(f"bubblewrap missing: {install_hint('bubblewrap')}")
    if platform.machine() not in ARCHES: die(f"no system-call filter for {platform.machine()}; not starting without it")
    sweep_stale()
    os.makedirs(HOMES, mode=0o700, exist_ok=True)
    restore = None
    if not opts.get("loader") and "/" in prog:
        restore = give_exec_bit(os.path.abspath(prog))      # a dynamically linked ELF file without the execute bit
        if restore is False:                                # can't change it: go through the loader instead
            opts, restore = {**opts, "loader": elf_interpreter(os.path.abspath(prog))}, None
    try:
        name, cmd, st = build(prog, args, True, opts)
    except BaseException:
        undo_exec_bit(prog, restore); raise
    if st["prefix"] and not shutil.which("systemd-run"):
        teardown(st); undo_exec_bit(prog, restore); die(f"memory/tasks/cpu limits need systemd-run: {install_hint('systemd')}")
    os.makedirs(f"{HOMES}/{name}", mode=0o700, exist_ok=True)
    cfg, _ = effective(name, opts)
    log("START allow=[" + ",".join(k for k in SCALARS if cfg[k]) + "]", name)
    try: mark_running(name)
    except OSError: pass                          # only `sbx stop`, `sbx list` and the running-check of `sbx clean` need it
    start, stopped, child, tree = time.time(), [False], [None], []
    piped = not sys.stderr.isatty()               # started from the app menu or a file manager: no terminal, so the log keeps stderr
    try:
        def stop(*_):                                  # first signal: ask politely, kill after STOP_GRACE s; a second one kills at once
            again, stopped[0] = stopped[0], True
            if not child[0]: return
            tree[:] = descendants(child[0].pid) or tree           # pasta dies on SIGTERM but leaves bwrap and the program running
            if again: child[0].kill(); signal_tree(tree, signal.SIGKILL)
            else:
                child[0].terminate(); signal_tree(tree, signal.SIGTERM)
                t = threading.Timer(STOP_GRACE, lambda: child[0].kill()); t.daemon = True; t.start()
        for sg in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP): signal.signal(sg, stop)      # before the child exists, so no signal is missed
        p = child[0] = subprocess.Popen(st["prefix"] + st["wrap"] + cmd, pass_fds=st["fds"], stderr=subprocess.PIPE if piped else None)
        mark_child(p.pid)
        if stopped[0]: p.terminate()                  # a signal that came while it was starting
        t = threading.Thread(target=tee_stderr, args=(p.stderr.fileno(), name), daemon=True) if piped else None
        if t: t.start()
        rc = p.wait()
        if stopped[0]: finish_tree(tree, STOP_GRACE)
        if t: t.join(2)
    finally:
        unmark_running(); teardown(st); undo_exec_bit(prog, restore)
    code, sig = exit_code(rc), crash_signal(rc)
    log(f"EXIT code={code}" + (f" ({sig})" if sig else ""), name)
    exe = prog if "/" in prog else shutil.which(prog)
    hint = HINT_32BIT if rc != 0 and not stopped[0] and not cfg["allow_32bit"] and platform.machine() in COMPAT32 and exe and is_i386_elf(exe) else ""
    if hint: warn(hint)
    if not stopped[0] and not os.environ.get("SBX_NO_POPUP"):
        if sig: notify_crash(name, sig, hint)                            # at any time, not only right after starting
        elif rc != 0 and time.time() - start < 10: notify_failure(name, hint)
        elif rc != 0 and piped: notify_ended(name, code, hint)           # no terminal to show the error, so say it
    sys.exit(code)


