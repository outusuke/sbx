# sbx-selftest - run it INSIDE sbx and it tries to reach things the sandbox should hide. Every row should say PASS.
#     sbx ./sbx-selftest [PATH ...]
# Extra PATHs are files or folders that must not be visible (test_sbx.py plants canaries and passes them here).
# Exit status 1 if anything is FAIL. Run it without sbx and it should fail, which proves the checks mean something.
import ctypes, errno, os, platform, socket, sys

H = os.path.expanduser("~")
rows, bad = [], []

def row(ok, name, detail=""):
    rows.append(f"{'PASS' if ok else 'FAIL'}  {name:<34} {detail}")
    if not ok: bad.append(name)

def entries(p):
    """What listing folder p shows; nothing if it is missing or unreadable (both mean hidden)."""
    try: return os.listdir(p)
    except OSError: return []

def visible(p):
    """Why p can be seen (a string), or '' if it is hidden: missing, unreadable, or an empty folder."""
    try:
        if os.path.isdir(p): return f"folder with {len(entries(p))} entries" if entries(p) else ""
        return f"file, {len(open(p, 'rb').read(4096))} bytes readable" if open(p, "rb").read(1) else ""
    except OSError:
        return ""

# 1. your real files must be hidden (inside sbx, ~ is the program's private home)
for rel in (".ssh", ".gnupg", ".aws", ".config/sbx", ".sbx-homes"):
    why = visible(f"{H}/{rel}")
    row(not why, f"~/{rel} is hidden", why)
for p in sys.argv[1:]:
    why = visible(p)
    row(not why, f"{p} is hidden", why)
row(entries(os.path.dirname(H)) == [os.path.basename(H)], "other users' homes are hidden", str(entries(os.path.dirname(H)))[:60])

# 2. system secrets
why = visible("/etc/shadow")
row(not why, "/etc/shadow is empty or unreadable", why)
row(not entries("/root"), "/root is empty")
for d in ("/mnt", "/media", "/srv"):
    row(not entries(d), f"{d} is empty")

# 3. the system is read-only
for p in ("/etc/sbx-selftest", "/usr/sbx-selftest", "/opt/sbx-selftest"):
    try: open(p, "w").close(); os.unlink(p); row(False, f"{p} can't be written", "it could")
    except OSError as e: row(e.errno in (errno.EROFS, errno.EACCES, errno.EPERM), f"{p} can't be written", e.strerror)

# 4. blocked system calls must answer EPERM (unfiltered they answer EINVAL, EFAULT or succeed)
nrs = {"x86_64": {"bpf": 321, "perf_event_open": 298, "mbind": 237, "keyctl": 250},
       "aarch64": {"bpf": 280, "perf_event_open": 241, "mbind": 235, "keyctl": 219}}.get(platform.machine())
if nrs:
    libc = ctypes.CDLL(None, use_errno=True)
    for name, nr in nrs.items():
        ctypes.set_errno(0)
        r = libc.syscall(nr, 0, 0, 0, 0, 0, 0)
        e = ctypes.get_errno()
        row(r == -1 and e == errno.EPERM, f"syscall {name} is blocked", "EPERM" if e == errno.EPERM else f"result {r}, errno {e}")
else:
    rows.append(f"INFO  syscalls: no list for {platform.machine()}")

# 5. environment and identity
leaked = [k for k in ("SSH_AUTH_SOCK", "GPG_AGENT_INFO", "AWS_SECRET_ACCESS_KEY", "GITHUB_TOKEN", "SBX_CANARY") if k in os.environ]
row(not leaked, "secret variables are not passed on", ",".join(leaked))
row(os.environ.get("SBX_ACTIVE") == "1", "SBX_ACTIVE is set")
pids = [n for n in entries("/proc") if n.isdigit()]
row(len(pids) < 10, "own PID namespace", f"{len(pids)} processes visible")
try: mid = open("/etc/machine-id").read().strip()
except OSError: mid = ""
rows.append(f"INFO  machine-id {mid}")                 # test_sbx.py compares this with the host's
rows.append(f"INFO  hostname {socket.gethostname()}")

print("sbx self-test\n" + "=" * 13 + "\n" + "\n".join(rows))
print("\nALL PASS" if not bad else f"\n{len(bad)} FAILED: " + ", ".join(bad))
sys.exit(1 if bad else 0)
