# Generated by test_sbx.py: the bwrap command `sbx preview` builds, with the host's details faked.
# A diff here means the sandbox's mounts or options changed. Review it, then UPDATE_SNAPSHOTS=1 python3 test_sbx.py

## default: sbx firefox
bwrap
--unshare-all
--share-net
--die-with-parent
--new-session
--clearenv
--seccomp FD
--ro-bind / /
--dev /dev
--proc /proc
--tmpfs /tmp
--tmpfs /run
--ro-bind-data FD /proc/sys/kernel/random/boot_id
--ro-bind /run/systemd/resolve /run/systemd/resolve
--perms 0700
--dir /run/user/1000
--ro-bind /run/user/1000/sbx/PID.wl /run/user/1000/wayland-0
--dev-bind-try /dev/dri /dev/dri
--ro-bind-try /run/user/1000/pipewire-0 /run/user/1000/pipewire-0
--ro-bind-try /run/user/1000/pulse/native /run/user/1000/pulse/native
--tmpfs /home
--tmpfs /root
--tmpfs /mnt
--tmpfs /media
--tmpfs /srv
--tmpfs /var/tmp
--tmpfs /var/log
--tmpfs /var/mail
--tmpfs /var/spool/mail
--tmpfs /sys/devices/virtual/dmi/id
--bind /home/user/.sbx-homes/firefox /home/user
--ro-bind-try /home/user/.local/share/fonts /home/user/.local/share/fonts
--ro-bind-try /home/user/.fonts /home/user/.fonts
--ro-bind-try /home/user/.local/share/icons /home/user/.local/share/icons
--ro-bind-try /home/user/.icons /home/user/.icons
--ro-bind-try /home/user/.local/share/themes /home/user/.local/share/themes
--ro-bind-try /home/user/.themes /home/user/.themes
--ro-bind-try /home/user/.config/gtk-3.0/settings.ini /home/user/.config/gtk-3.0/settings.ini
--ro-bind-try /home/user/.config/gtk-3.0/gtk.css /home/user/.config/gtk-3.0/gtk.css
--ro-bind-try /home/user/.config/gtk-4.0/settings.ini /home/user/.config/gtk-4.0/settings.ini
--ro-bind-try /home/user/.config/gtk-4.0/gtk.css /home/user/.config/gtk-4.0/gtk.css
--ro-bind-try /home/user/.config/fontconfig /home/user/.config/fontconfig
--ro-bind-try /home/user/.cache/fontconfig /home/user/.cache/fontconfig
--ro-bind /dev/null /etc/shadow
--ro-bind /dev/null /etc/shadow-
--ro-bind /dev/null /etc/gshadow
--ro-bind /dev/null /etc/sudoers
--tmpfs /etc/sudoers.d
--tmpfs /etc/ssl/private
--ro-bind /dev/null /etc/ssh/ssh_host_ed25519_key
--ro-bind /home/user/.config/sbx/ids/firefox /etc/machine-id
--ro-bind /home/user/.config/sbx/ids/firefox /var/lib/dbus/machine-id
--setenv HOME /home/user
--setenv USER user
--setenv LOGNAME user
--setenv PATH /usr/local/bin:/usr/bin:/usr/sbin
--setenv XDG_RUNTIME_DIR /run/user/1000
--setenv SBX_ACTIVE 1
--setenv LANG en_US.UTF-8
--setenv TERM xterm
--setenv XDG_CURRENT_DESKTOP GNOME
--setenv WAYLAND_DISPLAY wayland-0
--setenv XDG_SESSION_TYPE wayland
--setenv PULSE_SERVER unix:/run/user/1000/pulse/native
--chdir /home/user
-- /usr/bin/firefox

