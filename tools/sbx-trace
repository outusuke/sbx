# sbx-trace - run a command with bpftrace watching and report which files it opened, looked for or changed (deleted, renamed, made...), and which attempts failed.
#     sbx-trace [--json] [--host] [--limit N] [--] COMMAND [args]        e.g.   sbx-trace -- sbx firefox
#     sbx-trace --last [NAME] [--json] [--limit N]                      show the last report again
#     sbx-trace --diff [NAME] [--json] [--limit N]                      compare the last report with the one before it (did a setting help?)
#     sbx-trace --suggest [NAME] [--json] [--limit N]                   settings (read_only=, whitelist=) that would let the program reach what it was refused
# A tool apart from sbx: it only starts a command and watches it from outside. It needs bpftrace, a kernel with BTF and root
# (sudo on a terminal, else pkexec). If bpftrace refuses the larger set of system calls, it starts again with the basic set (no writes). Without --host only processes inside a new pid namespace are kept, which leaves out
# bubblewrap's own setup work and shows what the sandboxed program did. The command is held until the probes are in place.
import errno, json, os, platform, re, shutil, signal, subprocess, sys, tempfile, threading, time

VERSION = "0.1"
STATE = os.path.join(os.environ.get("XDG_STATE_HOME") or os.path.expanduser("~/.local/state"), "sbx-trace")
HOME = os.path.realpath(os.path.expanduser("~"))
STRLEN = 200                    # longest path bpftrace copies; a path that fills it is counted as unresolved, not kept cut off
START_WAIT = 90                 # seconds to wait for the root helper (a password prompt may be open)
LINE_MAX = 16_384
PATHS_MAX = 20_000              # distinct paths kept; further new ones are only counted
VIEW_MAX = 3000                 # rows per group in a saved report
NOISE = ("/proc", "/sys")       # never shown: their paths are about the kernel, not the program
QUIET = ("/dev", "/run")        # shown only when an attempt failed: a missing /dev/dri or /run/user/UID/wayland-0 is a common reason a program breaks
PROBES = {                      # the system calls that take a path; the older ones don't exist on arm64, and stat/lstat have no tracepoint on newer kernels (glibc uses newfstatat)
    "x86_64": ("open", "openat", "openat2", "newfstatat", "statx", "access", "faccessat", "faccessat2", "execve"),
    "aarch64": ("openat", "openat2", "newfstatat", "statx", "faccessat", "faccessat2", "execve")}
# What else is watched, so that a refused write is seen too. The value is the field that holds the path. The older calls don't exist on arm64.
WRITES = {"unlink": "pathname", "unlinkat": "pathname", "rmdir": "pathname", "mkdir": "pathname", "mkdirat": "pathname", "creat": "pathname",
          "mknod": "filename", "mknodat": "filename", "chmod": "filename", "fchmodat": "filename", "fchmodat2": "filename", "chown": "filename",
          "lchown": "filename", "fchownat": "filename", "truncate": "path", "utimensat": "filename",
          "rename": "newname", "renameat": "newname", "renameat2": "newname", "symlink": "newname", "symlinkat": "newname", "link": "newname", "linkat": "newname"}
NEWNAME = {c for c, f in WRITES.items() if f == "newname"}                # the path is what a rename or link creates: a missing old name must not count against it
READS = {"readlink": "path", "readlinkat": "pathname"}                    # a look at a link: a probe
LEGACY = {"unlink", "rmdir", "mkdir", "creat", "mknod", "chmod", "chown", "lchown", "rename", "symlink", "link", "readlink"}
FIELD = {**WRITES, **READS}                                                # every other call keeps its path in "filename"
KIND = {"open": "o", "openat": "o", "openat2": "o", "execve": "x"}       # a write is w (n for the new name of a rename or link), every other call is a probe: p
FLAGS = {"open": "args->flags", "openat": "args->flags"}                  # openat2 keeps its flags in a struct (RICH_FLAGS); without them it is counted as a read
RICH_FLAGS = {"openat2": "args->how->flags"}                              # checked on kernel 7.3 with bpftrace 0.26; the basic set does not use it, so it can fall back without
USAGE = ("usage: sbx-trace [--json] [--host] [--limit N] [--] COMMAND [args]   |   sbx-trace --last [NAME] [--json] [--limit N]"
         "   |   sbx-trace --suggest [NAME] [--json] [--limit N]   |   sbx-trace --diff [NAME] [--json] [--limit N]")
VERSION_OF_REPORT = 1           # saved in every report, so a later change to what a report holds can be told from this one
SENSITIVE = (".ssh", ".gnupg", ".aws", ".kube", ".password-store", ".local/share/keyrings", ".config/gcloud", ".netrc", ".git-credentials")   # never suggested
USER_DIRS = ("Downloads", "Desktop", "Documents", "Pictures", "Music", "Videos", "Public", "Templates")      # too broad to suggest, like sbx's own folder rule
WHY = {"denied": "access was refused", "read-only": "it tried to write there", "hidden": "the sandbox hides it"}
CTRL = re.compile(r"[\x00-\x1f\x7f-\x9f]")


def die(msg, code=1):
    print(f"sbx-trace: {msg}", file=sys.stderr); sys.exit(code)


def safe(s):
    """S for a terminal: control characters (a program chooses its own file names) become '?'."""
    return CTRL.sub("?", s)


# ---------------------------------------------------------------- the bpftrace program
def kind_of(call):
    return KIND.get(call) or ("n" if call in NEWNAME else "w" if call in WRITES else "p")


def calls(machine, have=None):
    """The system calls to watch on MACHINE: the ones that open or look at a path, then the writes and link reads. HAVE, when known, is the set
    of system calls this kernel has; one it lacks has no tracepoint, and bpftrace refuses the whole program for a missing one, so it is left out.
    The first group is always kept: it is known to work."""
    extra = [c for c in (*WRITES, *READS) if machine != "aarch64" or c not in LEGACY]
    return list(PROBES[machine]) + [c for c in extra if have is None or c in have]


def kernel_calls(machine, path="/proc/kallsyms"):
    """The names of the system calls this kernel has (from its symbols, which any user can read), or None when that can't be told."""
    prefix = {"x86_64": "__x64_sys_", "aarch64": "__arm64_sys_"}.get(machine)
    out = set()
    try:
        with open(path, errors="replace") as f:
            for line in f:
                p = line.split()
                if prefix and len(p) >= 3 and p[2].startswith(prefix): out.add(p[2][len(prefix):])
    except OSError:
        return None
    return out or None


def script(machine, sandbox_only=True, names=None, rich=True):
    """$1 is the host thread id of the process we started, $2 a random number that starts every line the program prints (so a file name
    with a newline in it can't forge a line). It follows that process and everything it starts, keeps only tasks inside a new pid
    namespace when SANDBOX_ONLY, and ends when the first process does. NAMES are the system calls to watch (calls(MACHINE) when None); RICH
    also reads what a call keeps in a struct (the flags of openat2).
    Lines: TOKEN <tab> o|p|x|w|n <tab> thread <tab> result <tab> open flags <tab> path. The token is printed with %llu: bpftrace 0.26 prints %u as 32 bits, which cut the token short."""
    inside = " && ((struct task_struct *)curtask)->thread_pid->level >= 1" if sandbox_only else ""
    gone = "delete(@t[tid]); delete(@c[tid]); delete(@p[tid]); delete(@f[tid]);"
    out = ['BEGIN { @t[(uint64)$1] = 1; printf("%llu\\tREADY\\n", $2); }',
           'tracepoint:sched:sched_process_fork /@t[(uint64)args->parent_pid]/ { @t[(uint64)args->child_pid] = 1; }',
           f'tracepoint:sched:sched_process_exit /@t[tid]/ {{ {gone} if (tid == (uint64)$1) {{ exit(); }} }}']
    for c in names if names is not None else calls(machine):
        out.append(f'tracepoint:syscalls:sys_enter_{c} /@t[tid]{inside}/ {{ @c[tid] = 1; @p[tid] = str(args->{FIELD.get(c, "filename")}); @f[tid] = {({**FLAGS, **RICH_FLAGS} if rich else FLAGS).get(c, "-1")}; }}')
        out.append(f'tracepoint:syscalls:sys_exit_{c} /@c[tid]/ {{ printf("%llu\\t{kind_of(c)}\\t%d\\t%d\\t%d\\t%s\\n", $2, tid, args->ret, @f[tid], @p[tid]); delete(@c[tid]); }}')
    out.append("END { clear(@t); clear(@c); clear(@p); clear(@f); }")
    return "\n".join(out)


# ---------------------------------------------------------------- reading what it prints
class Trace:
    """Reads bpftrace's lines one by one (feed) and keeps only counts per path, however much the program does:
    paths -> {r, w, p, x: reads, writes, probes, execs; err: {ERRNO: n}}. A path that isn't absolute (relative to a directory descriptor
    or the working directory) can't be told from here: it is counted in unresolved."""

    def __init__(self, token=0):
        self.token = str(token)
        self.paths, self.pids = {}, set()
        self.lines = self.dropped = self.unresolved = self.lost = 0      # lost: events bpftrace says it dropped, so the report is incomplete
        self.ready, self.helper = threading.Event(), threading.Event()      # helper: the root helper started (so a failure after it is bpftrace's own)

    def feed(self, line):
        if len(line) > LINE_MAX: return
        f = line.split("\t", 5)
        if len(f) < 2 or f[0] != self.token: return                  # bpftrace's own messages, or the rest of a name that had a newline in it
        if f[1] == "READY": self.ready.set(); return
        if f[1] == "HELPER": self.helper.set(); return
        if len(f) != 6 or f[1] not in ("o", "p", "x", "w", "n") or not f[5]: return
        try: tid, ret, flags = int(f[2]), int(f[3]), int(f[4])
        except ValueError: return
        if len(self.pids) < 100_000: self.pids.add(tid)
        self.lines += 1
        path = f[5]
        if not path.startswith("/") or len(os.fsencode(path)) >= STRLEN - 1: self.unresolved += 1; return
        path = os.path.normpath(path)
        if path.startswith("//"): path = "/" + path.lstrip("/")
        key = {"p": "p", "x": "x", "w": "w", "n": "w"}.get(f[1]) or ("w" if flags >= 0 and (flags & 3 or flags & 0o3100) else "r")      # O_WRONLY|O_RDWR, O_CREAT|O_TRUNC|O_APPEND
        benign = f[1] in ("w", "n") and -ret in ((errno.EEXIST, errno.ENOENT) if f[1] == "n" else (errno.EEXIST,))    # mkdir of what is there; the old name of a rename is what was missing
        self.record(path, key, ret < 0 and not benign, errno.errorcode.get(-ret, "E?") if ret < 0 else None)

    def record(self, path, key, failed, err):
        c = self.paths.get(path)
        if c is None:
            if len(self.paths) >= PATHS_MAX: self.dropped += 1; return
            c = self.paths[path] = {}
        c[key] = c.get(key, 0) + 1
        if failed:
            e = c.setdefault("err", {}); k = err or "E?"; e[k] = e.get(k, 0) + 1

    def read_pipe(self, f):
        """Read bpftrace's output from F (binary) until it closes. The line length is bounded, so one endless line can't fill memory."""
        try:
            while True:
                raw = f.readline(LINE_MAX + 1)
                if not raw: break
                if len(raw) > LINE_MAX and not raw.endswith(b"\n"):
                    while raw and not raw.endswith(b"\n"): raw = f.readline(LINE_MAX)
                    continue
                self.feed(raw.decode("utf-8", "surrogateescape").rstrip("\n"))
        except (OSError, ValueError):
            pass


# ---------------------------------------------------------------- the report
def view(tr, host=False):
    """The trace sorted into what a person wants to know. blocked: paths the program was refused (denied, read-only) or, in a sandbox,
    could not find although the host has them (hidden). Rows: path, counts (r w p x) and errors."""
    groups, blocked, checked = {"home": [], "system": [], "noise": []}, [], 0
    for path, c in tr.paths.items():
        errs = c.get("err", {})
        under = lambda dirs: path in dirs or path.startswith(tuple(x + "/" for x in dirs))
        noise = under(NOISE) or (under(QUIET) and not errs)
        groups["noise" if noise else "home" if path.startswith(HOME + "/") else "system"].append({"path": path, **{k: c[k] for k in "rwpx" if k in c}, "err": errs})
        kind = "denied" if errs.get("EACCES") or errs.get("EPERM") else "read-only" if errs.get("EROFS") else None
        if kind is None and errs.get("ENOENT") and not host and not under(NOISE) and checked < 2000:
            checked += 1
            if os.path.lexists(path): kind = "hidden"                 # the host has something there and the program found nothing: the sandbox hid it
        if kind: blocked.append({"path": path, "kind": kind, "n": sum(errs.get(e, 0) for e in ("EACCES", "EPERM", "EROFS", "ENOENT")) or 1})
    weight = lambda r: -sum(r.get(k, 0) for k in "rwpx")
    out = {g: {"total": len(rows), "rows": sorted(rows, key=lambda r: (weight(r), r["path"]))[:VIEW_MAX]} for g, rows in groups.items()}
    out["blocked"] = sorted(blocked, key=lambda r: (r["kind"] != "denied", -r["n"], r["path"]))[:VIEW_MAX]
    out["info"] = {"calls": tr.lines, "processes": len(tr.pids), "dropped": tr.dropped, "unresolved": tr.unresolved, "lost": tr.lost, "host": host}
    return out


def tilde(p):
    return "~/" + p[len(HOME) + 1:] if p.startswith(HOME + "/") else p


# ---------------------------------------------------------------- suggestions
def sensitive(path):
    """Is PATH in your home a place that holds secrets, or a folder that holds one (~/.local/share holds the keyrings)?"""
    if not path.startswith(HOME + "/"): return False
    rel = path[len(HOME) + 1:]
    return any(rel == s or rel.startswith(s + "/") or s.startswith(rel + "/") for s in SENSITIVE)


def shared_by(name):
    """The paths already shared by default.conf and apps/NAME.conf (whitelist= and read_only=), absolute."""
    out, name = [], re.sub(r"[^A-Za-z0-9._-]", "_", name)
    for f in ("default.conf", f"apps/{name}.conf"):
        try:
            with open(f"{HOME}/.config/sbx/{f}", errors="replace") as fh: lines = fh.read().splitlines()
        except OSError:
            continue
        for line in lines:
            k, _, val = (x.strip() for x in re.sub(r"(^|\s)#.*$", "", line).partition("="))
            if k in ("whitelist", "read_only") and val: out.append(os.path.normpath(HOME + val[1:] if val.startswith("~/") else val))
    return out


def suggest(v, shared=()):
    """Settings for what the program was refused or could not find, as {lines: [{setting, value, path, why, n}], skipped: [{path, why}],
    outside: paths no folder setting is suggested for}. The narrowest setting that works: the path itself, never its folder, read-only unless
    the program tried to write; and never your home, Downloads and the like, the folders sbx keeps away, or anything that holds secrets.
    A path that is already shared, or inside a path suggested earlier, is left out. These are for you to read: that a sandbox hides a
    path is often just what you want."""
    blocked = v.get("blocked") if isinstance(v, dict) else None
    rows = {r["path"]: r for g in ("home", "system") for r in (v.get(g) or {}).get("rows", []) if isinstance(r, dict) and isinstance(r.get("path"), str)} if blocked else {}
    roots = (HOME, "/mnt", "/media", "/srv")
    generic = set(roots) | {f"{HOME}/{d}" for d in USER_DIRS}
    own = (f"{HOME}/.sbx-homes", f"{HOME}/.config/sbx")
    under = lambda p, d: p == d or p.startswith(d + "/")
    lines, skipped, outside = [], [], 0
    for b in blocked or []:
        if not isinstance(b, dict) or not isinstance(b.get("path"), str): continue
        path, kind = b["path"], b.get("kind")
        if not any(under(path, r) for r in roots): outside += 1; continue
        why = ("its name has control characters, spaces at the ends or ' #'" if CTRL.search(path) or path != path.strip() or re.search(r"\s#", path)
               else "sbx keeps its own folders away from programs" if any(under(path, o) for o in own)
               else "too broad: it holds all sorts of things" if path in generic
               else "looks sensitive, or holds something that does" if sensitive(path) else None)
        if why: skipped.append({"path": path, "why": why}); continue
        if any(under(path, s) for s in shared): continue
        key = "whitelist" if kind == "read-only" or (rows.get(path) or {}).get("w") else "read_only"
        if any(under(path, l["path"]) for l in lines if l["setting"] == "whitelist" or key == "read_only"): continue
        lines.append({"setting": key, "value": tilde(path), "path": path, "why": WHY.get(kind, "access failed"), "n": b["n"] if isinstance(b.get("n"), int) else 1})
    return {"lines": lines, "skipped": skipped, "outside": outside}


def show_suggest(name, s, limit):
    print(f"# {name}: settings to try, for what the program was refused or could not find")
    print(f"# Read each line before you add it to ~/.config/sbx/apps/{name}.conf: it gives the program that access.")
    for l in s["lines"][:limit]: print(f"{l['setting']}={safe(l['value'])}   # {l['why']}, {l['n']}x")
    if len(s["lines"]) > limit: print(f"# ... {len(s['lines']) - limit} more (--limit N, or --json)")
    if not s["lines"]: print("# nothing to suggest")
    for k in s["skipped"][:limit]: print(f"# not suggested: {safe(tilde(k['path']))} ({k['why']})")
    if s["outside"]: print(f"# {s['outside']} more blocked path{'s' if s['outside'] != 1 else ''} outside your home, /mnt, /media and /srv: no suggestion for {'those' if s['outside'] != 1 else 'it'}")


def diff(old, new):
    """What changed between two reports of the same program: blocked paths that no longer are (and what the program did with them now: works,
    fails another way, or was not touched), paths newly blocked, and the paths only one of the runs touched (not the noise or what a report
    does not keep)."""
    touched = lambda v: {r["path"]: r for g in ("home", "system") for r in (v.get(g) or {}).get("rows", []) if isinstance(r, dict) and isinstance(r.get("path"), str)}
    blocked = lambda v: {b["path"]: b for b in v.get("blocked") or [] if isinstance(b, dict) and isinstance(b.get("path"), str)}
    ob, nb, orow, nrow = blocked(old), blocked(new), touched(old), touched(new)
    fixed = [{"path": p, "now": "not touched" if p not in nrow else "fails another way" if nrow[p].get("err") else "works"} for p in ob if p not in nb]
    return {"fixed": fixed, "new_blocked": [b for p, b in nb.items() if p not in ob], "still_blocked": sum(1 for p in nb if p in ob),
            "added": [p for p in nrow if p not in orow], "removed": [p for p in orow if p not in nrow]}


def when(v):
    t = v.get("time")
    try: return time.strftime("%Y-%m-%d %H:%M", time.localtime(t)) if isinstance(t, (int, float)) else "?"
    except (ValueError, OverflowError, OSError): return "?"


def show_diff(old, new, d, limit):
    print(f"{new.get('name', '?')}: this run ({when(new)}) compared with the one before it ({when(old)})")
    for title, rows in (("no longer blocked", [f"{safe(tilde(x['path']))}   {x['now']}" for x in d["fixed"]]),
                        ("newly blocked", [f"{x.get('kind', '?'):<9} {safe(tilde(x['path']))}" for x in d["new_blocked"]])):
        print(f"{title} ({len(rows)}):")
        for r in rows[:limit]: print(f"  {r}")
        if len(rows) > limit: print(f"  ... {len(rows) - limit} more (--limit N, or --json)")
        if not rows: print("  nothing")
    print(f"still blocked: {d['still_blocked']}")
    print(f"touched only in this run: {len(d['added'])}, only in the one before: {len(d['removed'])} (--json lists them)")


def show(v, limit):
    i = v["info"]
    print(f"{v.get('name', '?')}: {i['calls']} file calls from {i['processes']} threads" + (f", {i['dropped']} paths not kept (too many)" if i["dropped"] else "") +
          (f", {i['unresolved']} relative or very long paths not listed" if i["unresolved"] else ""))
    if i.get("lost"): print(f"warning: bpftrace lost {i['lost']} events, so this report is incomplete")
    print(f"blocked ({len(v['blocked'])}): refused, or hidden by the sandbox")
    for b in v["blocked"][:limit]: print(f"  {b['kind']:<9} {safe(tilde(b['path']))}   {b['n']}x")
    if not v["blocked"]: print("  nothing")
    print("r read, w write, p probe (stat/access), x run")
    for g, title in (("home", "your home"), ("system", "the system")):
        grp = v[g]
        print(f"{title} ({grp['total']}):")
        for r in grp["rows"][:limit]:
            counts = " ".join(f"{k}{r[k]}" for k in "rwpx" if k in r)
            errs = ", ".join(f"{e} x{n}" for e, n in r["err"].items())
            print(f"  {safe(tilde(r['path']))}   {counts}" + (f"   [{errs}]" if errs else ""))
        if grp["total"] > limit: print(f"  ... {grp['total'] - limit} more (--limit N, or --json)")
    print(f"/proc, /sys, and /dev and /run without errors: {v['noise']['total']} paths not shown")


def report_path(name):
    return os.path.join(STATE, f"{name}.json")


def previous_path(name):
    return os.path.join(STATE, "previous", f"{name}.json")


def save(name, v):
    """Save V as the report of NAME. The one it replaces is kept as the previous one (see diff); failing to keep it never stops the save."""
    os.makedirs(STATE, mode=0o700, exist_ok=True)
    tmp = f"{report_path(name)}.tmp{os.getpid()}"
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
    try:
        with os.fdopen(fd, "w") as f: json.dump(v, f)
        try:
            os.makedirs(os.path.dirname(previous_path(name)), mode=0o700, exist_ok=True)
            os.replace(report_path(name), previous_path(name))
        except OSError:
            pass
        os.replace(tmp, report_path(name))
    except BaseException:
        try: os.unlink(tmp)
        except OSError: pass
        raise


def name_of(cmd):
    """A short name for the report: the program, or for `sbx [options] PROGRAM` the program sbx runs."""
    first = os.path.basename(cmd[0])
    if first == "sbx":
        rest = [a for a in cmd[1:] if not a.startswith("-")]
        if rest: first = os.path.basename(rest[0])
    return re.sub(r"[^A-Za-z0-9._-]", "_", first)[:64] or "command"


# ---------------------------------------------------------------- running
def support():
    """((how to get root, path of bpftrace), why not)."""
    if platform.machine() not in PROBES: return None, f"no list of system calls for {platform.machine()}"
    exe = shutil.which("bpftrace")
    if not exe: return None, "bpftrace is missing (install the 'bpftrace' package)"
    if not os.path.exists("/sys/kernel/btf/vmlinux"): return None, "this kernel has no BTF (/sys/kernel/btf/vmlinux), which the trace needs"
    esc = shutil.which("sudo") if sys.stdin.isatty() else shutil.which("pkexec")
    esc = esc or shutil.which("pkexec") or shutil.which("sudo")
    if not esc: return None, "tracing needs root: install sudo or polkit (pkexec)"
    return (esc, exe), ""


WRAP = 'printf "%s\\tHELPER\\n" "$1"; shift; exec "$@"'                   # as root: say so (so a refused password is told from a refused program), then become bpftrace
HOLD = "import os,sys;f=int(sys.argv[1]);os.read(f,1);os.close(f);os.execvp(sys.argv[2],sys.argv[2:])"      # wait for the helper, then become the command


def lost_events(f, cap=50_000):
    """How many events bpftrace says it lost, from what it wrote to F (its stderr). At most CAP lines are read."""
    n = 0
    try:
        f.seek(0)
        for i, line in enumerate(f):
            if i >= cap: break
            m = re.search(rb"Lost (\d+) events", line)
            if m: n += int(m.group(1))
    except (OSError, ValueError):
        pass
    return n


def tail_of(f):
    try:
        f.seek(0)
        lines = f.read(4000).decode("utf-8", "replace").strip().splitlines()
        return safe(lines[-1]) if lines else ""
    except (OSError, ValueError):
        return ""


class Rejected(Exception):
    """bpftrace itself started and then refused the program (a probe or field it doesn't have). The command was not run."""


def fail_text(why):
    return "the trace did not start" + (f": {why}" if why else "")


def start(cmd, host, helper, names, rich=True):
    """Run CMD with the helper watching the system calls NAMES. Returns (exit code, Trace). Dies, without running CMD, when the helper can't
    start; raises Rejected when bpftrace ran and refused the program."""
    esc, exe = helper
    token = str(int.from_bytes(os.urandom(7), "big"))
    tr = Trace(token)
    r, w = os.pipe()
    stopped, child = [False], [None]
    def stop(*_):
        stopped[0] = True
        if child[0]: child[0].terminate()
    for sg in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP): signal.signal(sg, stop)
    try: p = child[0] = subprocess.Popen([sys.executable, "-c", HOLD, str(r)] + cmd, pass_fds=[r])
    except OSError as e: die(f"can't start {cmd[0]}: {e.strerror or e}")
    os.close(r)
    errf, proc, th = tempfile.TemporaryFile(), None, None
    print(f"sbx-trace: starting bpftrace with {os.path.basename(esc)} (needs root)", file=sys.stderr)
    try:
        argv = [esc, shutil.which("sh") or "/bin/sh", "-c", WRAP, "sh", token, shutil.which("env") or "/usr/bin/env", f"BPFTRACE_STRLEN={STRLEN}", exe, "-e",
                script(platform.machine(), not host, names, rich), str(p.pid), token]
        proc = subprocess.Popen(argv, stdin=None if sys.stdin.isatty() else subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=errf)
        th = threading.Thread(target=tr.read_pipe, args=(proc.stdout,), daemon=True); th.start()
        end = time.time() + START_WAIT
        while not tr.ready.wait(0.2):
            if proc.poll() is not None or stopped[0] or time.time() > end: break
    except OSError as e:
        errf.write(str(e.strerror or e).encode())
    if not tr.ready.is_set():
        ended = proc is not None and proc.poll() is not None
        if ended and th: th.join(2)                                 # its last lines (the helper's) may still be on the way
        p.kill(); p.wait(); os.close(w)
        if proc and proc.poll() is None:
            try: proc.terminate()
            except OSError: pass
        why = tail_of(errf); errf.close()
        if proc and proc.stdout: proc.stdout.close()
        if ended and tr.helper.is_set() and not stopped[0]: raise Rejected(why)
        die(fail_text(why) + (" (interrupted)" if stopped[0] else ""))
    os.write(w, b"1"); os.close(w)
    rc = p.wait()
    th.join(10)                                                     # the helper ends by itself when the first process is gone
    if proc.poll() is None:
        try: proc.terminate()                                       # (a root process may refuse; it ends on its own)
        except OSError: pass
    tr.lost = lost_events(errf)
    errf.close(); proc.stdout.close()
    return (128 - rc if rc < 0 else rc), tr


def trace(cmd, host=False):
    """Run CMD with the helper attached. Returns (exit code, Trace). Dies, without running CMD, when the helper can't start. Should bpftrace
    refuse the larger set of system calls (a field or tracepoint this kernel lacks), CMD has not run yet, so it is tried again with the basic set."""
    helper, why = support()
    if not helper: die(f"can't trace here: {why}")
    machine = platform.machine()
    basic, full = list(PROBES[machine]), calls(machine, kernel_calls(machine))
    try: return start(cmd, host, helper, full)
    except Rejected as e:
        if full == basic: die(fail_text(str(e)))
        print(f"sbx-trace: bpftrace did not accept every probe ({safe(str(e)) or 'no message'}); trying again with the basic set, which sees no writes and takes no flags from openat2", file=sys.stderr)
    try: return start(cmd, host, helper, basic, rich=False)
    except Rejected as e: die(fail_text(str(e)))


def main(argv):
    flags, limit, last, ask, cmp, i = set(), 40, False, False, False, 0
    while i < len(argv) and argv[i].startswith("-") and argv[i] != "--":
        a = argv[i]
        if a in ("--json", "--host"): flags.add(a)
        elif a == "--last": last = True
        elif a == "--suggest": last = ask = True
        elif a == "--diff": last = cmp = True
        elif a == "--limit":
            if i + 1 >= len(argv) or not (argv[i + 1].isascii() and argv[i + 1].isdigit()): die(f"--limit needs a number\n{USAGE}")
            limit = int(argv[i + 1]); i += 1
        elif a in ("-h", "--help"): print(USAGE); return 0
        elif a == "--version": print(f"sbx-trace {VERSION}"); return 0
        else: die(f"unknown option {a}\n{USAGE}")
        i += 1
    rest = argv[i + 1:] if i < len(argv) and argv[i] == "--" else argv[i:]
    if last:
        names = sorted((n for n in os.listdir(STATE) if n.endswith(".json")), key=lambda n: -os.stat(os.path.join(STATE, n)).st_mtime) if os.path.isdir(STATE) else []
        name = re.sub(r"[^A-Za-z0-9._-]", "_", rest[0]) if rest else (names[0][:-5] if names else None)
        if name is None: die("no report yet: sbx-trace -- COMMAND")
        try:
            with open(report_path(name)) as f: v = json.load(f)
        except (OSError, ValueError, TypeError): die("no report yet: sbx-trace -- COMMAND")
    else:
        if not rest: die(USAGE)
        if os.geteuid() == 0: die("run it as your own user, not root: it asks for root itself")
        rc, tr = trace(rest, "--host" in flags)
        v = view(tr, "--host" in flags); v["version"] = VERSION_OF_REPORT; v["name"] = name_of(rest); v["command"] = rest; v["exit"] = rc; v["time"] = time.time()
        try: save(v["name"], v)
        except OSError as e: print(f"sbx-trace: could not save the report: {e.strerror or e}", file=sys.stderr)
    if cmp:
        try:
            with open(previous_path(re.sub(r"[^A-Za-z0-9._-]", "_", str(v.get("name"))))) as f: old = json.load(f)
        except (OSError, ValueError): die(f"no earlier report of {safe(str(v.get('name')))} to compare with: trace it again first")
        d = diff(old, v)
        if "--json" in flags: print(json.dumps({"name": v.get("name"), "time": v.get("time"), "before": old.get("time"), **d}))
        else: show_diff(old, v, d, limit)
        return 0
    if ask:
        name = v.get("name") if isinstance(v.get("name"), str) and v["name"] else "command"
        s = suggest(v, shared_by(name))
        if "--json" in flags: print(json.dumps({"name": name, **s}))
        else: show_suggest(name, s, limit)
        return 0
    if "--json" in flags: print(json.dumps(v))
    else: show(v, limit)
    return v.get("exit", 0) if not last else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
