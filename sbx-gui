  <path d="M64 24 L94 36 V62 C94 80 81 94 64 102 C47 94 34 80 34 62 V36 Z" fill="#fff" opacity=".95"/>
  <rect x="50" y="58" width="28" height="22" rx="4" fill="#3584e4"/>
  <path d="M55 58 V51 a9 9 0 0 1 18 0 V58" fill="none" stroke="#3584e4" stroke-width="5"/>
</svg>
"""


RUNNING = HOME + "/.local/state/sbx/running"      # written by sbx: RUNNING/PID holds "NAME\nSTARTTIME"


def live_sbx(pid):
    """True if this PID is really an sbx process (same rule as sbx): started as `sbx` or `python3 sbx`, or through a link made by `sbx link`."""
    try:
        with open(f"/proc/{pid}/cmdline", "rb") as f: argv = [x.decode(errors="replace") for x in f.read().split(b"\0") if x]
        cwd = os.readlink(f"/proc/{pid}/cwd")
    except OSError:
        return False
    def is_link(p):
        try: return os.path.islink(p) and os.path.basename(os.readlink(p)) == "sbx"
        except OSError: return False
    return any(os.path.basename(x) == "sbx" or is_link(os.path.join(cwd, x)) for x in argv[:3])


def program_running(name):
    """True if an sbx process is running NAME. A file counts only if the process under that PID is the one that wrote it
    (same start time), so a reused PID doesn't make a program look busy."""
    try: pids = [f for f in os.listdir(RUNNING) if f.isdigit()]
    except OSError: return False
    for pid in pids:
        try:
            with open(f"{RUNNING}/{pid}") as f: who, _, start = f.read().partition("\n")
            with open(f"/proc/{pid}/stat", "rb") as f: now = f.read().rsplit(b")", 1)[1].split()[19].decode()
        except (OSError, IndexError, UnicodeDecodeError):
            continue
        if who.strip() == name and start.strip() == now and live_sbx(pid): return True
    return False


LAUNCHES = [0]


def unit_name(name):
    """A systemd unit name for one start from this window. Each start gets its own, so "Launch" while the program runs can start another copy."""
    LAUNCHES[0] += 1
    return f"sbx-{name}-{os.getpid()}-{LAUNCHES[0]}"


def doctor_text():
    """What `sbx doctor` prints (it can take a while: call it off the UI thread)."""
    try:
        r = subprocess.run([sbx_cmd(), "doctor"], capture_output=True, text=True, timeout=20)
        return (r.stdout + r.stderr).strip() or "No output. Is sbx installed?"
    except (OSError, subprocess.TimeoutExpired) as e:
        return f"Couldn't run sbx doctor: {e}"


def use_window_icon():
    """Give the window its icon even when 'Show sbx in the app menu' is off: the SVG goes into a private icon folder in the
    cache (nothing in your own icon folders) and becomes the default icon of every window. A dock on Wayland still needs the
    menu entry to show it, because it looks the icon up through the launcher file."""
    try:
        base = (os.environ.get("XDG_CACHE_HOME") or HOME + "/.cache") + "/sbx/icons"
        svg = base + "/hicolor/scalable/apps/org.sbx.Gui.svg"
        if not os.path.isfile(svg):
            os.makedirs(os.path.dirname(svg), exist_ok=True)
            with open(svg + ".tmp", "w") as f: f.write(MENU_SVG)
            os.replace(svg + ".tmp", svg)
        display = Gdk.Display.get_default()
        if display is None: return
        Gtk.IconTheme.get_for_display(display).add_search_path(base)
        Gtk.Window.set_default_icon_name("org.sbx.Gui")
    except (OSError, GLib.Error):
        pass


def menu_entry_exists():
    return os.path.isfile(MENU_DESKTOP)


def menu_exec():
    """The installed sbx-gui the launcher should start. Only a root-owned copy that nobody else can write to counts, so a
    program running as you can't swap the launcher's target for its own code; a copy in your home or the download folder
    never does."""
    for d in ("/usr/local/bin", "/usr/bin"):
        path = d + "/sbx-gui"
        try: st = os.stat(path)
        except OSError: continue
        if st.st_uid == 0 and not st.st_mode & 0o022: return path
    raise OSError(errno.ENOENT, "Install sbx-gui first: sudo install -m755 sbx-gui /usr/local/bin/")


def set_menu_entry(on):
    """Add or remove sbx-gui's own launcher in the user's app menu (the launcher file needs no root)."""
    if on:
        entry = MENU_ENTRY.replace("@EXEC@", menu_exec())
        os.makedirs(os.path.dirname(MENU_DESKTOP), exist_ok=True)
        os.makedirs(os.path.dirname(MENU_ICON), exist_ok=True)
        for path, text in ((MENU_ICON, MENU_SVG), (MENU_DESKTOP, entry)):
            with open(path + ".tmp", "w") as f: f.write(text)
            os.replace(path + ".tmp", path)
    else:
        for path in (MENU_DESKTOP, MENU_ICON):
            try: os.unlink(path)
            except OSError: pass
    if shutil.which("update-desktop-database"):
        subprocess.run(["update-desktop-database", os.path.dirname(MENU_DESKTOP)], stderr=subprocess.DEVNULL, timeout=10)


def launcher_is_ours(name):
    """True if a launcher in ~/.local/share/applications made by `sbx desktop` belongs to NAME: NAME.desktop, *.NAME.desktop (the name
    kept from the system launcher, e.g. org.mozilla.firefox for firefox), or one that starts a program called NAME (google-chrome.desktop
    for google-chrome-stable)."""
    d = f"{HOME}/.local/share/applications"
    for path in [f"{d}/{name}.desktop"] + sorted(glob.glob(f"{d}/*.{name}.desktop")) + sorted(glob.glob(f"{d}/*.desktop")):
        try:
            with open(path, errors="replace") as f: text = f.read()
        except OSError: continue
        if "X-Sbx-Sandboxed=true" not in text: continue
        if os.path.basename(path) == f"{name}.desktop" or path.endswith(f".{name}.desktop") or launcher_program(text) == name: return True
    return False


def launcher_program(text):
    """The program the main Exec= line of a .desktop file starts, past a leading sbx (same rule as sbx's own launcher matching)."""
    group = ""
    for line in text.splitlines():
        if line.startswith("["): group = line
        elif group == "[Desktop Entry]" and line.startswith("Exec="):
            try: w = shlex.split(line[5:])
            except ValueError: return None
            if w and os.path.basename(w[0]) == "sbx":
                w = w[1:]
                while w and w[0].startswith("--app-id="): w = w[1:]
            return os.path.basename(w[0]) if w else None
    return None


def link_is_ours(name):
    """True if ~/.local/bin/NAME is a link made by `sbx link`."""
    p = f"{HOME}/.local/bin/{name}"
    try: return os.path.islink(p) and os.path.basename(os.readlink(p)) == "sbx"
    except OSError: return False


def dir_size(path):
    """A folder's size for a row ('12M'): 'none yet' when it is not there, 'unknown' when du can't say within 5 seconds."""
    if not os.path.isdir(path): return "none yet"
    try: r = subprocess.run(["du", "-sh", path], capture_output=True, text=True, timeout=5)
    except (OSError, subprocess.SubprocessError): return "unknown"
    return (r.stdout.split() or ["unknown"])[0]


UNUSED_BYTES = 64 * 1024        # same rule as `sbx clean --unused`


def home_is_small(name, limit=UNUSED_BYTES):
    """True if the private home holds at most LIMIT bytes in files (links are not followed; a folder that can't be read counts as not small)."""
    total, unreadable = 0, []
    for d, _dirs, files in os.walk(f"{HOMES}/{name}", onerror=unreadable.append):
        for f in files:
            try: total += os.lstat(f"{d}/{f}").st_size
            except OSError: unreadable.append(f)
            if total > limit or unreadable: return False
    return not unreadable


def linked_programs():
    """Names with an sbx link in ~/.local/bin."""
    d = f"{HOME}/.local/bin"
    try: return {program_name(n) for n in os.listdir(d) if os.path.islink(f"{d}/{n}") and os.path.basename(os.readlink(f"{d}/{n}")) == "sbx"}
    except OSError: return set()


def launcher_programs():
    """Names an sbx launcher in ~/.local/share/applications starts or is called after."""
    names = set()
    for p in glob.glob(f"{HOME}/.local/share/applications/*.desktop"):
        try:
            with open(p, errors="replace") as f: text = f.read()
        except OSError: continue
        if "X-Sbx-Sandboxed=true" not in text: continue
        stem = os.path.basename(p)[:-8]
        names.update(program_name(x) for x in (launcher_program(text), stem, stem.rsplit(".", 1)[-1]) if x)
    return names


def covered_programs():
    """Names with an sbx link in ~/.local/bin or an sbx launcher in ~/.local/share/applications: somebody set those up on purpose."""
    return linked_programs() | launcher_programs()


# ---- where a program comes from (origins/NAME, written by sbx; the same reading rules as sbx's read_origin) ----
ORIGIN_META = re.compile(r"(\d+) (\d+) ([0-9a-f]{64})")


def read_origin(name):
    """(path, (size, mtime_ns, sha256) or None, moved-from path or None) from origins/NAME, or None when nothing is recorded."""
    try:
        with open(f"{CONF}/origins/{name}", errors="replace") as f: lines = f.read().split("\n")
    except OSError:
        return None
    path = lines[0].strip()
    if not path: return None
    m = ORIGIN_META.fullmatch(lines[1].strip()) if len(lines) > 1 else None
    moved = lines[2][5:].strip() if len(lines) > 2 and lines[2].startswith("from ") else None
    return path, ((int(m[1]), int(m[2]), m[3]) if m else None), moved or None


def downloads_dir():
    """Your Downloads folder: XDG_DOWNLOAD_DIR in user-dirs.dirs (translated names), else ~/Downloads."""
    try:
        with open(f"{os.environ.get('XDG_CONFIG_HOME') or HOME + '/.config'}/user-dirs.dirs") as f:
            m = re.search(r'^XDG_DOWNLOAD_DIR="(?:\$HOME|' + re.escape(HOME) + r')/?([^"]*)"', f.read(), re.M)
        if m and m[1]: return f"{HOME}/{m[1]}".rstrip("/")
    except OSError:
        pass
    return f"{HOME}/Downloads"


def source_kind(path):
    """System (/usr, /opt, /snap...), Downloaded (inside your Downloads folder), Home (the rest of your home) or Other."""
    if path.startswith(SYSTEM_PROGRAMS): return "System"
    if path.startswith(downloads_dir() + "/"): return "Downloaded"
    return "Home" if path.startswith(HOME + "/") else "Other"


def origin_source(name):
    """Where NAME's program comes from, as recorded: {kind, path, missing, moved, moved_exists}, or None when nothing is recorded."""
    rec = read_origin(name)
    if not rec: return None
    path, _meta, moved = rec
    return {"kind": source_kind(path), "path": path, "missing": not os.path.isfile(path), "moved": moved,
            "moved_exists": bool(moved and os.path.isfile(moved))}


def source_parts(s):
    """The pieces of a source line, as shown in a list row: 'System · /usr/bin', 'Downloaded · ~/Downloads/Crash', 'Missing: ~/old/path',
    then 'moved from ...' (or 'copied from ...' while the original is still there)."""
    parts = [f"Missing: {tilde(s['path'])}" if s["missing"] else f"System · {os.path.dirname(s['path'])}" if s["kind"] == "System"
             else f"{s['kind']} · {tilde(s['path'])}"]
    if s["moved"]: parts.append(f"{'copied' if s['moved_exists'] else 'moved'} from {tilde(s['moved'])}")
    return parts


def source_tags(name, linked=None, menu=None):
    """'link' and 'menu' for the ways a program is started through sbx besides the window (the two sets may be passed in, to look them up once for a whole list)."""
    linked = linked_programs() if linked is None else linked
    menu = launcher_programs() if menu is None else menu
    return [t for t, names in (("link", linked), ("menu", menu)) if name in names]


# ---- decisions waiting for you (pending/NAME, written by sbx; same rules as sbx's read_pending and pending_stale) ----
def read_pending(name):
    """{old, new, rule, reason} from pending/NAME, or None."""
    try:
        with open(f"{CONF}/pending/{name}", errors="replace") as f: text = f.read()
    except OSError:
        return None
    d = {}
    for line in text.split("\n"):
        k, eq, v = line.partition("=")
        if eq and k in ("old", "new", "rule", "reason"): d[k] = v
    return d if d.get("old") and d.get("new") and d.get("rule") in ("c", "d") else None


def pending_stale(name, p):
    """Why the decision P no longer applies, or None while it does."""
    rec = read_origin(name)
    if not rec or rec[0] != p["old"]: return "what the name belongs to has changed since"
    if not os.path.isfile(p["new"]): return f"{tilde(p['new'])} is gone"
    if os.path.isfile(p["old"]) != (p["rule"] == "d"): return f"{tilde(p['old'])} is back" if p["rule"] == "c" else f"{tilde(p['old'])} is gone"
    return None


def pending_decisions():
    """{name: decision} for every decision still waiting (one the situation has moved on from is left out)."""
    try: names = sorted(os.listdir(f"{CONF}/pending"))
    except OSError: return {}
    return {n: p for n in names if NAME_RE.match(n) and (p := read_pending(n)) and not pending_stale(n, p)}


def program_groups():
    """(the programs you set up, the ones only run from the terminal). Set up: a settings file, an sbx link or launcher, or running now.
    The others are just a private home that a run created, as for `sbx curl ...` typed once; System ones come first there, Downloaded last."""
    try: conf = {f[:-5] for f in os.listdir(APPS) if f.endswith(".conf")}
    except OSError: conf = set()
    chosen = conf | covered_programs()
    names = app_names()
    setup = [n for n in names if n in chosen or program_running(n)]
    def rank(n):
        s = origin_source(n)
        return SOURCE_RANK.get(s["kind"], 1) if s else 1, n
    return setup, sorted((n for n in names if n not in setup), key=rank)


def row_subtitle(name, waiting=False, linked=None, menu=None, show_running=True):
    """The second line of a program's row: running (unless the row shows that itself), waiting for a decision, where it comes from, how else it starts, then its settings."""
    s = origin_source(name)
    parts = (["Running now"] if show_running and program_running(name) else []) + (["Waiting for your decision"] if waiting else [])
    shared = len(start_variants(name))
    return " · ".join(parts + (source_parts(s) if s else []) + source_tags(name, linked, menu) + ([f"{shared} programs share this home"] if shared > 1 else []) + [summary(name)])


def unused_programs(others):
    """Of the terminal-only programs, those whose private home is nearly empty."""
    return [n for n in others if os.path.isdir(f"{HOMES}/{n}") and home_is_small(n)]


def which_program(name):
    """The first program of that name in PATH, not counting the links `sbx link` makes (they are how sbx starts, not the program), or None."""
    for d in os.environ.get("PATH", "").split(":"):
        p = os.path.join(d, name) if d else ""
        if p and os.path.isfile(p) and os.access(p, os.X_OK) and not (os.path.islink(p) and os.path.basename(os.readlink(p)) == "sbx"): return p
    return None


def in_path(name):
    """True if PATH holds a program of that name (see which_program)."""
    return which_program(name) is not None


def installed_launcher(name):
    """The launcher file `sbx install` recorded for NAME (a file without the execute bit; sbx sets it for the run), or None."""
    if not NAME_RE.match(name): return None
    try:
        with open(f"{INSTALLED}/{name}") as f: p = f.readline().strip()
    except OSError:
        return None
    return p if p.startswith("/") and os.path.isfile(p) else None


INSTALLED_NOTE = "Added by sbx install: the program’s own files. Remove only if it still starts."


def is_installed(name):
    """True if NAME was made by `sbx install` (its record exists)."""
    return bool(name) and bool(NAME_RE.match(name)) and os.path.isfile(f"{INSTALLED}/{name}")


def is_installed_folder(name, path):
    """True if PATH is ~/Apps/NAME of a program made by `sbx install` (installed/NAME exists): the folder `sbx install` shares so the program finds its own files."""
    if not is_installed(name): return False
    p = HOME + path[1:] if path.startswith("~/") else path
    return os.path.normpath(p) == f"{HOME}/Apps/{name}"


def start_command(name):
    """(the sbx command that starts NAME from the window, or None, and why not). A program made by sbx install starts from the launcher it recorded. A program in your PATH starts by its name. One that is not (a
    downloaded game) starts from the file sbx recorded for it, as `sbx open` does when you use Open With; a name that was given with --name
    keeps it. When that file is gone there is nothing to start: run it once from its new place and sbx recognises it (see check_origin)."""
    made = installed_launcher(name)
    if made: return [sbx_cmd(), f"--name={name}", made], None                                # from sbx install: its file has no execute bit, so PATH can't find it
    if in_path(name): return [sbx_cmd(), name], None
    rec = read_origin(name)
    if not rec: return None, f"{name} is not in your PATH, and sbx has not run it from a file yet. Open it once with Open With, Run in sbx."
    path = rec[0]
    if not os.path.isfile(path): return None, f"The file {tilde(path)} is gone. If you moved it, start it once from its new place (Open With, Run in sbx): sbx recognises a moved program."
    if program_name(os.path.basename(path)) == name: return [sbx_cmd(), "open", path], None
    return [sbx_cmd(), f"--name={name}", path], None


def preview_command(name):
    """(the sbx command that prints what start_command(name) would run, or None, and why not). `sbx preview NAME` alone only finds
    programs in your PATH, so a program started from a recorded file is previewed from that file, with what `sbx open` adds."""
    argv, problem = start_command(name)
    if problem: return None, problem
    if argv[1] != "open": return [argv[0], "preview"] + argv[1:], None                          # [sbx, NAME] or [sbx, --name=NAME, FILE]
    flags = [] if os.path.exists(f"{APPS}/{name}.conf") else ["--input"]                        # `sbx open` gives a program with no settings of its own game controllers
    return [argv[0], "preview", *flags, argv[2]], None


def start_variants(name):
    """[(kind, path, argv)]: every different program that starts under NAME. They all use the private home ~/.sbx-homes/NAME and the settings of NAME,
    so two or more means one program shares another's data. The one made by sbx install comes first (it is what start_command starts), then the
    one in your PATH (a system Firefox next to a Firefox you installed). The same file found twice counts once."""
    out, seen = [], set()
    def add(kind, path, argv):
        real = os.path.realpath(path)
        if real not in seen: seen.add(real); out.append((kind, path, argv))
    made = installed_launcher(name)
    if made: add("Installed", made, [sbx_cmd(), f"--name={name}", made])
    found = which_program(name) if NAME_RE.match(name) else None
    if found: add(source_kind(found), found, [sbx_cmd(), name])
    return out


def sbx_cmd():
    return shutil.which("sbx") or "/usr/local/bin/sbx"


def load_schema():
    """Ask sbx which switches and secret folders exist, so this window can't drift from the command line."""
    global GROUPS, SWITCHES, SENSITIVE, LIMIT_PATTERNS, WL_RESTRICTED
    try:
        r = subprocess.run([sbx_cmd(), "schema"], capture_output=True, text=True, timeout=10)
        sch = json.loads(r.stdout)
    except (OSError, subprocess.TimeoutExpired, ValueError):
        return
    known = set(sch.get("switches", {}))
    if not known: return
    SENSITIVE = list(sch.get("sensitive", SENSITIVE))
    WL_RESTRICTED = bool(sch.get("wayland_restricted"))
    LIMIT_PATTERNS = {k: sch.get("limits", {}).get(k, v) for k, v in LIMIT_PATTERNS.items()}      # what sbx accepts for a limit
    groups = [(t, [row for row in rows if row[0] in known]) for t, rows in GROUPS]
    missing = [k for k in sch["switches"] if k not in {row[0] for _, rows in groups for row in rows}]
    if missing: groups.append(("Other", [(k, k.replace("_", " ").capitalize(), "Setting from sbx", bool(sch["switches"][k])) for k in missing]))
    GROUPS = [(t, rows) for t, rows in groups if rows]
    SWITCHES = {k: (t, s, d) for _, rows in GROUPS for k, t, s, d in rows}
    if "wayland_strict" in SWITCHES: SWITCHES["wayland_strict"] = SWITCHES["wayland_strict"][:2] + (WL_RESTRICTED,)      # automatic default


def folder_problem(name):
    """Why the switch "Start in the program's own folder" shares nothing for this program (its file sits in your home, Downloads or
    another general folder, or in a hidden folder), or None. Same rule as own_folder() in sbx."""
    rec = read_origin(name)
    path = os.path.realpath(rec[0]) if rec and os.path.isfile(rec[0]) else (os.path.realpath(shutil.which(name)) if shutil.which(name) else None)
    if not path: return None
    d = os.path.dirname(path)
    generic = {HOME} | {f"{HOME}/{n}" for n in ("Downloads", "Desktop", "Documents", "Pictures", "Music", "Videos", "Public", "Templates")}
    try:
        with open(f"{os.environ.get('XDG_CONFIG_HOME') or HOME + '/.config'}/user-dirs.dirs") as f:
            for m in re.finditer(r'^XDG_\w+_DIR="(?:\$HOME|' + re.escape(HOME) + r')/?([^"]*)"', f.read(), re.M): generic.add(f"{HOME}/{m[1]}".rstrip("/"))
    except OSError:
        pass
    if d in generic: return f"{tilde(d)} holds all sorts of things, so it is not shared. Move the program into a folder of its own."
    if d.startswith(HOME + "/") and d[len(HOME) + 1:].split("/")[0].startswith("."): return f"{tilde(d)} is a hidden folder, so it is not shared."
    if not (d.startswith(HOME + "/") or d.startswith("/tmp/")): return f"{d} is not inside your home or /tmp, so it is not shared."
    return None


# ---- window ----
class Win(Adw.ApplicationWindow):
    def __init__(self, app):
        super().__init__(application=app, title="sbx", default_width=560, default_height=800)
        self.toasts = Adw.ToastOverlay()
        self.nav = Adw.NavigationView()
        self.toasts.set_child(self.nav)
        self.set_content(self.toasts)
        self.program_pages = {}                  # scope -> the program page last built for it (see refresh_program_page)
        self.badges = {}                         # name -> the green "Running" label of its row in the list (see tick)
        self.live = {}                           # scope -> what its open program page redraws when it starts or stops (see tick)
        self.main = self.main_page()
        self.nav.push(self.main)
        self.nav.connect("popped", lambda *_: self.fill_apps())
        self.connect("notify::is-active", lambda w, _p: w.is_active() and self.fill_apps())
        GLib.timeout_add_seconds(3, self.tick)

    def tick(self):
        """Every few seconds: show which programs run now, in the list (a green "Running") and on an open program page (its Stop button)."""
        for n, b in self.badges.items(): b.set_visible(program_running(n))
        stack = self.nav.get_navigation_stack()
        shown = [stack.get_item(i) for i in range(stack.get_n_items())]
        for scope, redraw in list(self.live.items()):
            if self.program_pages.get(scope) in shown: redraw()
            else: del self.live[scope]                                              # that page is gone
        return True

    def show_trouble(self, scope):
        """Called for a start from outside (a notification click): back to the main page first so Back never leads
        through a stale page, then the log. Works the same whether the window was just created or was already open."""
        self.nav.pop_to_page(self.main)
        self.open_trouble(scope)

    def show_program(self, scope):
        self.nav.pop_to_page(self.main)
        self.open(scope)

    def refresh_program_page(self, scope):
        """Build SCOPE's program page again if it is in the page stack. A page reads the settings file once, when it is built, so a
        setting changed from another page (a suggestion on the log page) would otherwise stay invisible there, with the old value
        shown under the switch. The pages above it stay as they are. Nothing happens when the page is not open (a notification
        click opens the log with no program page below it)."""
        mine = self.program_pages.get(scope)
        stack = self.nav.get_navigation_stack()
        pages = [stack.get_item(i) for i in range(stack.get_n_items())]
        if mine is None or mine not in pages: return
        keep = list(CURRENT)
        new = self.program_page(scope)                                            # registers itself in program_pages
        CURRENT[:] = keep
        self.nav.replace([new if p is mine else p for p in pages])

    def page(self, title, content, end=(), banner=None, start=()):
        view = Adw.ToolbarView()
        bar = Adw.HeaderBar()
        for b in start: bar.pack_start(b)
        for b in end: bar.pack_end(b)
        view.add_top_bar(bar)
        if banner: view.add_top_bar(banner)
        view.set_content(content)
        return Adw.NavigationPage(child=view, title=title)

    def alert(self, heading, body="", child=None):
        d = Adw.AlertDialog(heading=heading, body=body)
        if child: d.set_extra_child(child)
        d.add_response("ok", "OK")
        d.present(self)

    def copy_text(self, text, done="Copied"):
        try: self.get_clipboard().set_content(Gdk.ContentProvider.new_for_value(text))
        except (TypeError, GLib.Error):
            return self.toasts.add_toast(Adw.Toast(title="Couldn't copy"))
        self.toasts.add_toast(Adw.Toast(title=done))

    def ask(self, heading, body, label, then):
        d = Adw.AlertDialog(heading=heading, body=body)
        d.add_response("cancel", "Cancel"); d.add_response("go", label)
        d.set_response_appearance("go", Adw.ResponseAppearance.DESTRUCTIVE)
        d.set_close_response("cancel")
        d.choose(self, None, lambda dlg, res: dlg.choose_finish(res) == "go" and then())

    # -- main page --
    def main_page(self):
        page = Adw.PreferencesPage()
        mg = Adw.PreferencesGroup()
        menu = Adw.SwitchRow(title="Show sbx in the app menu", subtitle="Adds a launcher for this window to your application menu.")
        menu.set_active(menu_entry_exists())

        def on_menu(r, _p):
            try:
                set_menu_entry(r.get_active())
                self.toasts.add_toast(Adw.Toast(title="Added to the app menu" if r.get_active() else "Removed from the app menu"))
            except (OSError, subprocess.SubprocessError) as e:
                self.toasts.add_toast(Adw.Toast(title=f"Could not change it: {getattr(e, 'strerror', None) or e}"))
                menu.handler_block_by_func(on_menu); menu.set_active(menu_entry_exists()); menu.handler_unblock_by_func(on_menu)
        menu.connect("notify::active", on_menu)
        mg.add(menu)
        page.add(mg)
        self.pending_banner = Adw.Banner(title="", button_label="Review", revealed=False)       # filled in by fill_apps
        self.pending_banner.connect("button-clicked", lambda *_: self.review_pending())
        self.apps_group = Adw.PreferencesGroup(title="Programs")
        self.app_rows = []
        self.others_open = False                 # is the terminal-only group open?
        page.add(self.apps_group)
        bg = Adw.PreferencesGroup(title="Backup", description="Saves the default settings and every program's own settings in one text file, and loads such a file back. "
                                                              "Private homes are not included.")
        exp_row = Adw.ActionRow(title="Export settings…", activatable=True)
        exp_row.add_suffix(Gtk.Image.new_from_icon_name("document-save-symbolic"))
        exp_row.connect("activated", lambda *_: self.export_settings("--all", "sbx-settings.txt"))
        imp_row = Adw.ActionRow(title="Import settings…", activatable=True)
        imp_row.add_suffix(Gtk.Image.new_from_icon_name("document-open-symbolic"))
        imp_row.connect("activated", lambda *_: self.import_settings())
        bg.add(exp_row); bg.add(imp_row)
        page.add(bg)
        rg = Adw.PreferencesGroup()
        rbtn = Gtk.Button(label="Reset all settings…", halign=Gtk.Align.CENTER, css_classes=["destructive-action"])
        rbtn.connect("clicked", lambda *_: self.reset_all())
        rg.add(rbtn)
        page.add(rg)
        self.fill_apps()
        add = Gtk.Button(icon_name="list-add-symbolic", tooltip_text="Add a program")
        add.connect("clicked", lambda *_: self.add_program())
        ts = Gtk.Button(icon_name="utilities-terminal-symbolic", tooltip_text="Troubleshooting: the health checks and what happened when programs started or stopped")
        ts.connect("clicked", lambda *_: self.open_trouble(None))
        return self.page("sbx", page, [ts], banner=self.pending_banner, start=[add])

    def open_trouble(self, scope):
        """Health checks (sbx doctor) and the recent log, for one program or all."""
        page = Adw.PreferencesPage()
        hl = Gtk.Label(xalign=0, wrap=True, selectable=True, focusable=False, margin_top=6, margin_bottom=6, css_classes=["monospace"])      # still selectable with the mouse; it just doesn't take the focus (and select all of itself) when the page opens
        sg = Adw.PreferencesGroup(title="Suggestions", description="Based on this program's last run, which ended with an error. "
                                  "Nothing changes until you press a button; it applies the next time the program starts.")
        sg.set_visible(False)
        sug_rows = []

        def show_hints():
            for r in sug_rows: sg.remove(r)
            sug_rows.clear()
            hints = log_hints(log_lines(scope), effective_switches(scope), effective_lists(scope)) if scope else []
            for key, want, title, why in hints:
                row = Adw.ActionRow(title=title, subtitle=why, use_markup=False)
                if key is not None:                                   # advice with no setting behind it has no button
                    btn = Gtk.Button(label="Add" if key in HINT_LISTS else "Turn on" if want else "Turn off", valign=Gtk.Align.CENTER)

                    def apply(_b, key=key, want=want):
                        try:
                            if key in HINT_LISTS: add_item(scope, key, want)
                            else: set_key(scope, key, want)
                            self.refresh_program_page(scope)                  # the page below shows the new value when you go back
                            self.toasts.add_toast(Adw.Toast(title="Saved. It applies the next time the program starts."))
                        except OSError as e:
                            self.toasts.add_toast(Adw.Toast(title=f"Could not save: {e.strerror or e}"))
                        show_hints()
                    btn.connect("clicked", apply)
                    row.add_suffix(btn)
                sg.add(row); sug_rows.append(row)
            sg.set_visible(bool(hints))
        lg = Adw.PreferencesGroup(title="Recent activity" + (f" · {scope}" if scope else ""),
                                  description="Starts, exits, warnings, and what programs print when they have no terminal. Paste this when asking for help.")
        everything = [False]                                  # the latest run only, until "Show all"
        more = Gtk.Button(valign=Gtk.Align.CENTER)
        lg.set_header_suffix(more)
        tv = Gtk.TextView(editable=False, cursor_visible=False, monospace=True, wrap_mode=Gtk.WrapMode.WORD_CHAR,
                          left_margin=8, right_margin=8, top_margin=8, bottom_margin=8)
        sw = Gtk.ScrolledWindow(min_content_height=320, child=tv, css_classes=["card"])
        lg.add(sw)
        hg = Adw.PreferencesGroup(title="Health", description="The checks of sbx doctor.")
        hg.add(hl)
        page.add(hg)                                      # the checks, then what to change, then the log it is based on
        page.add(sg)
        page.add(lg)
        buf = tv.get_buffer()
        tags = {k: buf.create_tag(k) for k in LOG_COLORS}
        for k in ("info", "exit_ok", "exit_err"): tags[k].set_property("weight", 700)

        def paint(*_):
            dark = 1 if Adw.StyleManager.get_default().get_dark() else 0
            for k, t in tags.items():
                rgba = Gdk.RGBA()
                rgba.parse(LOG_COLORS[k][dark])
                t.set_property("foreground-rgba", rgba)
        paint()
        Adw.StyleManager.get_default().connect("notify::dark", paint)

        def show_log():
            lines = log_lines(scope)
            more.set_label("Latest run only" if everything[0] else "Show all")
            more.set_visible(len(lines) > len(latest_run_lines(lines)))      # nothing more to show when the latest run is everything
            buf.set_text("")
            if not lines:
                buf.set_text("Nothing logged yet." if os.path.exists(LOG) else "No launches logged yet.")
                return
            rows = log_rows((lines if everything[0] else latest_run_lines(lines))[-200:])
            for i, row in enumerate(rows):
                for chunk, tag in row + ([("\n", "")] if i < len(rows) - 1 else []):
                    if tag: buf.insert_with_tags(buf.get_end_iter(), chunk, tags[tag])
                    else: buf.insert(buf.get_end_iter(), chunk)
            GLib.idle_add(lambda: sw.get_vadjustment().set_value(sw.get_vadjustment().get_upper()) and False)     # newest line in view

        latest = [0]

        def refresh(*_):
            latest[0] += 1
            mine = latest[0]
            hl.set_text("Running the checks…")

            def work():
                text = doctor_text()
                def show():
                    if mine == latest[0]: hl.set_text(text)                       # a newer refresh has its own answer coming
                    return False
                GLib.idle_add(show)
            threading.Thread(target=work, daemon=True).start()                    # sbx doctor can take seconds: the window never waits for it
            show_log()
            show_hints()
        def toggle(*_):
            everything[0] = not everything[0]
            show_log()
        more.connect("clicked", toggle)
        rb = Gtk.Button(icon_name="view-refresh-symbolic", tooltip_text="Refresh")
        rb.connect("clicked", refresh)
        cb = Gtk.Button(icon_name="edit-copy-symbolic", tooltip_text="Copy the health checks and the log, to paste when asking for help")
        cb.connect("clicked", lambda *_: self.copy_text(hl.get_text() + "\n\n" + buf.get_text(buf.get_start_iter(), buf.get_end_iter(), False),
                                                       "Copied the checks and the log"))
        refresh()
        pg = self.page("Troubleshooting", page, [rb, cb])
        pg.connect("shown", lambda *_: self.set_focus(None))                      # the health text is the first thing here: don't open with all of it selected
        self.nav.push(pg)

    def app_row(self, n, waiting=False, linked=None, menu=None, plain=False):
        """A program in the list, with a green "Running" while it runs and the arrow to its page. PLAIN (a program that is set up): what it may use,
        as in ajail. Not plain (only run from the terminal, so nothing to show yet): where it comes from and what is set."""
        sub = (("Waiting for your decision · " if waiting else "") + default_summary(n)) if plain else row_subtitle(n, waiting, linked, menu, show_running=False)
        r = Adw.ActionRow(title=n, subtitle=sub, activatable=True, use_markup=False)
        badge = Gtk.Label(label="Running", valign=Gtk.Align.CENTER, visible=program_running(n), css_classes=["success", "caption"])
        r.add_suffix(badge)
        self.badges[n] = badge                                                    # tick keeps it up to date
        r.add_suffix(Gtk.Image.new_from_icon_name("go-next-symbolic"))
        r.connect("activated", lambda _r, n=n: self.open(n))
        return r

    def stop_running(self, name):
        """sbx stop NAME. True if it was asked to stop (it takes a moment to end); otherwise says why not."""
        try: r = subprocess.run([sbx_cmd(), "stop", name], capture_output=True, text=True, timeout=10)
        except (OSError, subprocess.SubprocessError) as e:
            self.alert("Couldn't run sbx", str(e)); return False
        if r.returncode != 0:
            self.alert(f"Couldn't stop {name}", (r.stderr or r.stdout).strip()[-700:] or f"Exit code {r.returncode}"); return False
        self.toasts.add_toast(Adw.Toast(title=f"Stopping {name}…"))
        return True

    def review_pending(self):
        """The banner's button: open the first program that waits for a decision (the decision itself is on its page)."""
        names = sorted(pending_decisions())
        if names: self.open(names[0])

    def fill_apps(self):
        for r in self.app_rows: self.apps_group.remove(r)
        self.app_rows.clear()
        self.badges.clear()
        waiting = pending_decisions()
        count = len(waiting)
        self.pending_banner.set_title(f"{count} program{' is' if count == 1 else 's are'} waiting for your decision")
        self.pending_banner.set_revealed(count > 0)
        linked, menu = linked_programs(), launcher_programs()
        setup, others = program_groups()
        self.apps_group.set_description("Select a program to change what it can access. Changes apply the next time it starts." if setup or others else
                                        "No programs yet. Press + to add one, or just start one with sbx.")
        dr = Adw.ActionRow(title=DEFAULTS_TITLE, subtitle=default_summary(), activatable=True, use_markup=False)      # first, like ajail's "All apps (default)"
        dr.add_suffix(Gtk.Image.new_from_icon_name("go-next-symbolic"))
        dr.connect("activated", lambda *_: self.open(None))
        self.apps_group.add(dr); self.app_rows.append(dr)
        for n in setup:
            r = self.app_row(n, n in waiting, linked, menu, True)
            self.apps_group.add(r); self.app_rows.append(r)
        if others:
            ex = Adw.ExpanderRow(title=f"Only run from the terminal ({len(others)})", subtitle="No settings, link or app menu launcher yet", use_markup=False)
            ex.set_expanded(self.others_open or not setup)
            ex.connect("notify::expanded", lambda e, _p: setattr(self, "others_open", e.get_expanded()))     # the list is rebuilt often; keep it as the person left it
            unused = unused_programs(others)
            if unused:
                cl = Adw.ActionRow(title=f"Remove the {len(unused)} unused", subtitle="Almost no data. Their private homes are moved to the Trash", activatable=True, use_markup=False)
                cl.connect("activated", lambda *_: self.ask_remove_unused())
                ex.add_row(cl)
            for n in others: ex.add_row(self.app_row(n, n in waiting, linked, menu))
            self.apps_group.add(ex); self.app_rows.append(ex)

    def ask_remove_unused(self):
        names = unused_programs(program_groups()[1])
        if not names: return self.toasts.add_toast(Adw.Toast(title="Nothing unused"))
        shown = ", ".join(names[:10]) + (f" and {len(names) - 10} more" if len(names) > 10 else "")
        self.ask(f"Remove {len(names)} unused program{'s' if len(names) != 1 else ''}?",
                 f"{shown}. None has settings, a link or an app menu launcher, and each holds under {UNUSED_BYTES // 1024} KiB. Their private homes are moved to the Trash.",
                 "Remove", lambda: self.remove_unused(names))

    def remove_unused(self, names):
        done = 0
        for n in names:
            if program_running(n): continue
            try: forget_program(n)
            except GLib.Error as e:
                self.fill_apps()
                return self.alert("Couldn't move a private home to the Trash", f"{n}: {e.message}")
            done += 1
        self.fill_apps()
        self.toasts.add_toast(Adw.Toast(title=f"Removed {done} unused program{'s' if done != 1 else ''}"))

    def add_program(self):
        entry = Gtk.Entry(placeholder_text="firefox", activates_default=True)
        d = Adw.AlertDialog(heading="Add a program", body="The name you type to start it, for example firefox.")
        d.set_extra_child(entry)
        d.add_response("cancel", "Cancel"); d.add_response("add", "Add")
        d.set_response_appearance("add", Adw.ResponseAppearance.SUGGESTED)
        d.set_default_response("add"); d.set_close_response("cancel")
        d.set_response_enabled("add", False)
        body = d.get_body()

        def typing(*_):
            name = program_name(entry.get_text())
            d.set_response_enabled("add", bool(name))
            d.set_body(body if name == entry.get_text().strip() or not name else f"It will be called “{name}”: only letters, digits, . _ and - are kept.")
        entry.connect("changed", typing)

        def done(dlg, res):
            if dlg.choose_finish(res) != "add": return
            name = program_name(entry.get_text())
