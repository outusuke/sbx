#compdef sbx
# zsh completion for sbx. SPDX-License-Identifier: GPL-3.0-or-later
# Install: put this file as _sbx in a folder on your $fpath, for example ~/.zfunc, then run: compinit
_sbx_apps()  { local -a a; a=(${(f)"$(ls ~/.config/sbx/apps 2>/dev/null | sed 's/\.conf$//')"}); (( $#a )) && compadd -a a }
_sbx_pending() { local -a a; a=(${(f)"$(ls ~/.config/sbx/pending 2>/dev/null)"}); (( $#a )) && compadd -a a }
_sbx_homes() { local -a a; a=(${(f)"$(ls ~/.sbx-homes 2>/dev/null)"}); (( $#a )) && compadd -a a }

_sbx() {
    local -a cmds opts
    cmds=(preview show doctor clean reset link desktop open schema list stop rebind export import install uninstall)
    opts=(--net=none --net-private --private --here --no-wayland --wayland-strict --x11 --no-gpu --gpu-render-only --no-sound --portals --tray --a11y --gnome-shell --gnome-shell-manage --kde --hostname --privacy
          --no-userns --no-theme --camera --alsa --input --kvm --rocm --printing --ssh-agent --single-instance --allow-sensitive --compat
          --ignore-config --rebind --portal-screenshot --portal-screencast --portal-location --portal-shortcuts
          --portal-remote-desktop --portal-input-capture --portal-wallpaper --portal-launcher --portal-secret --portal-background --portal-usb --portal-clipboard --portal-file-transfer
          --no-portal-notification --no-portal-openuri --no-portal-print --no-portal-trash --no-portal-email --no-portal-inhibit --no-portal-network
          --no-portal-file-transfer --no-portal-screenshot --no-portal-screencast --no-portal-location --no-portal-shortcuts --no-portal-usb --no-portal-clipboard --no-portal-wallpaper
          --whitelist= --read-only= --env= --setenv= --allow-syscall= --talk= --memory= --tasks= --cpu= --gtk-portal= --name= --app-id= --loader=)
    local i word
    # the first word that isn't an option is the command or the program
    for (( i = 2; i < CURRENT; i++ )); do
        word=$words[i]
        case $word in
            --) _command_names -e; return ;;
            -*) ;;
            preview) ;;                                   # options and the program follow
            show) (( CURRENT == i + 1 )) && _sbx_apps; return ;;
            clean) compadd -- --yes --unused; _sbx_homes; return ;;
            reset) compadd -- --yes --default --all; _sbx_apps; return ;;
            link) compadd -- --remove --desktop; _command_names -e; return ;;
            install) compadd -- --launcher --link; _files; return ;;
            uninstall) compadd -- --yes --trash ${(f)"$(ls ~/.config/sbx/installed 2>/dev/null)"}; return ;;
            stop) (( CURRENT == i + 1 )) && _sbx_homes; return ;;
            list) compadd -- --all; return ;;
            rebind) compadd -- --dismiss; _sbx_pending; return ;;
            export) _arguments '--default[export the default settings only]' '--all[export every settings file]' '--force[replace an existing file]' \
                              '-o[write to a file instead of the terminal]:file:_files' '*:program:_sbx_apps'; return ;;
            import) _arguments '--force[replace settings that differ]' '*:file:_files'; return ;;
            doctor|schema) return ;;
            desktop) compadd -- --install-opener --remove-opener --install-installer --remove-installer --install-menu --remove-menu --remove; return ;;
            *) _files; return ;;                          # the program's own arguments
        esac
    done
    if compset -P '--allow-syscall='; then
        compadd io_uring userfaultfd process_vm_readv process_vm_writev kcmp pidfd_getfd
    elif compset -P '--whitelist=' || compset -P '--read-only='; then
        _files
    elif [[ $PREFIX == -* ]]; then
        compadd -S '' -a opts
    else
        _alternative 'commands:command:compadd -a cmds' 'programs:program:_command_names -e'
    fi
}
_sbx "$@"
